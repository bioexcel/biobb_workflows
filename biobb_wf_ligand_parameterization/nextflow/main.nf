/*
 * Generated by utils_biobb nextflow_wf_generator.py from the python workflow: do not edit by hand.
 * Automatic Ligand parameterization tutorial using BioExcel Building Blocks (biobb)
 * Nextflow version of biobb_wf_ligand_parameterization/python/workflow.py, with the BioBB Nextflow modules in modules/.
 * Usage: nextflow run main.nf -profile docker [--input samplesheet.csv]
 */

include { BIOBB_CHEMISTRY_BABEL_MINIMIZE as STEP2_BABEL_MINIMIZE } from './modules/bioexcel/biobb_chemistry/babel_minimize'
include { BIOBB_CHEMISTRY_ACPYPE_PARAMS_GMX as STEP3_ACPYPE_PARAMS_GMX } from './modules/bioexcel/biobb_chemistry/acpype_params_gmx'

params {
    // CSV with an id column and one column per input file: one workflow run per row
    input: String = "${projectDir}/samplesheet.csv"
}

workflow {
    main:
    // One [meta, files] item per samplesheet row: the steps of every row run in parallel
    ch_samples = channel.fromPath(params.input)
        .splitCsv(header: true)
        .map { row -> [[id: row.id], [ligand: samplePath(row.ligand)]] }

    // step2_babel_minimize: Energetically minimize hydrogen atoms
    STEP2_BABEL_MINIMIZE(ch_samples.map { meta, files -> [meta, files.ligand] })
    // step3_acpype_params_gmx: Generating ligand parameters
    STEP3_ACPYPE_PARAMS_GMX(STEP2_BABEL_MINIMIZE.out.output_path)

    publish:
    results = channel.empty().mix(
        STEP2_BABEL_MINIMIZE.out.output_path.map { meta, result -> [meta, 'step2_babel_minimize', result] },
        STEP3_ACPYPE_PARAMS_GMX.out.output_path_gro.mix(STEP3_ACPYPE_PARAMS_GMX.out.output_path_itp, STEP3_ACPYPE_PARAMS_GMX.out.output_path_top).map { meta, result -> [meta, 'step3_acpype_params_gmx', result] }
    )
}

output {
    // results/<id>/<step>/<id>_<step>_<role>.<ext>
    results {
        path { meta, step, _result -> "${meta.id}/${step}" }
    }
}

// Path of a samplesheet column: absolute, or relative to the samplesheet folder
def samplePath(String value) {
    file(file(params.input).parent.resolve(value).toString(), checkIfExists: true)
}
