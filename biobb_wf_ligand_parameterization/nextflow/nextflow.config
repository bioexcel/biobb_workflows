/*
 * Generated by utils_biobb nextflow_wf_generator.py from the python workflow: do not edit by hand.
 * Configuration of biobb_wf_ligand_parameterization: biobb properties (ext.properties) and output extensions (ext.outputs) of every step,
 * from python/workflow.yml.
 */

manifest {
    name = 'biobb_wf_ligand_parameterization'
    description = 'Automatic Ligand parameterization tutorial using BioExcel Building Blocks (biobb)'
    homePage = 'https://github.com/bioexcel/biobb_workflows'
    mainScript = 'main.nf'
    nextflowVersion = '!>=25.10.0'
    license = 'Apache-2.0'
}

outputDir = 'results'
workflow.output.mode = 'copy'

process {
    // Output files named <id>_<step>_<role>.<ext>
    ext.prefix = { "${meta.id}_${task.process.tokenize(':')[-1].toLowerCase()}" }

    withName: 'STEP2_BABEL_MINIMIZE' {
        ext.properties = [criteria: '1e-10', method: 'sd', force_field: 'GAFF', hydrogens: false]
        ext.outputs = [output_path: 'mol2']
    }

    withName: 'STEP3_ACPYPE_PARAMS_GMX' {
        ext.properties = [basename: 'biobb_GMX_LP', charge: -1]
    }
}

profiles {
    docker {
        docker.enabled = true
        // Run as the host user, so the results are not owned by root
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    apptainer {
        apptainer.enabled = true
    }
    singularity {
        singularity.enabled = true
    }
    conda {
        conda.enabled = true
        conda.channels = ['conda-forge', 'bioconda']
    }
}
