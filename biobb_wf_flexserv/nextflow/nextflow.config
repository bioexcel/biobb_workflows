/*
 * Generated by utils_biobb nextflow_wf_generator.py from the python workflow: do not edit by hand.
 * Configuration of biobb_wf_flexserv: biobb properties (ext.properties) and output extensions (ext.outputs) of every step,
 * from python/workflow.yml.
 */

manifest {
    name = 'biobb_wf_flexserv'
    description = 'Macromolecular Flexibility (FlexServ) tutorial using BioExcel Building Blocks (biobb)'
    homePage = 'https://github.com/bioexcel/biobb_workflows'
    mainScript = 'main.nf'
    nextflowVersion = '!>=25.10.0'
    license = 'Apache-2.0'
}

outputDir = 'results'
workflow.output.mode = 'copy'

process {
    // Output files named <id>_<step>_<role>.<ext>
    ext.prefix = { "${meta.id}_${task.process.tokenize(':')[-1].toLowerCase()}" }

    withName: 'STEP0_EXTRACT_ATOMS' {
        ext.properties = [regular_expression_pattern: '^CA']
    }

    withName: 'STEP1_BD_RUN' {
        ext.properties = [binary_path: 'bd', time: 10000, wfreq: 100]
        ext.outputs = [output_crd_path: 'mdcrd']
    }

    withName: 'STEP2_CPPTRAJ_RMS' {
        ext.properties = [start: 1, end: -1, steps: 1, mask: 'c-alpha', reference: 'experimental']
        ext.outputs = [output_traj_path: 'dcd']
    }

    withName: 'STEP3_DMD_RUN' {
        ext.outputs = [output_crd_path: 'mdcrd']
    }

    withName: 'STEP4_CPPTRAJ_RMS' {
        ext.properties = [start: 1, end: -1, steps: 1, mask: 'c-alpha', reference: 'experimental']
        ext.outputs = [output_traj_path: 'dcd']
    }

    withName: 'STEP5_NMA_RUN' {
        ext.properties = [frames: 50]
        ext.outputs = [output_crd_path: 'mdcrd']
    }

    withName: 'STEP6_CPPTRAJ_RMS' {
        ext.properties = [start: 1, end: -1, steps: 1, mask: 'c-alpha', reference: 'experimental']
        ext.outputs = [output_traj_path: 'dcd']
    }

    withName: 'STEP7_PCZ_ZIP' {
        ext.properties = [variance: 90, neigenv: 10, gauss_rmsd: true]
    }

    withName: 'STEP8_PCZ_ZIP' {
        ext.properties = [variance: 90, neigenv: 10, gauss_rmsd: true]
    }

    withName: 'STEP9_PCZ_ZIP' {
        ext.properties = [variance: 90, neigenv: 10, gauss_rmsd: true]
    }

    withName: 'STEP13_CPPTRAJ_RMS' {
        ext.properties = [start: 1, end: -1, steps: 1, mask: 'c-alpha', reference: 'experimental']
        ext.outputs = [output_traj_path: 'dcd']
    }

    withName: 'STEP14_CPPTRAJ_RMS' {
        ext.properties = [start: 1, end: -1, steps: 1, mask: 'c-alpha', reference: 'experimental']
        ext.outputs = [output_traj_path: 'dcd']
    }

    withName: 'STEP15_CPPTRAJ_RMS' {
        ext.properties = [start: 1, end: -1, steps: 1, mask: 'c-alpha', reference: 'experimental']
        ext.outputs = [output_traj_path: 'dcd']
    }

    withName: 'STEP17_PCZ_EVECS' {
        ext.properties = [eigenvector: 1]
    }

    withName: 'STEP18_PCZ_ANIMATE' {
        ext.properties = [eigenvector: 1]
    }

    withName: 'STEP19_CPPTRAJ_CONVERT' {
        ext.properties = [start: 1, end: -1, steps: 1, mask: 'c-alpha', format: 'dcd']
        ext.outputs = [output_cpptraj_path: 'dcd']
    }

    withName: 'STEP20_PCZ_BFACTOR' {
        ext.properties = [eigenvector: 0, pdb: true]
        ext.outputs = [output_pdb_path: 'pdb']
    }

    withName: 'STEP21_PCZ_HINGES' {
        ext.properties = [eigenvector: 0, method: 'Bfactor_slope']
    }

    withName: 'STEP22_PCZ_HINGES' {
        ext.properties = [eigenvector: 0, method: 'Dynamic_domain']
    }

    withName: 'STEP23_PCZ_HINGES' {
        ext.properties = [eigenvector: 0, method: 'Force_constant']
    }

    withName: 'STEP24_PCZ_STIFFNESS' {
        ext.properties = [eigenvector: 0]
    }

    withName: 'STEP25_PCZ_COLLECTIVITY' {
        ext.properties = [eigenvector: 0]
    }
}

profiles {
    docker {
        docker.enabled = true
        // Run as the host user, so the results are not owned by root
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    apptainer {
        apptainer.enabled = true
    }
    singularity {
        singularity.enabled = true
    }
    conda {
        conda.enabled = true
        conda.channels = ['conda-forge', 'bioconda']
    }
}
