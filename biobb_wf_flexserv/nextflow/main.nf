 * Macromolecular Flexibility (FlexServ) tutorial using BioExcel Building Blocks (biobb)
 * Nextflow version of biobb_wf_flexserv/python/workflow.py, with the BioBB Nextflow modules in modules/.
 * Usage: nextflow run main.nf -profile docker [--input samplesheet.csv]
 */

include { BIOBB_STRUCTURE_UTILS_EXTRACT_ATOMS as STEP0_EXTRACT_ATOMS } from './modules/bioexcel/biobb_structure_utils/extract_atoms'
include { BIOBB_FLEXSERV_BD_RUN as STEP1_BD_RUN } from './modules/bioexcel/biobb_flexserv/bd_run'
include { BIOBB_ANALYSIS_CPPTRAJ_RMS as STEP2_CPPTRAJ_RMS } from './modules/bioexcel/biobb_analysis/cpptraj_rms'
include { BIOBB_FLEXSERV_DMD_RUN as STEP3_DMD_RUN } from './modules/bioexcel/biobb_flexserv/dmd_run'
include { BIOBB_ANALYSIS_CPPTRAJ_RMS as STEP4_CPPTRAJ_RMS } from './modules/bioexcel/biobb_analysis/cpptraj_rms'
include { BIOBB_FLEXSERV_NMA_RUN as STEP5_NMA_RUN } from './modules/bioexcel/biobb_flexserv/nma_run'
include { BIOBB_ANALYSIS_CPPTRAJ_RMS as STEP6_CPPTRAJ_RMS } from './modules/bioexcel/biobb_analysis/cpptraj_rms'
include { BIOBB_FLEXSERV_PCZ_ZIP as STEP7_PCZ_ZIP } from './modules/bioexcel/biobb_flexserv/pcz_zip'
include { BIOBB_FLEXSERV_PCZ_ZIP as STEP8_PCZ_ZIP } from './modules/bioexcel/biobb_flexserv/pcz_zip'
include { BIOBB_FLEXSERV_PCZ_ZIP as STEP9_PCZ_ZIP } from './modules/bioexcel/biobb_flexserv/pcz_zip'
include { BIOBB_FLEXSERV_PCZ_UNZIP as STEP10_PCZ_UNZIP } from './modules/bioexcel/biobb_flexserv/pcz_unzip'
include { BIOBB_FLEXSERV_PCZ_UNZIP as STEP11_PCZ_UNZIP } from './modules/bioexcel/biobb_flexserv/pcz_unzip'
include { BIOBB_FLEXSERV_PCZ_UNZIP as STEP12_PCZ_UNZIP } from './modules/bioexcel/biobb_flexserv/pcz_unzip'
include { BIOBB_ANALYSIS_CPPTRAJ_RMS as STEP13_CPPTRAJ_RMS } from './modules/bioexcel/biobb_analysis/cpptraj_rms'
include { BIOBB_ANALYSIS_CPPTRAJ_RMS as STEP14_CPPTRAJ_RMS } from './modules/bioexcel/biobb_analysis/cpptraj_rms'
include { BIOBB_ANALYSIS_CPPTRAJ_RMS as STEP15_CPPTRAJ_RMS } from './modules/bioexcel/biobb_analysis/cpptraj_rms'
include { BIOBB_FLEXSERV_PCZ_INFO as STEP16_PCZ_INFO } from './modules/bioexcel/biobb_flexserv/pcz_info'
include { BIOBB_FLEXSERV_PCZ_EVECS as STEP17_PCZ_EVECS } from './modules/bioexcel/biobb_flexserv/pcz_evecs'
include { BIOBB_FLEXSERV_PCZ_ANIMATE as STEP18_PCZ_ANIMATE } from './modules/bioexcel/biobb_flexserv/pcz_animate'
include { BIOBB_ANALYSIS_CPPTRAJ_CONVERT as STEP19_CPPTRAJ_CONVERT } from './modules/bioexcel/biobb_analysis/cpptraj_convert'
include { BIOBB_FLEXSERV_PCZ_BFACTOR as STEP20_PCZ_BFACTOR } from './modules/bioexcel/biobb_flexserv/pcz_bfactor'
include { BIOBB_FLEXSERV_PCZ_HINGES as STEP21_PCZ_HINGES } from './modules/bioexcel/biobb_flexserv/pcz_hinges'
include { BIOBB_FLEXSERV_PCZ_HINGES as STEP22_PCZ_HINGES } from './modules/bioexcel/biobb_flexserv/pcz_hinges'
include { BIOBB_FLEXSERV_PCZ_HINGES as STEP23_PCZ_HINGES } from './modules/bioexcel/biobb_flexserv/pcz_hinges'
include { BIOBB_FLEXSERV_PCZ_STIFFNESS as STEP24_PCZ_STIFFNESS } from './modules/bioexcel/biobb_flexserv/pcz_stiffness'
include { BIOBB_FLEXSERV_PCZ_COLLECTIVITY as STEP25_PCZ_COLLECTIVITY } from './modules/bioexcel/biobb_flexserv/pcz_collectivity'
include { BIOBB_FLEXSERV_PCZ_SIMILARITY as STEP26_PCZ_SIMILARITY } from './modules/bioexcel/biobb_flexserv/pcz_similarity'
include { BIOBB_FLEXSERV_PCZ_SIMILARITY as STEP27_PCZ_SIMILARITY } from './modules/bioexcel/biobb_flexserv/pcz_similarity'
include { BIOBB_FLEXSERV_PCZ_SIMILARITY as STEP28_PCZ_SIMILARITY } from './modules/bioexcel/biobb_flexserv/pcz_similarity'

params {
    // CSV with an id column and one column per input file: one workflow run per row
    input: String = "${projectDir}/samplesheet.csv"
}

workflow {
    main:
    // One [meta, files] item per samplesheet row: the steps of every row run in parallel
    ch_samples = channel.fromPath(params.input)
        .splitCsv(header: true)
        .map { row -> [[id: row.id], [structure: samplePath(row.structure), file_1a32_model: samplePath(row.file_1a32_model)]] }

    // step0_extract_atoms: Generate Coarse Grain Structure
    STEP0_EXTRACT_ATOMS(ch_samples.map { meta, files -> [meta, files.structure] })
    // step1_bd_run: Brownian Dynamics
    STEP1_BD_RUN(STEP0_EXTRACT_ATOMS.out.output_structure_path)
    // step2_cpptraj_rms: Fitting and converting BD trajectory to DCD
    STEP2_CPPTRAJ_RMS(
        STEP0_EXTRACT_ATOMS.out.output_structure_path
            .join(STEP1_BD_RUN.out.output_crd_path)
            .join(STEP0_EXTRACT_ATOMS.out.output_structure_path)
    )
    // step3_dmd_run: Discrete Molecular Dynamics
    STEP3_DMD_RUN(STEP0_EXTRACT_ATOMS.out.output_structure_path)
    // step4_cpptraj_rms: Fitting and converting DMD trajectory to DCD
    STEP4_CPPTRAJ_RMS(
        STEP0_EXTRACT_ATOMS.out.output_structure_path
            .join(STEP3_DMD_RUN.out.output_crd_path)
            .join(STEP0_EXTRACT_ATOMS.out.output_structure_path)
    )
    // step5_nma_run: Normal Mode Analysis
    STEP5_NMA_RUN(STEP0_EXTRACT_ATOMS.out.output_structure_path)
    // step6_cpptraj_rms: Fitting and converting NMA trajectory to DCD (visualization)
    STEP6_CPPTRAJ_RMS(
        STEP0_EXTRACT_ATOMS.out.output_structure_path
            .join(STEP5_NMA_RUN.out.output_crd_path)
            .join(STEP0_EXTRACT_ATOMS.out.output_structure_path)
    )
    // step7_pcz_zip: PCAsuite, Compressing trajectory (BD)
    STEP7_PCZ_ZIP(
        STEP0_EXTRACT_ATOMS.out.output_structure_path
            .join(STEP1_BD_RUN.out.output_crd_path)
    )
    // step8_pcz_zip: PCAsuite, Compressing trajectory (DMD)
    STEP8_PCZ_ZIP(
        STEP0_EXTRACT_ATOMS.out.output_structure_path
            .join(STEP3_DMD_RUN.out.output_crd_path)
    )
    // step9_pcz_zip: PCAsuite, Compressing trajectory (NMA)
    STEP9_PCZ_ZIP(
        STEP0_EXTRACT_ATOMS.out.output_structure_path
            .join(STEP5_NMA_RUN.out.output_crd_path)
    )
    // step10_pcz_unzip: PCAsuite, Uncompressing trajectory (BD)
    STEP10_PCZ_UNZIP(STEP7_PCZ_ZIP.out.output_pcz_path)
    // step11_pcz_unzip: PCAsuite, Uncompressing trajectory (DMD)
    STEP11_PCZ_UNZIP(STEP8_PCZ_ZIP.out.output_pcz_path)
    // step12_pcz_unzip: PCAsuite, Uncompressing trajectory (NMA)
    STEP12_PCZ_UNZIP(STEP9_PCZ_ZIP.out.output_pcz_path)
    // step13_cpptraj_rms: Fitting and converting uncompressed BD trajectory to DCD (visualization)
    STEP13_CPPTRAJ_RMS(
        STEP0_EXTRACT_ATOMS.out.output_structure_path
            .join(STEP10_PCZ_UNZIP.out.output_crd_path)
            .join(STEP0_EXTRACT_ATOMS.out.output_structure_path)
    )
    // step14_cpptraj_rms: Fitting and converting uncompressed DMD trajectory to DCD (visualization)
    STEP14_CPPTRAJ_RMS(
        STEP0_EXTRACT_ATOMS.out.output_structure_path
            .join(STEP11_PCZ_UNZIP.out.output_crd_path)
            .join(STEP0_EXTRACT_ATOMS.out.output_structure_path)
    )
    // step15_cpptraj_rms: Fitting and converting uncompressed NMA trajectory to DCD (visualization)
    STEP15_CPPTRAJ_RMS(
        STEP0_EXTRACT_ATOMS.out.output_structure_path
            .join(STEP12_PCZ_UNZIP.out.output_crd_path)
            .join(STEP0_EXTRACT_ATOMS.out.output_structure_path)
    )
    // step16_pcz_info: PCAsuite, Principal Components Analysis Report
    STEP16_PCZ_INFO(STEP9_PCZ_ZIP.out.output_pcz_path)
    // step17_pcz_evecs: PCAsuite, Eigen Vectors
    STEP17_PCZ_EVECS(STEP9_PCZ_ZIP.out.output_pcz_path)
    // step18_pcz_animate: PCAsuite, Animate Principal Components
    STEP18_PCZ_ANIMATE(STEP9_PCZ_ZIP.out.output_pcz_path)
    // step19_cpptraj_convert: Fitting and converting animated PC NMA trajectory to DCD (visualization)
    STEP19_CPPTRAJ_CONVERT(
        STEP0_EXTRACT_ATOMS.out.output_structure_path
            .join(STEP18_PCZ_ANIMATE.out.output_crd_path)
    )
    // step20_pcz_bfactor: PCAsuite, Bfactor x Principal Components
    STEP20_PCZ_BFACTOR(STEP9_PCZ_ZIP.out.output_pcz_path)
    // step21_pcz_hinges: PCAsuite, Hinge points prediction (Bfactor slope)
    STEP21_PCZ_HINGES(STEP7_PCZ_ZIP.out.output_pcz_path)
    // step22_pcz_hinges: PCAsuite, Hinge points prediction (Dynamic domain)
    STEP22_PCZ_HINGES(STEP7_PCZ_ZIP.out.output_pcz_path)
    // step23_pcz_hinges: PCAsuite, Hinge points prediction (Force constant)
    STEP23_PCZ_HINGES(STEP7_PCZ_ZIP.out.output_pcz_path)
    // step24_pcz_stiffness: PCAsuite, Apparent Stiffness
    STEP24_PCZ_STIFFNESS(STEP9_PCZ_ZIP.out.output_pcz_path)
    // step25_pcz_collectivity: PCAsuite, Collectivity Index
    STEP25_PCZ_COLLECTIVITY(STEP9_PCZ_ZIP.out.output_pcz_path)
    // step26_pcz_similarity: PCAsuite, PCZ similarity (BD vs MD)
    STEP26_PCZ_SIMILARITY(
        STEP7_PCZ_ZIP.out.output_pcz_path
            .join(ch_samples.map { meta, files -> [meta, files.file_1a32_model] })
    )
    // step27_pcz_similarity: PCAsuite, PCZ similarity (DMD vs MD)
    STEP27_PCZ_SIMILARITY(
        STEP8_PCZ_ZIP.out.output_pcz_path
            .join(ch_samples.map { meta, files -> [meta, files.file_1a32_model] })
    )
    // step28_pcz_similarity: PCAsuite, PCZ similarity (NMA vs MD)
    STEP28_PCZ_SIMILARITY(
        STEP9_PCZ_ZIP.out.output_pcz_path
            .join(ch_samples.map { meta, files -> [meta, files.file_1a32_model] })
    )

    publish:
    results = channel.empty().mix(
        STEP0_EXTRACT_ATOMS.out.output_structure_path.map { meta, result -> [meta, 'step0_extract_atoms', result] },
        STEP1_BD_RUN.out.output_log_path.mix(STEP1_BD_RUN.out.output_crd_path).map { meta, result -> [meta, 'step1_bd_run', result] },
        STEP2_CPPTRAJ_RMS.out.output_cpptraj_path.mix(STEP2_CPPTRAJ_RMS.out.output_traj_path).map { meta, result -> [meta, 'step2_cpptraj_rms', result] },
        STEP3_DMD_RUN.out.output_log_path.mix(STEP3_DMD_RUN.out.output_crd_path).map { meta, result -> [meta, 'step3_dmd_run', result] },
        STEP4_CPPTRAJ_RMS.out.output_cpptraj_path.mix(STEP4_CPPTRAJ_RMS.out.output_traj_path).map { meta, result -> [meta, 'step4_cpptraj_rms', result] },
        STEP5_NMA_RUN.out.output_log_path.mix(STEP5_NMA_RUN.out.output_crd_path).map { meta, result -> [meta, 'step5_nma_run', result] },
        STEP6_CPPTRAJ_RMS.out.output_cpptraj_path.mix(STEP6_CPPTRAJ_RMS.out.output_traj_path).map { meta, result -> [meta, 'step6_cpptraj_rms', result] },
        STEP7_PCZ_ZIP.out.output_pcz_path.map { meta, result -> [meta, 'step7_pcz_zip', result] },
        STEP8_PCZ_ZIP.out.output_pcz_path.map { meta, result -> [meta, 'step8_pcz_zip', result] },
        STEP9_PCZ_ZIP.out.output_pcz_path.map { meta, result -> [meta, 'step9_pcz_zip', result] },
        STEP10_PCZ_UNZIP.out.output_crd_path.map { meta, result -> [meta, 'step10_pcz_unzip', result] },
        STEP11_PCZ_UNZIP.out.output_crd_path.map { meta, result -> [meta, 'step11_pcz_unzip', result] },
        STEP12_PCZ_UNZIP.out.output_crd_path.map { meta, result -> [meta, 'step12_pcz_unzip', result] },
        STEP13_CPPTRAJ_RMS.out.output_cpptraj_path.mix(STEP13_CPPTRAJ_RMS.out.output_traj_path).map { meta, result -> [meta, 'step13_cpptraj_rms', result] },
        STEP14_CPPTRAJ_RMS.out.output_cpptraj_path.mix(STEP14_CPPTRAJ_RMS.out.output_traj_path).map { meta, result -> [meta, 'step14_cpptraj_rms', result] },
        STEP15_CPPTRAJ_RMS.out.output_cpptraj_path.mix(STEP15_CPPTRAJ_RMS.out.output_traj_path).map { meta, result -> [meta, 'step15_cpptraj_rms', result] },
        STEP16_PCZ_INFO.out.output_json_path.map { meta, result -> [meta, 'step16_pcz_info', result] },
        STEP17_PCZ_EVECS.out.output_json_path.map { meta, result -> [meta, 'step17_pcz_evecs', result] },
        STEP18_PCZ_ANIMATE.out.output_crd_path.map { meta, result -> [meta, 'step18_pcz_animate', result] },
        STEP19_CPPTRAJ_CONVERT.out.output_cpptraj_path.map { meta, result -> [meta, 'step19_cpptraj_convert', result] },
        STEP20_PCZ_BFACTOR.out.output_dat_path.mix(STEP20_PCZ_BFACTOR.out.output_pdb_path).map { meta, result -> [meta, 'step20_pcz_bfactor', result] },
        STEP21_PCZ_HINGES.out.output_json_path.map { meta, result -> [meta, 'step21_pcz_hinges', result] },
        STEP22_PCZ_HINGES.out.output_json_path.map { meta, result -> [meta, 'step22_pcz_hinges', result] },
        STEP23_PCZ_HINGES.out.output_json_path.map { meta, result -> [meta, 'step23_pcz_hinges', result] },
        STEP24_PCZ_STIFFNESS.out.output_json_path.map { meta, result -> [meta, 'step24_pcz_stiffness', result] },
        STEP25_PCZ_COLLECTIVITY.out.output_json_path.map { meta, result -> [meta, 'step25_pcz_collectivity', result] },
        STEP26_PCZ_SIMILARITY.out.output_json_path.map { meta, result -> [meta, 'step26_pcz_similarity', result] },
        STEP27_PCZ_SIMILARITY.out.output_json_path.map { meta, result -> [meta, 'step27_pcz_similarity', result] },
        STEP28_PCZ_SIMILARITY.out.output_json_path.map { meta, result -> [meta, 'step28_pcz_similarity', result] }
    )
}

output {
    // results/<id>/<step>/<id>_<step>_<role>.<ext>
    results {
        path { meta, step, _result -> "${meta.id}/${step}" }
    }
}

// Path of a samplesheet column: absolute, or relative to the samplesheet folder
def samplePath(String value) {
    file(file(params.input).parent.resolve(value).toString(), checkIfExists: true)
}
