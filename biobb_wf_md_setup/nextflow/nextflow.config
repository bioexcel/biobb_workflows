/*
 * Generated by utils_biobb nextflow_wf_generator.py from the python workflow: do not edit by hand.
 * Configuration of biobb_wf_md_setup: biobb properties (ext.properties) and output extensions (ext.outputs) of every step,
 * from python/workflow.yml.
 */

manifest {
    name = 'biobb_wf_md_setup'
    description = 'Protein MD Setup tutorial using BioExcel Building Blocks (biobb)'
    homePage = 'https://github.com/bioexcel/biobb_workflows'
    mainScript = 'main.nf'
    nextflowVersion = '!>=25.10.0'
    license = 'Apache-2.0'
}

outputDir = 'results'
workflow.output.mode = 'copy'

process {
    // Output files named <id>_<step>_<role>.<ext>
    ext.prefix = { "${meta.id}_${task.process.tokenize(':')[-1].toLowerCase()}" }

    // Multithreaded blocks (num_threads = cpus): set cpus to the cores of your machine or node
    withLabel: 'process_medium' {
        cpus = 4
    }

    withName: 'STEP4_PDB2GMX' {
        ext.properties = [force_field: 'amber99sb', water_type: 'tip3p']
    }

    withName: 'STEP5_EDITCONF' {
        ext.properties = [distance_to_molecule: 0.8, box_type: 'octahedron']
    }

    withName: 'STEP7_GROMPP_GENION' {
        ext.properties = [simulation_type: 'minimization', maxwarn: 1, mdp: [nsteps: 5000]]
    }

    withName: 'STEP8_GENION' {
        ext.properties = [neutral: true, concentration: 0.05]
    }

    withName: 'STEP9_GROMPP_MIN' {
        ext.properties = [mdp: [nsteps: 5000, emtol: 500], simulation_type: 'minimization']
    }

    withName: 'STEP10_MDRUN_MIN' {
        ext.outputs = [output_trr_path: 'trr']
    }

    withName: 'STEP100_MAKE_NDX' {
        ext.properties = [selection: 'System']
    }

    withName: 'STEP11_GROMPP_NVT' {
        ext.properties = [mdp: [nsteps: 50000, dt: 0.002, Define: '-DPOSRES', 'tc-grps': 'Protein Water_and_ions'], simulation_type: 'nvt']
    }

    withName: 'STEP12_MDRUN_NVT' {
        ext.outputs = [output_trr_path: 'trr', output_cpt_path: 'cpt']
    }

    withName: 'STEP13_GROMPP_NPT' {
        ext.properties = [mdp: [nsteps: 50000, 'tc-grps': 'Protein Water_and_ions'], simulation_type: 'npt']
    }

    withName: 'STEP14_MDRUN_NPT' {
        ext.outputs = [output_trr_path: 'trr', output_cpt_path: 'cpt']
    }

    withName: 'STEP15_GROMPP_MD' {
        ext.properties = [mdp: [nsteps: 250000, 'tc-grps': 'Protein Water_and_ions'], simulation_type: 'free']
    }

    withName: 'STEP16_MDRUN_MD' {
        ext.outputs = [output_trr_path: 'trr', output_cpt_path: 'cpt']
    }

    withName: 'STEP17_GMX_IMAGE1' {
        ext.properties = [center_selection: 'Protein', output_selection: 'System', pbc: 'mol', center: true, ur: 'compact']
        ext.outputs = [output_traj_path: 'trr']
    }

    withName: 'STEP18_GMX_IMAGE2' {
        ext.properties = [fit_selection: 'Protein', output_selection: 'System', fit: 'rot+trans']
    }

    withName: 'STEP19_GMX_TRJCONV_STR' {
        ext.properties = [pbc: 'mol', selection: 'System']
    }

    withName: 'STEP20_GMX_ENERGY' {
        ext.properties = [xvg: 'xmgr', terms: ['Potential', 'Total-Energy']]
    }

    withName: 'STEP21_GMX_RGYR' {
        ext.properties = [xvg: 'xmgr', selection: 'Backbone']
    }

    withName: 'STEP22_RMSD_FIRST' {
        ext.properties = [selection: 'Protein-H']
    }

    withName: 'STEP23_RMSD_EXP' {
        ext.properties = [selection: 'Protein-H']
    }

    withName: 'STEP24_GROMPP_MD' {
        ext.properties = [mdp: [nsteps: 5000000, dt: 0.002, 'ref-t': '300 300', nstxout: 100000, 'nstxout-compressed': 500], simulation_type: 'free']
    }
}

profiles {
    docker {
        docker.enabled = true
        // Run as the host user, so the results are not owned by root
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    apptainer {
        apptainer.enabled = true
    }
    singularity {
        singularity.enabled = true
    }
    conda {
        conda.enabled = true
        conda.channels = ['conda-forge', 'bioconda']
    }
}
