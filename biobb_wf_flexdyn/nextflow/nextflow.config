/*
 * Configuration of biobb_wf_flexdyn: biobb properties (ext.properties) and output extensions (ext.outputs) of every step,
 * from python/workflow.yml.
 */

manifest {
    name = 'biobb_wf_flexdyn'
    description = 'Conformational ensembles generation, data representation and visualization of predicted flexibility properties using BioExcel Building Blocks (biobb) and FlexDyn tools'
    homePage = 'https://github.com/bioexcel/biobb_workflows'
    mainScript = 'main.nf'
    nextflowVersion = '!>=25.10.0'
    license = 'Apache-2.0'
}

outputDir = 'results'
workflow.output.mode = 'copy'

process {
    // Output files named <id>_<step>_<role>.<ext>
    ext.prefix = { "${meta.id}_${task.process.tokenize(':')[-1].toLowerCase()}" }

    withName: 'STEP0_EXTRACT_MODEL' {
        ext.properties = [models: [1]]
    }

    withName: 'STEP1_EXTRACT_CHAIN' {
        ext.properties = [chains: ['A']]
    }

    withName: 'STEP2_CPPTRAJ_MASK' {
        ext.properties = [mask: 'backbone', format: 'pdb']
        ext.outputs = [output_cpptraj_path: 'pdb']
    }

    withName: 'STEP3_CPPTRAJ_MASK' {
        ext.properties = [mask: 'c-alpha', format: 'pdb']
        ext.outputs = [output_cpptraj_path: 'pdb']
    }

    // CONCOORDLIB: set by the biobb_flexdyn container and conda env (the python workflow sets it to $CONDA_PREFIX/share/concoord/lib)
    withName: 'STEP4_CONCOORD_DIST' {
        ext.properties = [retain_hydrogens: false, cutoff: 4.0, env_vars_dict: [CONCOORD_OVERWRITE: '1']]
    }

    withName: 'STEP5_CONCOORD_DISCO' {
        ext.properties = [vdw: 4, num_structs: 300, env_vars_dict: [CONCOORD_OVERWRITE: '1']]
    }

    withName: 'STEP6_CPPTRAJ_RMS' {
        ext.properties = [start: 1, end: -1, steps: 1, mask: 'c-alpha', reference: 'experimental']
    }

    withName: 'STEP7_CPPTRAJ_CONVERT' {
        ext.properties = [mask: 'c-alpha', format: 'trr']
        ext.outputs = [output_cpptraj_path: 'trr']
    }

    withName: 'STEP8_PRODY_ANM' {
        ext.properties = [selection: 'backbone', num_structs: 300, rmsd: 2.0]
    }

    withName: 'STEP9_CPPTRAJ_RMS' {
        ext.properties = [start: 1, end: -1, steps: 1, mask: 'c-alpha', reference: 'experimental']
    }

    withName: 'STEP10_CPPTRAJ_CONVERT' {
        ext.properties = [mask: 'c-alpha', format: 'trr']
        ext.outputs = [output_cpptraj_path: 'trr']
    }

    withName: 'STEP11_BD_RUN' {
        ext.properties = [time: 30000, wfreq: 100]
        ext.outputs = [output_crd_path: 'mdcrd']
    }

    withName: 'STEP12_CPPTRAJ_RMS' {
        ext.properties = [start: 1, end: -1, steps: 1, mask: 'c-alpha', reference: 'experimental']
        ext.outputs = [output_traj_path: 'trr']
    }

    withName: 'STEP13_DMD_RUN' {
        ext.properties = [frames: 300]
        ext.outputs = [output_crd_path: 'mdcrd']
    }

    withName: 'STEP14_CPPTRAJ_RMS' {
        ext.properties = [start: 1, end: -1, steps: 1, mask: 'c-alpha', reference: 'experimental']
        ext.outputs = [output_traj_path: 'trr']
    }

    withName: 'STEP15_NMA_RUN' {
        ext.properties = [frames: 300]
        ext.outputs = [output_crd_path: 'mdcrd']
    }

    withName: 'STEP16_CPPTRAJ_RMS' {
        ext.properties = [start: 1, end: -1, steps: 1, mask: 'c-alpha', reference: 'experimental']
    }

    withName: 'STEP17_CPPTRAJ_CONVERT' {
        ext.properties = [mask: 'c-alpha', format: 'trr']
        ext.outputs = [output_cpptraj_path: 'trr']
    }

    withName: 'STEP18_NOLB_NMA' {
        ext.properties = [num_structs: 300, rmsd: 4]
    }

    withName: 'STEP19_CPPTRAJ_RMS' {
        ext.properties = [start: 1, end: -1, steps: 1, mask: 'c-alpha', reference: 'experimental']
    }

    withName: 'STEP20_CPPTRAJ_CONVERT' {
        ext.properties = [mask: 'c-alpha', format: 'trr']
        ext.outputs = [output_cpptraj_path: 'trr']
    }

    withName: 'STEP21_IMOD_IMODE' {
        ext.properties = [cg: 2]
    }

    withName: 'STEP22_IMOD_IMC' {
        ext.properties = [num_structs: 300, num_modes: 10, amplitude: 6.0]
    }

    withName: 'STEP23_CPPTRAJ_RMS' {
        ext.properties = [start: 1, end: -1, steps: 1, mask: 'c-alpha', reference: 'experimental']
    }

    withName: 'STEP24_CPPTRAJ_CONVERT' {
        ext.properties = [mask: 'c-alpha', format: 'trr']
        ext.outputs = [output_cpptraj_path: 'trr']
    }

    // Python logic of workflow.py: the zip is written in the folder of its step
    withName: 'ZIP_TRAJECTORIES' {
        ext.prefix = { "${meta.id}_step25_trjcat_trj_zip" }
    }

    withName: 'STEP25_TRJCAT' {
        ext.outputs = [output_trj_path: 'trr']
    }

    withName: 'STEP26_MAKE_NDX' {
        ext.properties = [selection: '3']
    }

    withName: 'STEP27_GMX_CLUSTER' {
        ext.properties = [fit_selection: 'System', output_selection: 'System', method: 'linkage', cutoff: 0.12]
        ext.outputs = [output_pdb_path: 'pdb']
    }

    withName: 'STEP28_CPPTRAJ_RMS' {
        ext.properties = [start: 1, end: -1, steps: 1, mask: 'c-alpha', reference: 'experimental']
        ext.outputs = [output_traj_path: 'crd']
    }

    withName: 'STEP29_PCZ_ZIP' {
        ext.properties = [variance: 90, neigenv: 10]
    }

    withName: 'STEP30_PCZ_ZIP' {
        ext.properties = [variance: 90, neigenv: 10, gauss_rmsd: true]
    }

    withName: 'STEP32_PCZ_EVECS' {
        ext.properties = [eigenvector: 1]
    }

    withName: 'STEP33_PCZ_ANIMATE' {
        ext.properties = [eigenvector: 1]
    }

    withName: 'STEP34_CPPTRAJ_CONVERT' {
        ext.properties = [format: 'dcd']
        ext.outputs = [output_cpptraj_path: 'dcd']
    }

    withName: 'STEP35_PCZ_BFACTOR' {
        ext.properties = [eigenvector: 0, pdb: true]
        ext.outputs = [output_pdb_path: 'pdb']
    }

    withName: 'STEP36_PCZ_HINGES' {
        ext.properties = [eigenvector: 0, method: 'Bfactor_slope']
    }

    withName: 'STEP37_PCZ_HINGES' {
        ext.properties = [eigenvector: 0, method: 'Dynamic_domain']
    }

    withName: 'STEP38_PCZ_HINGES' {
        ext.properties = [eigenvector: 0, method: 'Force_constant']
    }

    withName: 'STEP39_PCZ_STIFFNESS' {
        ext.properties = [eigenvector: 0]
    }

    withName: 'STEP40_PCZ_COLLECTIVITY' {
        ext.properties = [eigenvector: 0]
    }
}

profiles {
    docker {
        docker.enabled = true
        // Run as the host user, so the results are not owned by root
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    apptainer {
        apptainer.enabled = true
    }
    singularity {
        singularity.enabled = true
    }
    conda {
        conda.enabled = true
        conda.channels = ['conda-forge', 'bioconda']
    }
}
