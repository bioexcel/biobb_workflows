include { BIOBB_AMBER_SANDER_MDRUN as STEP18_SANDER_MDRUN_EQ7 } from './modules/bioexcel/biobb_amber/sander_mdrun'
include { BIOBB_AMBER_PROCESS_MDOUT as STEP19_PROCESS_MDOUT_EQ7 } from './modules/bioexcel/biobb_amber/process_mdout'
include { BIOBB_AMBER_SANDER_MDRUN as STEP20_SANDER_MDRUN_EQ8 } from './modules/bioexcel/biobb_amber/sander_mdrun'
include { BIOBB_AMBER_PROCESS_MDOUT as STEP21_PROCESS_MDOUT_EQ8 } from './modules/bioexcel/biobb_amber/process_mdout'
include { BIOBB_AMBER_SANDER_MDRUN as STEP22_SANDER_MDRUN_EQ9 } from './modules/bioexcel/biobb_amber/sander_mdrun'
include { BIOBB_AMBER_PROCESS_MDOUT as STEP23_PROCESS_MDOUT_EQ9 } from './modules/bioexcel/biobb_amber/process_mdout'
include { BIOBB_AMBER_SANDER_MDRUN as STEP24_SANDER_MDRUN_EQ10 } from './modules/bioexcel/biobb_amber/sander_mdrun'
include { BIOBB_AMBER_PROCESS_MDOUT as STEP25_PROCESS_MDOUT_EQ10 } from './modules/bioexcel/biobb_amber/process_mdout'
include { BIOBB_AMBER_SANDER_MDRUN as STEP26_SANDER_MDRUN_MD } from './modules/bioexcel/biobb_amber/sander_mdrun'
include { BIOBB_ANALYSIS_CPPTRAJ_RMS as STEP27_RMSD_FIRST } from './modules/bioexcel/biobb_analysis/cpptraj_rms'
include { BIOBB_ANALYSIS_CPPTRAJ_RMS as STEP28_RMSD_EXP } from './modules/bioexcel/biobb_analysis/cpptraj_rms'
include { BIOBB_ANALYSIS_CPPTRAJ_RGYR as STEP29_CPPTRAJ_RGYR } from './modules/bioexcel/biobb_analysis/cpptraj_rgyr'
include { BIOBB_ANALYSIS_CPPTRAJ_IMAGE as STEP30_CPPTRAJ_IMAGE } from './modules/bioexcel/biobb_analysis/cpptraj_image'

params {
    // CSV with an id column and one column per input file: one workflow run per row
    input: String = "${projectDir}/samplesheet.csv"
}

workflow {
    main:
    // One [meta, files] item per samplesheet row: the steps of every row run in parallel
    ch_samples = channel.fromPath(params.input)
        .splitCsv(header: true)
        .map { row -> [[id: row.id], [sequence: samplePath(row.sequence), step1: samplePath(row.step1), step2: samplePath(row.step2), step3: samplePath(row.step3), step4: samplePath(row.step4), step5: samplePath(row.step5), step6: samplePath(row.step6), step7: samplePath(row.step7), step8: samplePath(row.step8), step9: samplePath(row.step9), step10: samplePath(row.step10), md: samplePath(row.md)]] }

    // step1_leap_gen_top: Generating Topology
    STEP1_LEAP_GEN_TOP(
        ch_samples.map { meta, files -> [meta, files.sequence] }
            .map { meta, pdb -> [meta, pdb, [], [], [], [], []] }
    )
    // step2_leap_solvate: Adding Water Box
    STEP2_LEAP_SOLVATE(
        STEP1_LEAP_GEN_TOP.out.output_pdb_path
            .map { meta, pdb -> [meta, pdb, [], [], [], [], []] }
    )
    // step3_leap_add_ions: Adding additional ionic concentration
    STEP3_LEAP_ADD_IONS(
        STEP2_LEAP_SOLVATE.out.output_pdb_path
            .map { meta, pdb -> [meta, pdb, [], [], [], [], []] }
    )
    // step4_cpptraj_randomize_ions: Randomizing ions
    STEP4_CPPTRAJ_RANDOMIZE_IONS(
        STEP3_LEAP_ADD_IONS.out.output_top_path
            .join(STEP3_LEAP_ADD_IONS.out.output_crd_path)
    )
    // step5_parmed_hmassrepartition: Generating Topology with Hydrogen Mass Partitioning (4fs)
    STEP5_PARMED_HMASSREPARTITION(STEP3_LEAP_ADD_IONS.out.output_top_path)
    // step6_sander_mdrun_eq1: Equilibration Step 1: System energetic minimization
    STEP6_SANDER_MDRUN_EQ1(
        STEP5_PARMED_HMASSREPARTITION.out.output_top_path
            .join(STEP4_CPPTRAJ_RANDOMIZE_IONS.out.output_crd_path)
            .join(ch_samples.map { meta, files -> [meta, files.step1] })
            .join(STEP4_CPPTRAJ_RANDOMIZE_IONS.out.output_crd_path)
            .map { meta, top, crd, mdin, ref -> [meta, top, crd, mdin, [], ref] }
    )
    // step7_process_minout_eq1: Checking Equilibration Step 1 results
    STEP7_PROCESS_MINOUT_EQ1(STEP6_SANDER_MDRUN_EQ1.out.output_log_path)
    // step8_sander_mdrun_eq2: Equilibration Step 2: NVT equilibration
    STEP8_SANDER_MDRUN_EQ2(
        STEP5_PARMED_HMASSREPARTITION.out.output_top_path
            .join(STEP6_SANDER_MDRUN_EQ1.out.output_rst_path)
            .join(ch_samples.map { meta, files -> [meta, files.step2] })
            .join(STEP6_SANDER_MDRUN_EQ1.out.output_rst_path)
            .map { meta, top, crd, mdin, ref -> [meta, top, crd, mdin, [], ref] }
    )
    // step9_process_mdout_eq2: Checking Equilibration Step 2 results
    STEP9_PROCESS_MDOUT_EQ2(STEP8_SANDER_MDRUN_EQ2.out.output_log_path)
    // step10_sander_mdrun_eq3: Equilibration Step 3: System energetic minimization
    STEP10_SANDER_MDRUN_EQ3(
        STEP5_PARMED_HMASSREPARTITION.out.output_top_path
            .join(STEP8_SANDER_MDRUN_EQ2.out.output_rst_path)
            .join(ch_samples.map { meta, files -> [meta, files.step3] })
            .join(STEP8_SANDER_MDRUN_EQ2.out.output_rst_path)
            .map { meta, top, crd, mdin, ref -> [meta, top, crd, mdin, [], ref] }
    )
    // step11_process_minout_eq3: Checking Equilibration Step 3 results
    STEP11_PROCESS_MINOUT_EQ3(STEP10_SANDER_MDRUN_EQ3.out.output_log_path)
    // step12_sander_mdrun_eq4: Equilibration Step 4: System energetic minimization
    STEP12_SANDER_MDRUN_EQ4(
        STEP5_PARMED_HMASSREPARTITION.out.output_top_path
            .join(STEP10_SANDER_MDRUN_EQ3.out.output_rst_path)
            .join(ch_samples.map { meta, files -> [meta, files.step4] })
            .join(STEP10_SANDER_MDRUN_EQ3.out.output_rst_path)
            .map { meta, top, crd, mdin, ref -> [meta, top, crd, mdin, [], ref] }
    )
    // step13_process_minout_eq4: Checking Equilibration Step 4 results
    STEP13_PROCESS_MINOUT_EQ4(STEP12_SANDER_MDRUN_EQ4.out.output_log_path)
    // step14_sander_mdrun_eq5: Equilibration Step 5: System energetic minimization
    STEP14_SANDER_MDRUN_EQ5(
        STEP5_PARMED_HMASSREPARTITION.out.output_top_path
            .join(STEP12_SANDER_MDRUN_EQ4.out.output_rst_path)
            .join(ch_samples.map { meta, files -> [meta, files.step5] })
            .join(STEP12_SANDER_MDRUN_EQ4.out.output_rst_path)
            .map { meta, top, crd, mdin, ref -> [meta, top, crd, mdin, [], ref] }
    )
    // step15_process_minout_eq5: Checking Equilibration Step 5 results
    STEP15_PROCESS_MINOUT_EQ5(STEP14_SANDER_MDRUN_EQ5.out.output_log_path)
    // step16_sander_mdrun_eq6: Equilibration Step 6: NPT equilibration
    STEP16_SANDER_MDRUN_EQ6(
        STEP5_PARMED_HMASSREPARTITION.out.output_top_path
            .join(STEP14_SANDER_MDRUN_EQ5.out.output_rst_path)
            .join(ch_samples.map { meta, files -> [meta, files.step6] })
            .join(STEP14_SANDER_MDRUN_EQ5.out.output_rst_path)
            .map { meta, top, crd, mdin, ref -> [meta, top, crd, mdin, [], ref] }
    )
    // step17_process_mdout_eq6: Checking Equilibration Step 6 results
    STEP17_PROCESS_MDOUT_EQ6(STEP16_SANDER_MDRUN_EQ6.out.output_log_path)
    // step18_sander_mdrun_eq7: Equilibration Step 7: NPT equilibration
    STEP18_SANDER_MDRUN_EQ7(
        STEP5_PARMED_HMASSREPARTITION.out.output_top_path
            .join(STEP16_SANDER_MDRUN_EQ6.out.output_rst_path)
            .join(ch_samples.map { meta, files -> [meta, files.step7] })
            .join(STEP16_SANDER_MDRUN_EQ6.out.output_rst_path)
            .map { meta, top, crd, mdin, ref -> [meta, top, crd, mdin, [], ref] }
    )
    // step19_process_mdout_eq7: Checking Equilibration Step 7 results
    STEP19_PROCESS_MDOUT_EQ7(STEP18_SANDER_MDRUN_EQ7.out.output_log_path)
    // step20_sander_mdrun_eq8: Equilibration Step 8: NPT equilibration
    STEP20_SANDER_MDRUN_EQ8(
        STEP5_PARMED_HMASSREPARTITION.out.output_top_path
            .join(STEP18_SANDER_MDRUN_EQ7.out.output_rst_path)
            .join(ch_samples.map { meta, files -> [meta, files.step8] })
            .join(STEP18_SANDER_MDRUN_EQ7.out.output_rst_path)
            .map { meta, top, crd, mdin, ref -> [meta, top, crd, mdin, [], ref] }
    )
    // step21_process_mdout_eq8: Checking Equilibration Step 8 results
    STEP21_PROCESS_MDOUT_EQ8(STEP20_SANDER_MDRUN_EQ8.out.output_log_path)
    // step22_sander_mdrun_eq9: Equilibration Step 9: NPT equilibration
    STEP22_SANDER_MDRUN_EQ9(
        STEP5_PARMED_HMASSREPARTITION.out.output_top_path
            .join(STEP20_SANDER_MDRUN_EQ8.out.output_rst_path)
            .join(ch_samples.map { meta, files -> [meta, files.step9] })
            .join(STEP20_SANDER_MDRUN_EQ8.out.output_rst_path)
            .map { meta, top, crd, mdin, ref -> [meta, top, crd, mdin, [], ref] }
    )
    // step23_process_mdout_eq9: Checking Equilibration Step 9 results
    STEP23_PROCESS_MDOUT_EQ9(STEP22_SANDER_MDRUN_EQ9.out.output_log_path)
    // step24_sander_mdrun_eq10: Equilibration Step 10: NPT equilibration
    STEP24_SANDER_MDRUN_EQ10(
        STEP5_PARMED_HMASSREPARTITION.out.output_top_path
            .join(STEP22_SANDER_MDRUN_EQ9.out.output_rst_path)
            .join(ch_samples.map { meta, files -> [meta, files.step10] })
            .join(STEP22_SANDER_MDRUN_EQ9.out.output_rst_path)
            .map { meta, top, crd, mdin, ref -> [meta, top, crd, mdin, [], ref] }
    )
    // step25_process_mdout_eq10: Checking Equilibration Step 10 results
    STEP25_PROCESS_MDOUT_EQ10(STEP24_SANDER_MDRUN_EQ10.out.output_log_path)
    // step26_sander_mdrun_md: Free Molecular Dynamics Simulation
    STEP26_SANDER_MDRUN_MD(
        STEP5_PARMED_HMASSREPARTITION.out.output_top_path
            .join(STEP24_SANDER_MDRUN_EQ10.out.output_rst_path)
            .join(ch_samples.map { meta, files -> [meta, files.md] })
            .join(STEP24_SANDER_MDRUN_EQ10.out.output_rst_path)
            .map { meta, top, crd, mdin, ref -> [meta, top, crd, mdin, [], ref] }
    )
    // step27_rmsd_first: Generate RMSd (against 1st snp.) plot for the resulting setup trajectory from the free md step
    STEP27_RMSD_FIRST(
        STEP3_LEAP_ADD_IONS.out.output_top_path
            .join(STEP26_SANDER_MDRUN_MD.out.output_traj_path)
            .map { meta, top, traj -> [meta, top, traj, []] }
    )
    // step28_rmsd_exp: Generate RMSd (against exp.) plot for the resulting setup trajectory from the free md step
    STEP28_RMSD_EXP(
        STEP3_LEAP_ADD_IONS.out.output_top_path
            .join(STEP26_SANDER_MDRUN_MD.out.output_traj_path)
            .join(STEP1_LEAP_GEN_TOP.out.output_pdb_path)
    )
    // step29_cpptraj_rgyr: Generate Radius of Gyration plot for the resulting setup trajectory from the free md step
    STEP29_CPPTRAJ_RGYR(
        STEP3_LEAP_ADD_IONS.out.output_top_path
            .join(STEP26_SANDER_MDRUN_MD.out.output_traj_path)
    )
    // step30_cpptraj_image: Imaging the resulting trajectory
    STEP30_CPPTRAJ_IMAGE(
        STEP3_LEAP_ADD_IONS.out.output_top_path
            .join(STEP26_SANDER_MDRUN_MD.out.output_traj_path)
    )

    publish:
    results = channel.empty().mix(
        STEP1_LEAP_GEN_TOP.out.output_pdb_path.mix(STEP1_LEAP_GEN_TOP.out.output_top_path, STEP1_LEAP_GEN_TOP.out.output_crd_path).map { meta, result -> [meta, 'step1_leap_gen_top', result] },
        STEP2_LEAP_SOLVATE.out.output_pdb_path.mix(STEP2_LEAP_SOLVATE.out.output_top_path, STEP2_LEAP_SOLVATE.out.output_crd_path).map { meta, result -> [meta, 'step2_leap_solvate', result] },
        STEP3_LEAP_ADD_IONS.out.output_pdb_path.mix(STEP3_LEAP_ADD_IONS.out.output_top_path, STEP3_LEAP_ADD_IONS.out.output_crd_path).map { meta, result -> [meta, 'step3_leap_add_ions', result] },
        STEP4_CPPTRAJ_RANDOMIZE_IONS.out.output_pdb_path.mix(STEP4_CPPTRAJ_RANDOMIZE_IONS.out.output_crd_path).map { meta, result -> [meta, 'step4_cpptraj_randomize_ions', result] },
        STEP5_PARMED_HMASSREPARTITION.out.output_top_path.map { meta, result -> [meta, 'step5_parmed_hmassrepartition', result] },
        STEP6_SANDER_MDRUN_EQ1.out.output_log_path.mix(STEP6_SANDER_MDRUN_EQ1.out.output_traj_path, STEP6_SANDER_MDRUN_EQ1.out.output_rst_path, STEP6_SANDER_MDRUN_EQ1.out.output_mdinfo_path).map { meta, result -> [meta, 'step6_sander_mdrun_eq1', result] },
