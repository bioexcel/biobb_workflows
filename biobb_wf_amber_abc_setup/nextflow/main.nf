        STEP9_PROCESS_MDOUT_EQ2.out.output_dat_path.map { meta, result -> [meta, 'step9_process_mdout_eq2', result] },
        STEP10_SANDER_MDRUN_EQ3.out.output_log_path.mix(STEP10_SANDER_MDRUN_EQ3.out.output_traj_path, STEP10_SANDER_MDRUN_EQ3.out.output_rst_path, STEP10_SANDER_MDRUN_EQ3.out.output_mdinfo_path).map { meta, result -> [meta, 'step10_sander_mdrun_eq3', result] },
        STEP11_PROCESS_MINOUT_EQ3.out.output_dat_path.map { meta, result -> [meta, 'step11_process_minout_eq3', result] },
        STEP12_SANDER_MDRUN_EQ4.out.output_log_path.mix(STEP12_SANDER_MDRUN_EQ4.out.output_traj_path, STEP12_SANDER_MDRUN_EQ4.out.output_rst_path, STEP12_SANDER_MDRUN_EQ4.out.output_mdinfo_path).map { meta, result -> [meta, 'step12_sander_mdrun_eq4', result] },
        STEP13_PROCESS_MINOUT_EQ4.out.output_dat_path.map { meta, result -> [meta, 'step13_process_minout_eq4', result] },
        STEP14_SANDER_MDRUN_EQ5.out.output_log_path.mix(STEP14_SANDER_MDRUN_EQ5.out.output_traj_path, STEP14_SANDER_MDRUN_EQ5.out.output_rst_path, STEP14_SANDER_MDRUN_EQ5.out.output_mdinfo_path).map { meta, result -> [meta, 'step14_sander_mdrun_eq5', result] },
        STEP15_PROCESS_MINOUT_EQ5.out.output_dat_path.map { meta, result -> [meta, 'step15_process_minout_eq5', result] },
        STEP16_SANDER_MDRUN_EQ6.out.output_log_path.mix(STEP16_SANDER_MDRUN_EQ6.out.output_traj_path, STEP16_SANDER_MDRUN_EQ6.out.output_rst_path, STEP16_SANDER_MDRUN_EQ6.out.output_mdinfo_path).map { meta, result -> [meta, 'step16_sander_mdrun_eq6', result] },
        STEP17_PROCESS_MDOUT_EQ6.out.output_dat_path.map { meta, result -> [meta, 'step17_process_mdout_eq6', result] },
        STEP18_SANDER_MDRUN_EQ7.out.output_log_path.mix(STEP18_SANDER_MDRUN_EQ7.out.output_traj_path, STEP18_SANDER_MDRUN_EQ7.out.output_rst_path, STEP18_SANDER_MDRUN_EQ7.out.output_mdinfo_path).map { meta, result -> [meta, 'step18_sander_mdrun_eq7', result] },
        STEP19_PROCESS_MDOUT_EQ7.out.output_dat_path.map { meta, result -> [meta, 'step19_process_mdout_eq7', result] },
        STEP20_SANDER_MDRUN_EQ8.out.output_log_path.mix(STEP20_SANDER_MDRUN_EQ8.out.output_traj_path, STEP20_SANDER_MDRUN_EQ8.out.output_rst_path, STEP20_SANDER_MDRUN_EQ8.out.output_mdinfo_path).map { meta, result -> [meta, 'step20_sander_mdrun_eq8', result] },
