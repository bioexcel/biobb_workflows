/*
 * Generated by utils_biobb nextflow_wf_generator.py from the python workflow: do not edit by hand.
 * Configuration of biobb_wf_amber_abc_setup: biobb properties (ext.properties) and output extensions (ext.outputs) of every step,
 * from python/workflow.yml.
 */

manifest {
    name = 'biobb_wf_amber_abc_setup'
    description = 'AMBER ABC MD Setup tutorial using BioExcel Building Blocks (biobb)'
    homePage = 'https://github.com/bioexcel/biobb_workflows'
    mainScript = 'main.nf'
    nextflowVersion = '!>=25.10.0'
    license = 'Apache-2.0'
}

outputDir = 'results'
workflow.output.mode = 'copy'

process {
    // Output files named <id>_<step>_<role>.<ext>
    ext.prefix = { "${meta.id}_${task.process.tokenize(':')[-1].toLowerCase()}" }

    withName: 'STEP1_LEAP_GEN_TOP' {
        ext.properties = [forcefield: ['DNA.bsc1']]
    }

    withName: 'STEP2_LEAP_SOLVATE' {
        ext.properties = [forcefield: ['DNA.bsc1'], water_type: 'OPCBOX', ions_type: 'ionsjc_tip4pew', box_type: 'truncated_octahedron', distance_to_molecule: 15, neutralise: true, iso: true, closeness: 0.97, positive_ions_type: 'K+']
        ext.outputs = [output_top_path: 'parmtop']
    }

    withName: 'STEP3_LEAP_ADD_IONS' {
        ext.properties = [forcefield: ['DNA.bsc1'], water_type: 'OPCBOX', ions_type: 'ionsjc_tip4pew', box_type: 'truncated_octahedron', ionic_concentration: 100, positive_ions_type: 'K+']
        ext.outputs = [output_top_path: 'parmtop']
    }

    withName: 'STEP4_CPPTRAJ_RANDOMIZE_IONS' {
        ext.properties = [distance: 6.0, overlap: 4.0]
    }

    withName: 'STEP6_SANDER_MDRUN_EQ1' {
        ext.properties = [mdin: [maxcyc: 1000, restraintmask: ':DA,DC,DG,DT,D=3,D=5&!@H=']]
        ext.outputs = [output_traj_path: 'nc', output_rst_path: 'ncrst', output_mdinfo_path: 'mdinfo']
    }

    withName: 'STEP7_PROCESS_MINOUT_EQ1' {
        ext.properties = [terms: ['ENERGY']]
    }

    withName: 'STEP8_SANDER_MDRUN_EQ2' {
        ext.properties = [mdin: [nstlim: 15000, restraintmask: ':DA,DC,DG,DT,D=3,D=5&!@H=']]
        ext.outputs = [output_traj_path: 'nc', output_rst_path: 'ncrst', output_mdinfo_path: 'mdinfo']
    }

    withName: 'STEP9_PROCESS_MDOUT_EQ2' {
        ext.properties = [terms: ['TEMP']]
    }

    withName: 'STEP10_SANDER_MDRUN_EQ3' {
        ext.properties = [mdin: [maxcyc: 1000, restraintmask: ':DA,DC,DG,DT,D=3,D=5&!@H=']]
        ext.outputs = [output_traj_path: 'nc', output_rst_path: 'ncrst', output_mdinfo_path: 'mdinfo']
    }

    withName: 'STEP11_PROCESS_MINOUT_EQ3' {
        ext.properties = [terms: ['ENERGY']]
    }

    withName: 'STEP12_SANDER_MDRUN_EQ4' {
        ext.properties = [mdin: [maxcyc: 1000, restraintmask: ':DA,DC,DG,DT,D=3,D=5&!@H=']]
        ext.outputs = [output_traj_path: 'nc', output_rst_path: 'ncrst', output_mdinfo_path: 'mdinfo']
    }

    withName: 'STEP13_PROCESS_MINOUT_EQ4' {
        ext.properties = [terms: ['ENERGY']]
    }

    withName: 'STEP14_SANDER_MDRUN_EQ5' {
        ext.properties = [mdin: [maxcyc: 1000]]
        ext.outputs = [output_traj_path: 'nc', output_rst_path: 'ncrst', output_mdinfo_path: 'mdinfo']
    }

    withName: 'STEP15_PROCESS_MINOUT_EQ5' {
        ext.properties = [terms: ['ENERGY']]
    }

    withName: 'STEP16_SANDER_MDRUN_EQ6' {
        ext.properties = [mdin: [nstlim: 5000, restraintmask: ':DA,DC,DG,DT,D=3,D=5&!@H=']]
        ext.outputs = [output_traj_path: 'nc', output_rst_path: 'ncrst', output_mdinfo_path: 'mdinfo']
    }

    withName: 'STEP17_PROCESS_MDOUT_EQ6' {
        ext.properties = [terms: ['PRES']]
    }

    withName: 'STEP18_SANDER_MDRUN_EQ7' {
        ext.properties = [mdin: [nstlim: 5000, restraintmask: ':DA,DC,DG,DT,D=3,D=5&!@H=']]
        ext.outputs = [output_traj_path: 'nc', output_rst_path: 'ncrst', output_mdinfo_path: 'mdinfo']
    }

    withName: 'STEP19_PROCESS_MDOUT_EQ7' {
        ext.properties = [terms: ['PRES', 'DENSITY']]
    }

    withName: 'STEP20_SANDER_MDRUN_EQ8' {
        ext.properties = [mdin: [nstlim: 10000, restraintmask: ':DA,DC,DG,DT,D=3,D=5&@P,O5=,C5=,C4=,C3=,O3=']]
        ext.outputs = [output_traj_path: 'nc', output_rst_path: 'ncrst', output_mdinfo_path: 'mdinfo']
    }

    withName: 'STEP21_PROCESS_MDOUT_EQ8' {
        ext.properties = [terms: ['PRES', 'DENSITY']]
    }

    withName: 'STEP22_SANDER_MDRUN_EQ9' {
        ext.properties = [mdin: [nstlim: 10000]]
        ext.outputs = [output_traj_path: 'nc', output_rst_path: 'ncrst', output_mdinfo_path: 'mdinfo']
    }

    withName: 'STEP23_PROCESS_MDOUT_EQ9' {
        ext.properties = [terms: ['PRES', 'DENSITY']]
    }

    withName: 'STEP24_SANDER_MDRUN_EQ10' {
        ext.properties = [mdin: [nstlim: 10000, ntpr: 50]]
        ext.outputs = [output_traj_path: 'nc', output_rst_path: 'ncrst', output_mdinfo_path: 'mdinfo']
    }

    withName: 'STEP25_PROCESS_MDOUT_EQ10' {
        ext.properties = [terms: ['PRES', 'DENSITY']]
    }

    withName: 'STEP26_SANDER_MDRUN_MD' {
        ext.properties = [mdin: [nstlim: 25000, ntpr: 50, ntwx: 50]]
        ext.outputs = [output_traj_path: 'netcdf', output_rst_path: 'ncrst', output_mdinfo_path: 'mdinfo']
    }

    withName: 'STEP27_RMSD_FIRST' {
        ext.properties = [mask: 'backbone', reference: 'first']
    }

    withName: 'STEP28_RMSD_EXP' {
        ext.properties = [mask: 'backbone', reference: 'experimental']
    }

    withName: 'STEP29_CPPTRAJ_RGYR' {
        ext.properties = [mask: 'backbone']
    }

    withName: 'STEP30_CPPTRAJ_IMAGE' {
        ext.properties = [mask: 'solute', format: 'xtc']
        ext.outputs = [output_cpptraj_path: 'xtc']
    }
}

profiles {
    docker {
        docker.enabled = true
        // Run as the host user, so the results are not owned by root
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    apptainer {
        apptainer.enabled = true
    }
    singularity {
        singularity.enabled = true
    }
    conda {
        conda.enabled = true
        conda.channels = ['conda-forge', 'bioconda']
    }
}
