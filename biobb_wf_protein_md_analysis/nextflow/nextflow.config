/*
 * Configuration of biobb_wf_protein_md_analysis: biobb properties (ext.properties) and output extensions (ext.outputs) of every step,
 * from python/workflow.yml.
 */

manifest {
    name = 'biobb_wf_protein_md_analysis'
    description = 'Protein MD Analysis tutorial using BioExcel Building Blocks (biobb)'
    homePage = 'https://github.com/bioexcel/biobb_workflows'
    mainScript = 'main.nf'
    nextflowVersion = '!>=25.10.0'
    license = 'Apache-2.0'
}

outputDir = 'results'
workflow.output.mode = 'copy'

process {
    // Output files named <id>_<step>_<role>.<ext>
    ext.prefix = { "${meta.id}_${task.process.tokenize(':')[-1].toLowerCase()}" }

    withName: 'STEP1_CPPTRAJ_AVERAGE' {
        ext.properties = [run_md: false, format: 'pdb']
        ext.outputs = [output_cpptraj_path: 'pdb']
    }

    withName: 'STEP2_CPPTRAJ_RMS_FIRST' {
        ext.properties = [run_md: false, reference: 'first']
    }

    withName: 'STEP3_CPPTRAJ_RMS_AVERAGE' {
        ext.properties = [run_md: false, reference: 'average']
    }

    withName: 'STEP4_CPPTRAJ_BFACTOR' {
        ext.properties = [run_md: false, reference: 'first']
    }

    withName: 'STEP5_CPPTRAJ_RGYR' {
        ext.properties = [run_md: false]
    }

    withName: 'STEP6_CPPTRAJ_CONVERT' {
        ext.properties = [run_md: false, format: 'trr']
        ext.outputs = [output_cpptraj_path: 'trr']
    }

    withName: 'STEP7_GMX_CLUSTER' {
        ext.properties = [run_md: false, cutoff: 0.2]
        ext.outputs = [output_pdb_path: 'pdb', output_cluster_log_path: 'log']
    }

    // Python logic of workflow.py: files written in the folder of their step
    withName: 'SAVE_BFACTOR' {
        ext.prefix = { "${meta.id}_step4_cpptraj_bfactor" }
    }

    withName: 'SAVE_CLUSTERS' {
        ext.prefix = { "${meta.id}_step7_gmx_cluster" }
    }
}

profiles {
    docker {
        docker.enabled = true
        // Run as the host user, so the results are not owned by root
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    apptainer {
        apptainer.enabled = true
    }
    singularity {
        singularity.enabled = true
    }
    conda {
        conda.enabled = true
        conda.channels = ['conda-forge', 'bioconda']
    }
}
