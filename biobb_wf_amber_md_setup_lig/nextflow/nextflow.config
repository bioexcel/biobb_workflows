/*
 * Generated by utils_biobb nextflow_wf_generator.py from the python workflow: do not edit by hand.
 * Configuration of biobb_wf_amber_md_setup_lig: biobb properties (ext.properties) and output extensions (ext.outputs) of every step,
 * from python/workflow.yml.
 */

manifest {
    name = 'biobb_wf_amber_md_setup_lig'
    description = 'AMBER Protein Complex MD Setup tutorial using BioExcel Building Blocks (biobb)'
    homePage = 'https://github.com/bioexcel/biobb_workflows'
    mainScript = 'main.nf'
    nextflowVersion = '!>=25.10.0'
    license = 'Apache-2.0'
}

outputDir = 'results'
workflow.output.mode = 'copy'

process {
    // Output files named <id>_<step>_<role>.<ext>
    ext.prefix = { "${meta.id}_${task.process.tokenize(':')[-1].toLowerCase()}" }

    withName: 'STEP2_LEAP_GEN_TOP' {
        ext.properties = [forcefield: ['protein.ff14SB', 'DNA.bsc1', 'RNA.OL3', 'gaff', 'water.tip3p']]
    }

    withName: 'STEP3_SANDER_MDRUN_MINH' {
        ext.properties = [simulation_type: 'min_vacuo', mdin: [maxcyc: 500, ntwx: 100, ntpr: 5, ntr: 1, restraintmask: '":*&!@H="', restraint_wt: 50.0]]
        ext.outputs = [output_traj_path: 'x']
    }

    withName: 'STEP4_PROCESS_MINOUT_MINH' {
        ext.properties = [terms: ['ENERGY']]
    }

    withName: 'STEP5_SANDER_MDRUN_MIN' {
        ext.properties = [simulation_type: 'min_vacuo', mdin: [maxcyc: 500, ntwx: 100, ntpr: 5, ntr: 1, restraintmask: '":*&!@H="', restraint_wt: 50.0]]
        ext.outputs = [output_traj_path: 'x']
    }

    withName: 'STEP6_PROCESS_MINOUT_MIN' {
        ext.properties = [terms: ['ENERGY']]
    }

    withName: 'STEP8_LEAP_SOLVATE' {
        ext.properties = [forcefield: ['protein.ff14SB', 'DNA.bsc1', 'RNA.OL3', 'gaff', 'water.tip3p'], water_type: 'TIP3PBOX', distance_to_molecule: 9, box_type: 'truncated_octahedron']
        ext.outputs = [output_top_path: 'parmtop']
    }

    withName: 'STEP9_LEAP_ADD_IONS' {
        ext.properties = [forcefield: ['protein.ff14SB', 'DNA.bsc1', 'RNA.OL3', 'gaff', 'water.tip3p'], neutralise: true, positive_ions_type: 'Na+', negative_ions_type: 'Cl-', ionic_concentration: 150, box_type: 'truncated_octahedron']
        ext.outputs = [output_top_path: 'parmtop']
    }

    withName: 'STEP10_SANDER_MDRUN_ENERGY' {
        ext.properties = [simulation_type: 'minimization', mdin: [maxcyc: 500, ntwx: 100, ntr: 1, restraintmask: '"!:WAT,Cl-,Na+"', restraint_wt: 50.0]]
        ext.outputs = [output_traj_path: 'x']
    }

    withName: 'STEP11_PROCESS_MINOUT_ENERGY' {
        ext.properties = [terms: ['ENERGY']]
    }

    withName: 'STEP12_SANDER_MDRUN_WARM' {
        ext.properties = [simulation_type: 'heat', mdin: [maxcyc: 50000, ntwx: 100, ntr: 1, restraintmask: '"!:WAT,Cl-,Na+"', restraint_wt: 10.0]]
        ext.outputs = [output_traj_path: 'netcdf']
    }

    withName: 'STEP13_PROCESS_MDOUT_WARM' {
        ext.properties = [terms: ['TEMP']]
    }

    withName: 'STEP14_SANDER_MDRUN_NVT' {
        ext.properties = [simulation_type: 'nvt', mdin: [nstlim: 25000, ntwx: 100, ntr: 1, restraintmask: '"!:WAT,Cl-,Na+ & !@H="', restraint_wt: 5.0]]
        ext.outputs = [output_traj_path: 'netcdf']
    }

    withName: 'STEP15_PROCESS_MDOUT_NVT' {
        ext.properties = [terms: ['TEMP']]
    }

    withName: 'STEP16_SANDER_MDRUN_NPT' {
        ext.properties = [simulation_type: 'npt', mdin: [nstlim: 25000, ntwx: 100, ntr: 1, restraintmask: '"!:WAT,Cl-,Na+ & !@H="', restraint_wt: 2.5]]
        ext.outputs = [output_traj_path: 'netcdf']
    }

    withName: 'STEP17_PROCESS_MDOUT_NPT' {
        ext.properties = [terms: ['PRES', 'DENSITY']]
    }

    withName: 'STEP18_SANDER_MDRUN_MD' {
        ext.properties = [simulation_type: 'free', mdin: [nstlim: 250000, ntwx: 500]]
        ext.outputs = [output_traj_path: 'netcdf']
    }

    withName: 'STEP19_RMSD_FIRST' {
        ext.properties = [mask: 'backbone', reference: 'first']
    }

    withName: 'STEP20_RMSD_EXP' {
        ext.properties = [mask: 'backbone', reference: 'experimental']
    }

    withName: 'STEP21_CPPTRAJ_RGYR' {
        ext.properties = [mask: 'backbone']
    }

    withName: 'STEP22_CPPTRAJ_IMAGE' {
        ext.properties = [mask: 'all-atoms', format: 'xtc']
        ext.outputs = [output_cpptraj_path: 'xtc']
    }
}

profiles {
    docker {
        docker.enabled = true
        // Run as the host user, so the results are not owned by root
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    apptainer {
        apptainer.enabled = true
    }
    singularity {
        singularity.enabled = true
    }
    conda {
        conda.enabled = true
        conda.channels = ['conda-forge', 'bioconda']
    }
}
