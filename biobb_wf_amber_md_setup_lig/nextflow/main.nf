/*
 * Generated by utils_biobb nextflow_wf_generator.py from the python workflow: do not edit by hand.
 * AMBER Protein Complex MD Setup tutorial using BioExcel Building Blocks (biobb)
 * Nextflow version of biobb_wf_amber_md_setup_lig/python/workflow.py, with the BioBB Nextflow modules in modules/.
 * Usage: nextflow run main.nf -profile docker [--input samplesheet.csv]
 */

include { BIOBB_CHEMISTRY_REDUCE_REMOVE_HYDROGENS as STEP000_REDUCE_REMOVE_HYDROGENS } from './modules/bioexcel/biobb_chemistry/reduce_remove_hydrogens'
include { BIOBB_STRUCTURE_UTILS_EXTRACT_MOLECULE as STEP00_EXTRACT_MOLECULE } from './modules/bioexcel/biobb_structure_utils/extract_molecule'
include { BIOBB_STRUCTURE_UTILS_CAT_PDB as STEP0000_CAT_PDB } from './modules/bioexcel/biobb_structure_utils/cat_pdb'
include { BIOBB_STRUCTURE_UTILS_CAT_PDB as STEP0_CAT_PDB } from './modules/bioexcel/biobb_structure_utils/cat_pdb'
include { BIOBB_AMBER_PDB4AMBER_RUN as STEP1_PDB4AMBER_RUN } from './modules/bioexcel/biobb_amber/pdb4amber_run'
include { BIOBB_AMBER_LEAP_GEN_TOP as STEP2_LEAP_GEN_TOP } from './modules/bioexcel/biobb_amber/leap_gen_top'
include { BIOBB_AMBER_SANDER_MDRUN as STEP3_SANDER_MDRUN_MINH } from './modules/bioexcel/biobb_amber/sander_mdrun'
include { BIOBB_AMBER_PROCESS_MINOUT as STEP4_PROCESS_MINOUT_MINH } from './modules/bioexcel/biobb_amber/process_minout'
include { BIOBB_AMBER_SANDER_MDRUN as STEP5_SANDER_MDRUN_MIN } from './modules/bioexcel/biobb_amber/sander_mdrun'
include { BIOBB_AMBER_PROCESS_MINOUT as STEP6_PROCESS_MINOUT_MIN } from './modules/bioexcel/biobb_amber/process_minout'
include { BIOBB_AMBER_AMBER_TO_PDB as STEP7_AMBER_TO_PDB } from './modules/bioexcel/biobb_amber/amber_to_pdb'
include { BIOBB_AMBER_LEAP_SOLVATE as STEP8_LEAP_SOLVATE } from './modules/bioexcel/biobb_amber/leap_solvate'
include { BIOBB_AMBER_LEAP_ADD_IONS as STEP9_LEAP_ADD_IONS } from './modules/bioexcel/biobb_amber/leap_add_ions'
include { BIOBB_AMBER_SANDER_MDRUN as STEP10_SANDER_MDRUN_ENERGY } from './modules/bioexcel/biobb_amber/sander_mdrun'
include { BIOBB_AMBER_PROCESS_MINOUT as STEP11_PROCESS_MINOUT_ENERGY } from './modules/bioexcel/biobb_amber/process_minout'
include { BIOBB_AMBER_SANDER_MDRUN as STEP12_SANDER_MDRUN_WARM } from './modules/bioexcel/biobb_amber/sander_mdrun'
include { BIOBB_AMBER_PROCESS_MDOUT as STEP13_PROCESS_MDOUT_WARM } from './modules/bioexcel/biobb_amber/process_mdout'
include { BIOBB_AMBER_SANDER_MDRUN as STEP14_SANDER_MDRUN_NVT } from './modules/bioexcel/biobb_amber/sander_mdrun'
include { BIOBB_AMBER_PROCESS_MDOUT as STEP15_PROCESS_MDOUT_NVT } from './modules/bioexcel/biobb_amber/process_mdout'
include { BIOBB_AMBER_SANDER_MDRUN as STEP16_SANDER_MDRUN_NPT } from './modules/bioexcel/biobb_amber/sander_mdrun'
include { BIOBB_AMBER_PROCESS_MDOUT as STEP17_PROCESS_MDOUT_NPT } from './modules/bioexcel/biobb_amber/process_mdout'
include { BIOBB_AMBER_SANDER_MDRUN as STEP18_SANDER_MDRUN_MD } from './modules/bioexcel/biobb_amber/sander_mdrun'
include { BIOBB_ANALYSIS_CPPTRAJ_RMS as STEP19_RMSD_FIRST } from './modules/bioexcel/biobb_analysis/cpptraj_rms'
include { BIOBB_ANALYSIS_CPPTRAJ_RMS as STEP20_RMSD_EXP } from './modules/bioexcel/biobb_analysis/cpptraj_rms'
include { BIOBB_ANALYSIS_CPPTRAJ_RGYR as STEP21_CPPTRAJ_RGYR } from './modules/bioexcel/biobb_analysis/cpptraj_rgyr'
include { BIOBB_ANALYSIS_CPPTRAJ_IMAGE as STEP22_CPPTRAJ_IMAGE } from './modules/bioexcel/biobb_analysis/cpptraj_image'

params {
    // CSV with an id column and one column per input file: one workflow run per row
    input: String = "${projectDir}/samplesheet.csv"
}

workflow {
    main:
    // One [meta, files] item per samplesheet row: the steps of every row run in parallel
    ch_samples = channel.fromPath(params.input)
        .splitCsv(header: true)
        .map { row -> [[id: row.id], [structure: samplePath(row.structure), ions: samplePath(row.ions), heteroatoms: samplePath(row.heteroatoms), input_lib: samplePath(row.input_lib), input_frcmod: samplePath(row.input_frcmod)]] }

    // step000_reduce_remove_hydrogens: Removing Hydrogens
    STEP000_REDUCE_REMOVE_HYDROGENS(ch_samples.map { meta, files -> [meta, files.structure] })
    // step00_extract_molecule: Extracting protein
    STEP00_EXTRACT_MOLECULE(STEP000_REDUCE_REMOVE_HYDROGENS.out.output_path)
    // step0000_cat_pdb: Concatenating protein with included ions
    STEP0000_CAT_PDB(
        STEP00_EXTRACT_MOLECULE.out.output_molecule_path
            .join(ch_samples.map { meta, files -> [meta, files.ions] })
    )
    // step0_cat_pdb: Concatenating protein with parameterized ligands
    STEP0_CAT_PDB(
        STEP0000_CAT_PDB.out.output_structure_path
            .join(ch_samples.map { meta, files -> [meta, files.heteroatoms] })
    )
    // step1_pdb4amber_run: Preparing PDB file for AMBER
    STEP1_PDB4AMBER_RUN(STEP0_CAT_PDB.out.output_structure_path)
    // step2_leap_gen_top: Create protein system topology
    STEP2_LEAP_GEN_TOP(
        STEP1_PDB4AMBER_RUN.out.output_pdb_path
            .join(ch_samples.map { meta, files -> [meta, files.input_lib] })
            .join(ch_samples.map { meta, files -> [meta, files.input_frcmod] })
            .map { meta, pdb, lib, frcmod -> [meta, pdb, lib, frcmod, [], [], []] }
    )
    // step3_sander_mdrun_minH: Minimize Hydrogens
    STEP3_SANDER_MDRUN_MINH(
        STEP2_LEAP_GEN_TOP.out.output_top_path
            .join(STEP2_LEAP_GEN_TOP.out.output_crd_path)
            .join(STEP2_LEAP_GEN_TOP.out.output_crd_path)
            .map { meta, top, crd, ref -> [meta, top, crd, [], [], ref] }
    )
    // step4_process_minout_minH: Checking Energy Minimization results
    STEP4_PROCESS_MINOUT_MINH(STEP3_SANDER_MDRUN_MINH.out.output_log_path)
    // step5_sander_mdrun_min: Minimize the system
    STEP5_SANDER_MDRUN_MIN(
        STEP2_LEAP_GEN_TOP.out.output_top_path
            .join(STEP3_SANDER_MDRUN_MINH.out.output_rst_path)
            .join(STEP3_SANDER_MDRUN_MINH.out.output_rst_path)
            .map { meta, top, crd, ref -> [meta, top, crd, [], [], ref] }
    )
    // step6_process_minout_min: Checking Energy Minimization results
    STEP6_PROCESS_MINOUT_MIN(STEP5_SANDER_MDRUN_MIN.out.output_log_path)
    // step7_amber_to_pdb: Getting minimized structure
    STEP7_AMBER_TO_PDB(
        STEP2_LEAP_GEN_TOP.out.output_top_path
            .join(STEP5_SANDER_MDRUN_MIN.out.output_rst_path)
    )
    // step8_leap_solvate: Create water box
    STEP8_LEAP_SOLVATE(
        STEP7_AMBER_TO_PDB.out.output_pdb_path
            .join(ch_samples.map { meta, files -> [meta, files.input_lib] })
            .join(ch_samples.map { meta, files -> [meta, files.input_frcmod] })
            .map { meta, pdb, lib, frcmod -> [meta, pdb, lib, frcmod, [], [], []] }
    )
    // step9_leap_add_ions: Adding ions
    STEP9_LEAP_ADD_IONS(
        STEP8_LEAP_SOLVATE.out.output_pdb_path
            .join(ch_samples.map { meta, files -> [meta, files.input_lib] })
            .join(ch_samples.map { meta, files -> [meta, files.input_frcmod] })
            .map { meta, pdb, lib, frcmod -> [meta, pdb, lib, frcmod, [], [], []] }
    )
    // step10_sander_mdrun_energy: Running Energy Minimization
    STEP10_SANDER_MDRUN_ENERGY(
        STEP9_LEAP_ADD_IONS.out.output_top_path
            .join(STEP9_LEAP_ADD_IONS.out.output_crd_path)
            .join(STEP9_LEAP_ADD_IONS.out.output_crd_path)
            .map { meta, top, crd, ref -> [meta, top, crd, [], [], ref] }
    )
    // step11_process_minout_energy: Checking Energy Minimization results
    STEP11_PROCESS_MINOUT_ENERGY(STEP10_SANDER_MDRUN_ENERGY.out.output_log_path)
    // step12_sander_mdrun_warm: Warming up the system
    STEP12_SANDER_MDRUN_WARM(
        STEP9_LEAP_ADD_IONS.out.output_top_path
            .join(STEP10_SANDER_MDRUN_ENERGY.out.output_rst_path)
            .join(STEP10_SANDER_MDRUN_ENERGY.out.output_rst_path)
            .map { meta, top, crd, ref -> [meta, top, crd, [], [], ref] }
    )
    // step13_process_mdout_warm: Checking results from the system warming up
    STEP13_PROCESS_MDOUT_WARM(STEP12_SANDER_MDRUN_WARM.out.output_log_path)
    // step14_sander_mdrun_nvt: Equilibrating the system (NVT)
    STEP14_SANDER_MDRUN_NVT(
        STEP9_LEAP_ADD_IONS.out.output_top_path
            .join(STEP12_SANDER_MDRUN_WARM.out.output_rst_path)
            .join(STEP12_SANDER_MDRUN_WARM.out.output_rst_path)
            .map { meta, top, crd, ref -> [meta, top, crd, [], [], ref] }
    )
    // step15_process_mdout_nvt: Checking NVT Equilibration results
    STEP15_PROCESS_MDOUT_NVT(STEP14_SANDER_MDRUN_NVT.out.output_log_path)
    // step16_sander_mdrun_npt: Equilibrating the system (NPT)
    STEP16_SANDER_MDRUN_NPT(
        STEP9_LEAP_ADD_IONS.out.output_top_path
            .join(STEP14_SANDER_MDRUN_NVT.out.output_rst_path)
            .join(STEP14_SANDER_MDRUN_NVT.out.output_rst_path)
            .map { meta, top, crd, ref -> [meta, top, crd, [], [], ref] }
    )
    // step17_process_mdout_npt: Checking NPT Equilibration results
    STEP17_PROCESS_MDOUT_NPT(STEP16_SANDER_MDRUN_NPT.out.output_log_path)
    // step18_sander_mdrun_md: Creating portable binary run file to run a free MD simulation
    STEP18_SANDER_MDRUN_MD(
        STEP9_LEAP_ADD_IONS.out.output_top_path
            .join(STEP16_SANDER_MDRUN_NPT.out.output_rst_path)
            .map { meta, top, crd -> [meta, top, crd, [], [], []] }
    )
    // step19_rmsd_first: Generate RMSd (against 1st snp.) plot for the resulting setup trajectory from the free md step
    STEP19_RMSD_FIRST(
        STEP9_LEAP_ADD_IONS.out.output_top_path
            .join(STEP18_SANDER_MDRUN_MD.out.output_traj_path)
            .map { meta, top, traj -> [meta, top, traj, []] }
    )
    // step20_rmsd_exp: Generate RMSd (against exp.) plot for the resulting setup trajectory from the free md step
    STEP20_RMSD_EXP(
        STEP9_LEAP_ADD_IONS.out.output_top_path
            .join(STEP18_SANDER_MDRUN_MD.out.output_traj_path)
            .join(STEP2_LEAP_GEN_TOP.out.output_pdb_path)
    )
    // step21_cpptraj_rgyr: Generate Radius of Gyration plot for the resulting setup trajectory from the free md step
    STEP21_CPPTRAJ_RGYR(
        STEP9_LEAP_ADD_IONS.out.output_top_path
            .join(STEP18_SANDER_MDRUN_MD.out.output_traj_path)
    )
    // step22_cpptraj_image: Imaging the resulting trajectory
    STEP22_CPPTRAJ_IMAGE(
        STEP9_LEAP_ADD_IONS.out.output_top_path
            .join(STEP18_SANDER_MDRUN_MD.out.output_traj_path)
    )

    publish:
    results = channel.empty().mix(
        STEP000_REDUCE_REMOVE_HYDROGENS.out.output_path.map { meta, result -> [meta, 'step000_reduce_remove_hydrogens', result] },
        STEP00_EXTRACT_MOLECULE.out.output_molecule_path.map { meta, result -> [meta, 'step00_extract_molecule', result] },
        STEP0000_CAT_PDB.out.output_structure_path.map { meta, result -> [meta, 'step0000_cat_pdb', result] },
        STEP0_CAT_PDB.out.output_structure_path.map { meta, result -> [meta, 'step0_cat_pdb', result] },
        STEP1_PDB4AMBER_RUN.out.output_pdb_path.map { meta, result -> [meta, 'step1_pdb4amber_run', result] },
        STEP2_LEAP_GEN_TOP.out.output_pdb_path.mix(STEP2_LEAP_GEN_TOP.out.output_top_path, STEP2_LEAP_GEN_TOP.out.output_crd_path).map { meta, result -> [meta, 'step2_leap_gen_top', result] },
        STEP3_SANDER_MDRUN_MINH.out.output_log_path.mix(STEP3_SANDER_MDRUN_MINH.out.output_traj_path, STEP3_SANDER_MDRUN_MINH.out.output_rst_path).map { meta, result -> [meta, 'step3_sander_mdrun_minH', result] },
        STEP4_PROCESS_MINOUT_MINH.out.output_dat_path.map { meta, result -> [meta, 'step4_process_minout_minH', result] },
        STEP5_SANDER_MDRUN_MIN.out.output_log_path.mix(STEP5_SANDER_MDRUN_MIN.out.output_traj_path, STEP5_SANDER_MDRUN_MIN.out.output_rst_path).map { meta, result -> [meta, 'step5_sander_mdrun_min', result] },
        STEP6_PROCESS_MINOUT_MIN.out.output_dat_path.map { meta, result -> [meta, 'step6_process_minout_min', result] },
        STEP7_AMBER_TO_PDB.out.output_pdb_path.map { meta, result -> [meta, 'step7_amber_to_pdb', result] },
        STEP8_LEAP_SOLVATE.out.output_pdb_path.mix(STEP8_LEAP_SOLVATE.out.output_top_path, STEP8_LEAP_SOLVATE.out.output_crd_path).map { meta, result -> [meta, 'step8_leap_solvate', result] },
        STEP9_LEAP_ADD_IONS.out.output_pdb_path.mix(STEP9_LEAP_ADD_IONS.out.output_top_path, STEP9_LEAP_ADD_IONS.out.output_crd_path).map { meta, result -> [meta, 'step9_leap_add_ions', result] },
        STEP10_SANDER_MDRUN_ENERGY.out.output_log_path.mix(STEP10_SANDER_MDRUN_ENERGY.out.output_traj_path, STEP10_SANDER_MDRUN_ENERGY.out.output_rst_path).map { meta, result -> [meta, 'step10_sander_mdrun_energy', result] },
        STEP11_PROCESS_MINOUT_ENERGY.out.output_dat_path.map { meta, result -> [meta, 'step11_process_minout_energy', result] },
        STEP12_SANDER_MDRUN_WARM.out.output_log_path.mix(STEP12_SANDER_MDRUN_WARM.out.output_traj_path, STEP12_SANDER_MDRUN_WARM.out.output_rst_path).map { meta, result -> [meta, 'step12_sander_mdrun_warm', result] },
        STEP13_PROCESS_MDOUT_WARM.out.output_dat_path.map { meta, result -> [meta, 'step13_process_mdout_warm', result] },
        STEP14_SANDER_MDRUN_NVT.out.output_log_path.mix(STEP14_SANDER_MDRUN_NVT.out.output_traj_path, STEP14_SANDER_MDRUN_NVT.out.output_rst_path).map { meta, result -> [meta, 'step14_sander_mdrun_nvt', result] },
        STEP15_PROCESS_MDOUT_NVT.out.output_dat_path.map { meta, result -> [meta, 'step15_process_mdout_nvt', result] },
        STEP16_SANDER_MDRUN_NPT.out.output_log_path.mix(STEP16_SANDER_MDRUN_NPT.out.output_traj_path, STEP16_SANDER_MDRUN_NPT.out.output_rst_path).map { meta, result -> [meta, 'step16_sander_mdrun_npt', result] },
        STEP17_PROCESS_MDOUT_NPT.out.output_dat_path.map { meta, result -> [meta, 'step17_process_mdout_npt', result] },
        STEP18_SANDER_MDRUN_MD.out.output_log_path.mix(STEP18_SANDER_MDRUN_MD.out.output_traj_path, STEP18_SANDER_MDRUN_MD.out.output_rst_path).map { meta, result -> [meta, 'step18_sander_mdrun_md', result] },
        STEP19_RMSD_FIRST.out.output_cpptraj_path.map { meta, result -> [meta, 'step19_rmsd_first', result] },
        STEP20_RMSD_EXP.out.output_cpptraj_path.map { meta, result -> [meta, 'step20_rmsd_exp', result] },
        STEP21_CPPTRAJ_RGYR.out.output_cpptraj_path.map { meta, result -> [meta, 'step21_cpptraj_rgyr', result] },
        STEP22_CPPTRAJ_IMAGE.out.output_cpptraj_path.map { meta, result -> [meta, 'step22_cpptraj_image', result] }
    )
}

output {
    // results/<id>/<step>/<id>_<step>_<role>.<ext>
    results {
        path { meta, step, _result -> "${meta.id}/${step}" }
    }
}

// Path of a samplesheet column: absolute, or relative to the samplesheet folder
def samplePath(String value) {
    file(file(params.input).parent.resolve(value).toString(), checkIfExists: true)
}
