/*
 * Generated by utils_biobb nextflow_wf_generator.py from the python workflow: do not edit by hand.
 * Protein Ligand Complex MD Setup tutorial using BioExcel Building Blocks (biobb)
 * Nextflow version of biobb_wf_protein-complex_md_setup/python/workflow.py, with the BioBB Nextflow modules in modules/.
 * Usage: nextflow run main.nf -profile docker [--input samplesheet.csv] [--run_md <value>]
 */

include { BIOBB_CHEMISTRY_REDUCE_REMOVE_HYDROGENS as STEP0_REDUCE_REMOVE_HYDROGENS } from './modules/bioexcel/biobb_chemistry/reduce_remove_hydrogens'
include { BIOBB_STRUCTURE_UTILS_EXTRACT_MOLECULE as STEP2_EXTRACT_MOLECULE } from './modules/bioexcel/biobb_structure_utils/extract_molecule'
include { BIOBB_STRUCTURE_UTILS_CAT_PDB as STEP00_CAT_PDB } from './modules/bioexcel/biobb_structure_utils/cat_pdb'
include { BIOBB_MODEL_FIX_SIDE_CHAIN as STEP4_FIX_SIDE_CHAIN } from './modules/bioexcel/biobb_model/fix_side_chain'
include { BIOBB_GROMACS_PDB2GMX as STEP5_PDB2GMX } from './modules/bioexcel/biobb_gromacs/pdb2gmx'
include { BIOBB_GROMACS_MAKE_NDX as STEP9_MAKE_NDX } from './modules/bioexcel/biobb_gromacs/make_ndx'
include { BIOBB_GROMACS_GENRESTR as STEP10_GENRESTR } from './modules/bioexcel/biobb_gromacs/genrestr'
include { BIOBB_ANALYSIS_GMX_TRJCONV_STR as STEP11_GMX_TRJCONV_STR_PROTEIN } from './modules/bioexcel/biobb_analysis/gmx_trjconv_str'
include { BIOBB_ANALYSIS_GMX_TRJCONV_STR as STEP12_GMX_TRJCONV_STR_LIGAND } from './modules/bioexcel/biobb_analysis/gmx_trjconv_str'
include { BIOBB_STRUCTURE_UTILS_CAT_PDB as STEP13_CAT_PDB_HYDROGENS } from './modules/bioexcel/biobb_structure_utils/cat_pdb'
include { BIOBB_GROMACS_APPEND_LIGAND as STEP14_APPEND_LIGAND } from './modules/bioexcel/biobb_gromacs/append_ligand'
include { BIOBB_GROMACS_EDITCONF as STEP15_EDITCONF } from './modules/bioexcel/biobb_gromacs/editconf'
include { BIOBB_GROMACS_SOLVATE as STEP16_SOLVATE } from './modules/bioexcel/biobb_gromacs/solvate'
include { BIOBB_GROMACS_GROMPP as STEP17_GROMPP_GENION } from './modules/bioexcel/biobb_gromacs/grompp'
include { BIOBB_GROMACS_GENION as STEP18_GENION } from './modules/bioexcel/biobb_gromacs/genion'
include { BIOBB_GROMACS_GROMPP as STEP19_GROMPP_MIN } from './modules/bioexcel/biobb_gromacs/grompp'
include { BIOBB_GROMACS_MDRUN as STEP20_MDRUN_MIN } from './modules/bioexcel/biobb_gromacs/mdrun'
include { BIOBB_ANALYSIS_GMX_ENERGY as STEP21_GMX_ENERGY_MIN } from './modules/bioexcel/biobb_analysis/gmx_energy'
include { BIOBB_GROMACS_MAKE_NDX as STEP22_MAKE_NDX } from './modules/bioexcel/biobb_gromacs/make_ndx'
include { BIOBB_GROMACS_GROMPP as STEP23_GROMPP_NVT } from './modules/bioexcel/biobb_gromacs/grompp'
include { BIOBB_GROMACS_MDRUN as STEP24_MDRUN_NVT } from './modules/bioexcel/biobb_gromacs/mdrun'
include { BIOBB_ANALYSIS_GMX_ENERGY as STEP25_GMX_ENERGY_NVT } from './modules/bioexcel/biobb_analysis/gmx_energy'
include { BIOBB_GROMACS_GROMPP as STEP26_GROMPP_NPT } from './modules/bioexcel/biobb_gromacs/grompp'
include { BIOBB_GROMACS_MDRUN as STEP27_MDRUN_NPT } from './modules/bioexcel/biobb_gromacs/mdrun'
include { BIOBB_ANALYSIS_GMX_ENERGY as STEP28_GMX_ENERGY_NPT } from './modules/bioexcel/biobb_analysis/gmx_energy'
include { BIOBB_GROMACS_GROMPP as STEP29_GROMPP_MD } from './modules/bioexcel/biobb_gromacs/grompp'
include { BIOBB_GROMACS_MDRUN as STEP30_MDRUN_MD } from './modules/bioexcel/biobb_gromacs/mdrun'
include { BIOBB_ANALYSIS_GMX_IMAGE as STEP34_GMX_IMAGE } from './modules/bioexcel/biobb_analysis/gmx_image'
include { BIOBB_ANALYSIS_GMX_IMAGE as STEP34B_GMX_IMAGE2 } from './modules/bioexcel/biobb_analysis/gmx_image'
include { BIOBB_ANALYSIS_GMX_TRJCONV_STR as STEP35_GMX_TRJCONV_STR } from './modules/bioexcel/biobb_analysis/gmx_trjconv_str'
include { BIOBB_ANALYSIS_GMX_RMS as STEP31_RMSD_FIRST } from './modules/bioexcel/biobb_analysis/gmx_rms'
include { BIOBB_ANALYSIS_GMX_RMS as STEP32_RMSD_EXP } from './modules/bioexcel/biobb_analysis/gmx_rms'
include { BIOBB_ANALYSIS_GMX_RGYR as STEP33_GMX_RGYR } from './modules/bioexcel/biobb_analysis/gmx_rgyr'
include { BIOBB_GROMACS_GROMPP as STEP36_GROMPP_MD } from './modules/bioexcel/biobb_gromacs/grompp'

params {
    // CSV with an id column and one column per input file: one workflow run per row
    input: String = "${projectDir}/samplesheet.csv"
    run_md: Boolean = false
}

workflow {
    main:
    // One [meta, files] item per samplesheet row: the steps of every row run in parallel
    ch_samples = channel.fromPath(params.input)
        .splitCsv(header: true)
        .map { row -> [[id: row.id], [structure: samplePath(row.structure), ions: samplePath(row.ions), ligand_gro: samplePath(row.ligand_gro), ligand_itp: samplePath(row.ligand_itp)]] }

    // step0_reduce_remove_hydrogens: Removing Hydrogens
    STEP0_REDUCE_REMOVE_HYDROGENS(ch_samples.map { meta, files -> [meta, files.structure] })
    // step2_extract_molecule: Extracting Protein
    STEP2_EXTRACT_MOLECULE(STEP0_REDUCE_REMOVE_HYDROGENS.out.output_path)
    // step00_cat_pdb: Concatenating protein with included ions
    STEP00_CAT_PDB(
        STEP2_EXTRACT_MOLECULE.out.output_molecule_path
            .join(ch_samples.map { meta, files -> [meta, files.ions] })
    )
    // step4_fix_side_chain: Fix protein structure
    STEP4_FIX_SIDE_CHAIN(STEP00_CAT_PDB.out.output_structure_path)
    // step5_pdb2gmx: Create protein system topology
    STEP5_PDB2GMX(STEP4_FIX_SIDE_CHAIN.out.output_pdb_path)
    // step9_make_ndx: Creating an index file for the small molecule heavy atoms
    STEP9_MAKE_NDX(
        ch_samples.map { meta, files -> [meta, files.ligand_gro] }
            .map { meta, structure -> [meta, structure, []] }
    )
    // step10_genrestr: Generating the position restraints file
    STEP10_GENRESTR(
        ch_samples.map { meta, files -> [meta, files.ligand_gro] }
            .join(STEP9_MAKE_NDX.out.output_ndx_path)
    )
    // step11_gmx_trjconv_str_protein: Convert gro (with hydrogens) to pdb (protein)
    STEP11_GMX_TRJCONV_STR_PROTEIN(
        STEP5_PDB2GMX.out.output_gro_path
            .join(STEP5_PDB2GMX.out.output_gro_path)
            .map { meta, structure, top -> [meta, structure, top, []] }
    )
    // step12_gmx_trjconv_str_ligand: Convert gro (with hydrogens) to pdb (ligand)
    STEP12_GMX_TRJCONV_STR_LIGAND(
        ch_samples.map { meta, files -> [meta, files.ligand_gro] }
            .join(ch_samples.map { meta, files -> [meta, files.ligand_gro] })
            .map { meta, structure, top -> [meta, structure, top, []] }
    )
    // step13_cat_pdb_hydrogens: Create new protein-ligand complex structure file
    STEP13_CAT_PDB_HYDROGENS(
        STEP11_GMX_TRJCONV_STR_PROTEIN.out.output_str_path
            .join(STEP12_GMX_TRJCONV_STR_LIGAND.out.output_str_path)
    )
    // step14_append_ligand: Create new protein-ligand complex topology file
    STEP14_APPEND_LIGAND(
        STEP5_PDB2GMX.out.output_top_zip_path
            .join(ch_samples.map { meta, files -> [meta, files.ligand_itp] })
            .join(STEP10_GENRESTR.out.output_itp_path)
    )
    // step15_editconf: Create solvent box
    STEP15_EDITCONF(STEP13_CAT_PDB_HYDROGENS.out.output_structure_path)
    // step16_solvate: Fill the box with water molecules
    STEP16_SOLVATE(
        STEP15_EDITCONF.out.output_gro_path
            .join(STEP14_APPEND_LIGAND.out.output_top_zip_path)
            .map { meta, solute_gro, top_zip -> [meta, solute_gro, top_zip, []] }
    )
    // step17_grompp_genion: Creating portable binary run file for ion generation
    STEP17_GROMPP_GENION(
        STEP16_SOLVATE.out.output_gro_path
            .join(STEP16_SOLVATE.out.output_top_zip_path)
            .map { meta, gro, top_zip -> [meta, gro, top_zip, [], [], []] }
    )
    // step18_genion: Adding ions to neutralize the system and reach a 0.05 molar concentration
    STEP18_GENION(
        STEP17_GROMPP_GENION.out.output_tpr_path
            .join(STEP16_SOLVATE.out.output_top_zip_path)
            .map { meta, tpr, top_zip -> [meta, tpr, top_zip, []] }
    )
    // step19_grompp_min: Creating portable binary run file for energy minimization
    STEP19_GROMPP_MIN(
        STEP18_GENION.out.output_gro_path
            .join(STEP18_GENION.out.output_top_zip_path)
            .map { meta, gro, top_zip -> [meta, gro, top_zip, [], [], []] }
    )
    // step20_mdrun_min: Running Energy Minimization
    STEP20_MDRUN_MIN(
        STEP19_GROMPP_MIN.out.output_tpr_path
            .map { meta, tpr -> [meta, tpr, []] }
    )
    // step21_gmx_energy_min: Checking Energy Minimization results
    STEP21_GMX_ENERGY_MIN(STEP20_MDRUN_MIN.out.output_edr_path)
    // step22_make_ndx: Creating an index file with a new group including the protein-ligand complex
    STEP22_MAKE_NDX(
        STEP20_MDRUN_MIN.out.output_gro_path
            .map { meta, structure -> [meta, structure, []] }
    )
    // step23_grompp_nvt: Creating portable binary run file for system equilibration (NVT)
    STEP23_GROMPP_NVT(
        STEP20_MDRUN_MIN.out.output_gro_path
            .join(STEP18_GENION.out.output_top_zip_path)
            .join(STEP22_MAKE_NDX.out.output_ndx_path)
            .map { meta, gro, top_zip, ndx -> [meta, gro, top_zip, [], ndx, []] }
    )
    // step24_mdrun_nvt: Running NVT equilibration
    STEP24_MDRUN_NVT(
        STEP23_GROMPP_NVT.out.output_tpr_path
            .map { meta, tpr -> [meta, tpr, []] }
    )
    // step25_gmx_energy_nvt: Checking NVT Equilibration results
    STEP25_GMX_ENERGY_NVT(STEP24_MDRUN_NVT.out.output_edr_path)
    // step26_grompp_npt: Creating portable binary run file for system equilibration (NPT)
    STEP26_GROMPP_NPT(
        STEP24_MDRUN_NVT.out.output_gro_path
            .join(STEP18_GENION.out.output_top_zip_path)
            .join(STEP24_MDRUN_NVT.out.output_cpt_path)
            .join(STEP22_MAKE_NDX.out.output_ndx_path)
            .map { meta, gro, top_zip, cpt, ndx -> [meta, gro, top_zip, cpt, ndx, []] }
    )
    // step27_mdrun_npt: Running NPT equilibration
    STEP27_MDRUN_NPT(
        STEP26_GROMPP_NPT.out.output_tpr_path
            .map { meta, tpr -> [meta, tpr, []] }
    )
    // step28_gmx_energy_npt: Checking NPT Equilibration results
    STEP28_GMX_ENERGY_NPT(STEP27_MDRUN_NPT.out.output_edr_path)
    // step29_grompp_md: Creating portable binary run file to run a free MD simulation
    STEP29_GROMPP_MD(
        STEP27_MDRUN_NPT.out.output_gro_path
            .join(STEP18_GENION.out.output_top_zip_path)
            .join(STEP27_MDRUN_NPT.out.output_cpt_path)
            .join(STEP22_MAKE_NDX.out.output_ndx_path)
            .map { meta, gro, top_zip, cpt, ndx -> [meta, gro, top_zip, cpt, ndx, []] }
    )
    // step30_mdrun_md: Running short free MD simulation
    STEP30_MDRUN_MD(
        STEP29_GROMPP_MD.out.output_tpr_path
            .map { meta, tpr -> [meta, tpr, []] }
    )
    // step34_gmx_image: Image Trajectory, step1, moving ligand to center of the water box
    STEP34_GMX_IMAGE(
        STEP30_MDRUN_MD.out.output_trr_path
            .join(STEP19_GROMPP_MIN.out.output_tpr_path)
            .join(STEP22_MAKE_NDX.out.output_ndx_path)
    )
    // step34b_gmx_image2: Image Trajectory, step2, removing rotation
    STEP34B_GMX_IMAGE2(
        STEP34_GMX_IMAGE.out.output_traj_path
            .join(STEP19_GROMPP_MIN.out.output_tpr_path)
            .join(STEP22_MAKE_NDX.out.output_ndx_path)
    )
    // step35_gmx_trjconv_str: Generating the output dry structure
    STEP35_GMX_TRJCONV_STR(
        STEP30_MDRUN_MD.out.output_gro_path
            .join(STEP19_GROMPP_MIN.out.output_tpr_path)
            .join(STEP22_MAKE_NDX.out.output_ndx_path)
    )
    // step31_rmsd_first: Generate RMSd (against 1st snp.) plot for the resulting setup trajectory from the free md step
    STEP31_RMSD_FIRST(
        STEP29_GROMPP_MD.out.output_tpr_path
            .join(STEP34B_GMX_IMAGE2.out.output_traj_path)
            .join(STEP22_MAKE_NDX.out.output_ndx_path)
    )
    // step32_rmsd_exp: Generate RMSd (against exp.) plot for the resulting setup trajectory from the free md step
    STEP32_RMSD_EXP(
        STEP19_GROMPP_MIN.out.output_tpr_path
            .join(STEP34B_GMX_IMAGE2.out.output_traj_path)
            .join(STEP22_MAKE_NDX.out.output_ndx_path)
    )
    // step33_gmx_rgyr: Generate Radius of Gyration plot for the resulting setup trajectory from the free md step
    STEP33_GMX_RGYR(
        STEP29_GROMPP_MD.out.output_tpr_path
            .join(STEP34B_GMX_IMAGE2.out.output_traj_path)
            .join(STEP22_MAKE_NDX.out.output_ndx_path)
    )
    // step36_grompp_md: Preprocess long MD simulation after setup
    STEP36_GROMPP_MD(
        STEP30_MDRUN_MD.out.output_gro_path
            .join(STEP18_GENION.out.output_top_zip_path)
            .join(STEP30_MDRUN_MD.out.output_cpt_path)
            .map { meta, gro, top_zip, cpt -> [meta, gro, top_zip, cpt, [], []] }
            .filter { params.run_md }
    )

    publish:
    results = channel.empty().mix(
        STEP0_REDUCE_REMOVE_HYDROGENS.out.output_path.map { meta, result -> [meta, 'step0_reduce_remove_hydrogens', result] },
        STEP2_EXTRACT_MOLECULE.out.output_molecule_path.map { meta, result -> [meta, 'step2_extract_molecule', result] },
        STEP00_CAT_PDB.out.output_structure_path.map { meta, result -> [meta, 'step00_cat_pdb', result] },
        STEP4_FIX_SIDE_CHAIN.out.output_pdb_path.map { meta, result -> [meta, 'step4_fix_side_chain', result] },
        STEP5_PDB2GMX.out.output_gro_path.mix(STEP5_PDB2GMX.out.output_top_zip_path).map { meta, result -> [meta, 'step5_pdb2gmx', result] },
        STEP9_MAKE_NDX.out.output_ndx_path.map { meta, result -> [meta, 'step9_make_ndx', result] },
        STEP10_GENRESTR.out.output_itp_path.map { meta, result -> [meta, 'step10_genrestr', result] },
        STEP11_GMX_TRJCONV_STR_PROTEIN.out.output_str_path.map { meta, result -> [meta, 'step11_gmx_trjconv_str_protein', result] },
        STEP12_GMX_TRJCONV_STR_LIGAND.out.output_str_path.map { meta, result -> [meta, 'step12_gmx_trjconv_str_ligand', result] },
        STEP13_CAT_PDB_HYDROGENS.out.output_structure_path.map { meta, result -> [meta, 'step13_cat_pdb_hydrogens', result] },
        STEP14_APPEND_LIGAND.out.output_top_zip_path.map { meta, result -> [meta, 'step14_append_ligand', result] },
        STEP15_EDITCONF.out.output_gro_path.map { meta, result -> [meta, 'step15_editconf', result] },
        STEP16_SOLVATE.out.output_gro_path.mix(STEP16_SOLVATE.out.output_top_zip_path).map { meta, result -> [meta, 'step16_solvate', result] },
        STEP17_GROMPP_GENION.out.output_tpr_path.map { meta, result -> [meta, 'step17_grompp_genion', result] },
        STEP18_GENION.out.output_gro_path.mix(STEP18_GENION.out.output_top_zip_path).map { meta, result -> [meta, 'step18_genion', result] },
        STEP19_GROMPP_MIN.out.output_tpr_path.map { meta, result -> [meta, 'step19_grompp_min', result] },
        STEP20_MDRUN_MIN.out.output_gro_path.mix(STEP20_MDRUN_MIN.out.output_edr_path, STEP20_MDRUN_MIN.out.output_log_path, STEP20_MDRUN_MIN.out.output_trr_path).map { meta, result -> [meta, 'step20_mdrun_min', result] },
        STEP21_GMX_ENERGY_MIN.out.output_xvg_path.map { meta, result -> [meta, 'step21_gmx_energy_min', result] },
        STEP22_MAKE_NDX.out.output_ndx_path.map { meta, result -> [meta, 'step22_make_ndx', result] },
        STEP23_GROMPP_NVT.out.output_tpr_path.map { meta, result -> [meta, 'step23_grompp_nvt', result] },
        STEP24_MDRUN_NVT.out.output_gro_path.mix(STEP24_MDRUN_NVT.out.output_edr_path, STEP24_MDRUN_NVT.out.output_log_path, STEP24_MDRUN_NVT.out.output_trr_path, STEP24_MDRUN_NVT.out.output_cpt_path).map { meta, result -> [meta, 'step24_mdrun_nvt', result] },
        STEP25_GMX_ENERGY_NVT.out.output_xvg_path.map { meta, result -> [meta, 'step25_gmx_energy_nvt', result] },
        STEP26_GROMPP_NPT.out.output_tpr_path.map { meta, result -> [meta, 'step26_grompp_npt', result] },
        STEP27_MDRUN_NPT.out.output_gro_path.mix(STEP27_MDRUN_NPT.out.output_edr_path, STEP27_MDRUN_NPT.out.output_log_path, STEP27_MDRUN_NPT.out.output_trr_path, STEP27_MDRUN_NPT.out.output_cpt_path).map { meta, result -> [meta, 'step27_mdrun_npt', result] },
        STEP28_GMX_ENERGY_NPT.out.output_xvg_path.map { meta, result -> [meta, 'step28_gmx_energy_npt', result] },
        STEP29_GROMPP_MD.out.output_tpr_path.map { meta, result -> [meta, 'step29_grompp_md', result] },
        STEP30_MDRUN_MD.out.output_gro_path.mix(STEP30_MDRUN_MD.out.output_edr_path, STEP30_MDRUN_MD.out.output_log_path, STEP30_MDRUN_MD.out.output_trr_path, STEP30_MDRUN_MD.out.output_cpt_path).map { meta, result -> [meta, 'step30_mdrun_md', result] },
        STEP34_GMX_IMAGE.out.output_traj_path.map { meta, result -> [meta, 'step34_gmx_image', result] },
        STEP34B_GMX_IMAGE2.out.output_traj_path.map { meta, result -> [meta, 'step34b_gmx_image2', result] },
        STEP35_GMX_TRJCONV_STR.out.output_str_path.map { meta, result -> [meta, 'step35_gmx_trjconv_str', result] },
        STEP31_RMSD_FIRST.out.output_xvg_path.map { meta, result -> [meta, 'step31_rmsd_first', result] },
        STEP32_RMSD_EXP.out.output_xvg_path.map { meta, result -> [meta, 'step32_rmsd_exp', result] },
        STEP33_GMX_RGYR.out.output_xvg_path.map { meta, result -> [meta, 'step33_gmx_rgyr', result] },
        STEP36_GROMPP_MD.out.output_tpr_path.map { meta, result -> [meta, 'step36_grompp_md', result] }
    )
}

output {
    // results/<id>/<step>/<id>_<step>_<role>.<ext>
    results {
        path { meta, step, _result -> "${meta.id}/${step}" }
    }
}

// Path of a samplesheet column: absolute, or relative to the samplesheet folder
def samplePath(String value) {
    file(file(params.input).parent.resolve(value).toString(), checkIfExists: true)
}
