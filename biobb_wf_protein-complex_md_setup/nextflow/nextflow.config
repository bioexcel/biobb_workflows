/*
 * Generated by utils_biobb nextflow_wf_generator.py from the python workflow: do not edit by hand.
 * Configuration of biobb_wf_protein-complex_md_setup: biobb properties (ext.properties) and output extensions (ext.outputs) of every step,
 * from python/workflow.yml.
 */

manifest {
    name = 'biobb_wf_protein-complex_md_setup'
    description = 'Protein Ligand Complex MD Setup tutorial using BioExcel Building Blocks (biobb)'
    homePage = 'https://github.com/bioexcel/biobb_workflows'
    mainScript = 'main.nf'
    nextflowVersion = '!>=25.10.0'
    license = 'Apache-2.0'
}

outputDir = 'results'
workflow.output.mode = 'copy'

process {
    // Output files named <id>_<step>_<role>.<ext>
    ext.prefix = { "${meta.id}_${task.process.tokenize(':')[-1].toLowerCase()}" }

    // Multithreaded blocks (num_threads = cpus): set cpus to the cores of your machine or node
    withLabel: 'process_medium' {
        cpus = 4
    }

    withName: 'STEP5_PDB2GMX' {
        ext.properties = [force_field: 'amber99sb', water_type: 'tip3p']
    }

    withName: 'STEP9_MAKE_NDX' {
        ext.properties = [selection: '0 & ! a H*']
    }

    withName: 'STEP10_GENRESTR' {
        ext.properties = [force_constants: '1000 1000 1000', restrained_group: 'System']
    }

    withName: 'STEP11_GMX_TRJCONV_STR_PROTEIN' {
        ext.properties = [selection: 'System']
    }

    withName: 'STEP12_GMX_TRJCONV_STR_LIGAND' {
        ext.properties = [selection: 'System']
    }

    withName: 'STEP14_APPEND_LIGAND' {
        ext.properties = [posres_name: 'POSRES_LIGAND']
    }

    withName: 'STEP15_EDITCONF' {
        ext.properties = [distance_to_molecule: 0.8, box_type: 'octahedron']
    }

    withName: 'STEP17_GROMPP_GENION' {
        ext.properties = [simulation_type: 'minimization', maxwarn: 1, mdp: [nsteps: 5000]]
    }

    withName: 'STEP18_GENION' {
        ext.properties = [neutral: true, concentration: 0.05]
    }

    withName: 'STEP19_GROMPP_MIN' {
        ext.properties = [mdp: [nsteps: 5000, emtol: 500, emstep: 0.01], simulation_type: 'minimization']
    }

    withName: 'STEP20_MDRUN_MIN' {
        ext.outputs = [output_trr_path: 'trr']
    }

    withName: 'STEP21_GMX_ENERGY_MIN' {
        ext.properties = [terms: ['Potential']]
    }

    withName: 'STEP22_MAKE_NDX' {
        ext.properties = [selection: '"Protein"|"Other"']
    }

    withName: 'STEP23_GROMPP_NVT' {
        ext.properties = [mdp: [nsteps: 50000, 'tc-grps': 'Protein_Other Water_and_ions', Define: '-DPOSRES -DPOSRES_LIGAND'], simulation_type: 'nvt']
    }

    withName: 'STEP24_MDRUN_NVT' {
        ext.outputs = [output_trr_path: 'trr', output_cpt_path: 'cpt']
    }

    withName: 'STEP25_GMX_ENERGY_NVT' {
        ext.properties = [terms: ['Temperature']]
    }

    withName: 'STEP26_GROMPP_NPT' {
        ext.properties = [mdp: [nsteps: 50000, type: 'npt', 'tc-grps': 'Protein_Other Water_and_ions', Define: '-DPOSRES -DPOSRES_LIGAND'], simulation_type: 'npt']
    }

    withName: 'STEP27_MDRUN_NPT' {
        ext.outputs = [output_trr_path: 'trr', output_cpt_path: 'cpt']
    }

    withName: 'STEP28_GMX_ENERGY_NPT' {
        ext.properties = [terms: ['Pressure', 'Density']]
    }

    withName: 'STEP29_GROMPP_MD' {
        ext.properties = [mdp: [nsteps: 250000, 'tc-grps': 'Protein_Other Water_and_ions'], simulation_type: 'free']
    }

    withName: 'STEP30_MDRUN_MD' {
        ext.outputs = [output_trr_path: 'trr', output_cpt_path: 'cpt']
    }

    withName: 'STEP34_GMX_IMAGE' {
        ext.properties = [center_selection: 'Protein_Other', output_selection: 'System', pbc: 'mol', center: true]
        ext.outputs = [output_traj_path: 'trr']
    }

    withName: 'STEP34B_GMX_IMAGE2' {
        ext.properties = [fit_selection: 'Protein_Other', output_selection: 'System', fit: 'rot+trans']
    }

    withName: 'STEP35_GMX_TRJCONV_STR' {
        ext.properties = [pbc: 'mol', selection: 'System']
        ext.outputs = [output_str_path: 'gro']
    }

    withName: 'STEP31_RMSD_FIRST' {
        ext.properties = [selection: 'Protein_Other']
    }

    withName: 'STEP32_RMSD_EXP' {
        ext.properties = [selection: 'Protein_Other']
    }

    withName: 'STEP33_GMX_RGYR' {
        ext.properties = [selection: 'Protein_Other']
    }

    withName: 'STEP36_GROMPP_MD' {
        ext.properties = [mdp: [nsteps: 5000000, dt: 0.002, 'ref-t': '300 300', nstxout: 100000, 'nstxout-compressed': 500], simulation_type: 'free']
    }
}

profiles {
    docker {
        docker.enabled = true
        // Run as the host user, so the results are not owned by root
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    apptainer {
        apptainer.enabled = true
    }
    singularity {
        singularity.enabled = true
    }
    conda {
        conda.enabled = true
        conda.channels = ['conda-forge', 'bioconda']
    }
}
