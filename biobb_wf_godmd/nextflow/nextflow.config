/*
 * Configuration of biobb_wf_godmd: biobb properties (ext.properties) and output extensions (ext.outputs) of every step,
 * from python/workflow.yml.
 */

manifest {
    name = 'biobb_wf_godmd'
    description = 'Protein conformational transitions calculations tutorial using BioExcel Building Blocks (biobb) and GOdMD'
    homePage = 'https://github.com/bioexcel/biobb_workflows'
    mainScript = 'main.nf'
    nextflowVersion = '!>=25.10.0'
    license = 'Apache-2.0'
}

outputDir = 'results'
workflow.output.mode = 'copy'

process {
    // Output files named <id>_<step>_<role>.<ext>
    ext.prefix = { "${meta.id}_${task.process.tokenize(':')[-1].toLowerCase()}" }

    withName: 'STEP0_EXTRACT_CHAIN' {
        ext.properties = [chains: ['A']]
    }

    withName: 'STEP1_EXTRACT_CHAIN' {
        ext.properties = [chains: ['A']]
    }

    // molecules: --step2_molecules / --step3_molecules params (main.nf), which also decide if the step runs
    withName: 'STEP2_REMOVE_MOLECULES' {
        ext.properties = { [molecules: params.step2_molecules] }
    }

    withName: 'STEP3_REMOVE_MOLECULES' {
        ext.properties = { [molecules: params.step3_molecules] }
    }

    withName: 'STEP4_GODMD_PREP' {
        ext.properties = [gapopen: '12.0', gapextend: '2']
    }

    withName: 'STEP5_GODMD_RUN' {
        ext.properties = [godmdin: [temp: 400]]
        ext.outputs = [output_ene_path: 'out', output_trj_path: 'mdcrd']
    }

    withName: 'STEP6_CPPTRAJ_CONVERT' {
        ext.properties = [format: 'dcd']
        ext.outputs = [output_cpptraj_path: 'dcd']
    }
}

profiles {
    docker {
        docker.enabled = true
        // Run as the host user, so the results are not owned by root
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    apptainer {
        apptainer.enabled = true
    }
    singularity {
        singularity.enabled = true
    }
    conda {
        conda.enabled = true
        conda.channels = ['conda-forge', 'bioconda']
    }
}
