/*
 * Generated by utils_biobb nextflow_wf_generator.py from the python workflow: do not edit by hand.
 * Configuration of biobb_wf_autoencoder: biobb properties (ext.properties) and output extensions (ext.outputs) of every step,
 * from python/workflow.yml.
 */

manifest {
    name = 'biobb_wf_autoencoder'
    description = 'AutoEncoders for Anomaly Detection tutorial using BioExcel Building Blocks (biobb)'
    homePage = 'https://github.com/bioexcel/biobb_workflows'
    mainScript = 'main.nf'
    nextflowVersion = '!>=25.10.0'
    license = 'Apache-2.0'
}

outputDir = 'results'
workflow.output.mode = 'copy'

process {
    // Output files named <id>_<step>_<role>.<ext>
    ext.prefix = { "${meta.id}_${task.process.tokenize(':')[-1].toLowerCase()}" }

    withName: 'STEP1_GMX_IMAGE1' {
        ext.properties = [fit_selection: 'Backbone', output_selection: 'System', center: false, fit: 'rot+trans']
    }

    withName: 'STEP2_MDFEATURIZER1' {
        ext.properties = [cartesian: [selection: 'name CA'], disable_sandbox: true, disable_logs: true]
    }

    withName: 'STEP3_BUILD_MODEL' {
        ext.properties = [model_type: 'AutoEncoder', n_cvs: 3, encoder_layers: [933, 747, 561, 375, 189], decoder_layers: [189, 375, 561, 747, 933], options: [norm_in: [mode: 'min_max'], encoder: [activation: 'relu', batchnorm: true, dropout: 0.0, last_layer_activation: false], decoder: [activation: 'relu', batchnorm: true, dropout: 0.0, last_layer_activation: 'sigmoid'], optimizer: [lr: 1e-05]]]
        ext.outputs = [output_model_pth_path: 'pth']
    }

    withName: 'STEP4_TRAIN_MODEL' {
        ext.properties = [Dataset: [batch_size: 128, shuffle: true, split: [random_split: true, train_prop: 0.9, val_prop: 0.1]], Trainer: [max_epochs: 100, enable_checkpointing: false, callbacks: [:]]]
        ext.outputs = [output_model_pth_path: 'pth', output_metrics_npz_path: 'npz']
    }

    withName: 'STEP5_GMX_IMAGE2' {
        ext.properties = [fit_selection: 'Backbone', output_selection: 'System', center: false, fit: 'rot+trans']
    }

    withName: 'STEP6_MDFEATURIZER2' {
        ext.properties = [cartesian: [selection: 'name CA'], disable_sandbox: true]
    }

    withName: 'STEP7_EVALUATE_MODEL' {
        ext.properties = [Dataset: [batch_size: 64]]
    }

    withName: 'STEP8_MAKE_NDX1' {
        ext.properties = [selection: 'a CA']
    }

    withName: 'STEP9_MAKE_NDX2' {
        ext.properties = [selection: 'a CA']
    }

    withName: 'STEP10_GMX_RMSF1' {
        ext.properties = [xvg: 'xmgr', selection: 'Protein']
    }

    withName: 'STEP11_GMX_RMSF2' {
        ext.properties = [xvg: 'xmgr', selection: 'Protein']
    }

    withName: 'STEP12_FEAT2TRAJ' {
        ext.outputs = [output_top_path: 'pdb']
    }

    withName: 'STEP13_GMX_RMSF3' {
        ext.properties = [xvg: 'xmgr', selection: 'Protein']
    }

    withName: 'STEP14_MAKE_PLUMED' {
        ext.properties = [additional_actions: [[name: 'ENERGY', label: 'ene']], fit_to_template: [STRIDE: 1, TYPE: 'OPTIMAL'], group: [label: 'backbone', selection: 'backbone'], bias: [[name: 'METAD', label: 'bias', params: [ARG: 'cv.*', PACE: 500, HEIGHT: 1.2, SIGMA: 0.35, FILE: 'HILLS', BIASFACTOR: 8]]], prints: [ARG: 'cv.*,bias.*', STRIDE: 1, FILE: 'COLVAR']]
    }
}

profiles {
    docker {
        docker.enabled = true
        // Run as the host user, so the results are not owned by root
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    apptainer {
        apptainer.enabled = true
    }
    singularity {
        singularity.enabled = true
    }
    conda {
        conda.enabled = true
        conda.channels = ['conda-forge', 'bioconda']
    }
}
