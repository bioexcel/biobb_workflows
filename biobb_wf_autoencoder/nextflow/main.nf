/*
 * Generated by utils_biobb nextflow_wf_generator.py from the python workflow: do not edit by hand.
 * AutoEncoders for Anomaly Detection tutorial using BioExcel Building Blocks (biobb)
 * Nextflow version of biobb_wf_autoencoder/python/workflow.py, with the BioBB Nextflow modules in modules/.
 * Usage: nextflow run main.nf -profile docker [--input samplesheet.csv]
 */

include { BIOBB_ANALYSIS_GMX_IMAGE as STEP1_GMX_IMAGE1 } from './modules/bioexcel/biobb_analysis/gmx_image'
include { BIOBB_PYTORCH_MDFEATURIZER as STEP2_MDFEATURIZER1 } from './modules/bioexcel/biobb_pytorch/mdfeaturizer'
include { BIOBB_PYTORCH_BUILD_MODEL as STEP3_BUILD_MODEL } from './modules/bioexcel/biobb_pytorch/build_model'
include { BIOBB_PYTORCH_TRAIN_MODEL as STEP4_TRAIN_MODEL } from './modules/bioexcel/biobb_pytorch/train_model'
include { BIOBB_ANALYSIS_GMX_IMAGE as STEP5_GMX_IMAGE2 } from './modules/bioexcel/biobb_analysis/gmx_image'
include { BIOBB_PYTORCH_MDFEATURIZER as STEP6_MDFEATURIZER2 } from './modules/bioexcel/biobb_pytorch/mdfeaturizer'
include { BIOBB_PYTORCH_EVALUATE_MODEL as STEP7_EVALUATE_MODEL } from './modules/bioexcel/biobb_pytorch/evaluate_model'
include { BIOBB_GROMACS_MAKE_NDX as STEP8_MAKE_NDX1 } from './modules/bioexcel/biobb_gromacs/make_ndx'
include { BIOBB_GROMACS_MAKE_NDX as STEP9_MAKE_NDX2 } from './modules/bioexcel/biobb_gromacs/make_ndx'
include { BIOBB_ANALYSIS_GMX_RMSF as STEP10_GMX_RMSF1 } from './modules/bioexcel/biobb_analysis/gmx_rmsf'
include { BIOBB_ANALYSIS_GMX_RMSF as STEP11_GMX_RMSF2 } from './modules/bioexcel/biobb_analysis/gmx_rmsf'
include { BIOBB_PYTORCH_FEAT2TRAJ as STEP12_FEAT2TRAJ } from './modules/bioexcel/biobb_pytorch/feat2traj'
include { BIOBB_ANALYSIS_GMX_RMSF as STEP13_GMX_RMSF3 } from './modules/bioexcel/biobb_analysis/gmx_rmsf'
include { BIOBB_PYTORCH_MAKE_PLUMED as STEP14_MAKE_PLUMED } from './modules/bioexcel/biobb_pytorch/make_plumed'

params {
    // CSV with an id column and one column per input file: one workflow run per row
    input: String = "${projectDir}/samplesheet.csv"
}

workflow {
    main:
    // One [meta, files] item per samplesheet row: the steps of every row run in parallel
    ch_samples = channel.fromPath(params.input)
        .splitCsv(header: true)
        .map { row -> [[id: row.id], [trj_in: samplePath(row.trj_in), str_in: samplePath(row.str_in), test_trj_in: samplePath(row.test_trj_in), test_str_in: samplePath(row.test_str_in)]] }

    // step1_gmx_image1: Fit the train trajectory to the apo structure
    STEP1_GMX_IMAGE1(
        ch_samples.map { meta, files -> [meta, files.trj_in] }
            .join(ch_samples.map { meta, files -> [meta, files.str_in] })
            .map { meta, traj, top -> [meta, traj, top, []] }
    )
    // step2_mdfeaturizer1: Featurize the train trajectory
    STEP2_MDFEATURIZER1(
        ch_samples.map { meta, files -> [meta, files.str_in] }
            .join(STEP1_GMX_IMAGE1.out.output_traj_path)
    )
    // step3_build_model: Build the model
    STEP3_BUILD_MODEL(STEP2_MDFEATURIZER1.out.output_stats_pt_path)
    // step4_train_model: Train the model
    STEP4_TRAIN_MODEL(
        STEP3_BUILD_MODEL.out.output_model_pth_path
            .join(STEP2_MDFEATURIZER1.out.output_dataset_pt_path)
    )
    // step5_gmx_image2: Fit the test trajectory to the apo structure
    STEP5_GMX_IMAGE2(
        ch_samples.map { meta, files -> [meta, files.test_trj_in] }
            .join(ch_samples.map { meta, files -> [meta, files.str_in] })
            .map { meta, traj, top -> [meta, traj, top, []] }
    )
    // step6_mdfeaturizer2: Featurize the test trajectory
    STEP6_MDFEATURIZER2(
        ch_samples.map { meta, files -> [meta, files.test_str_in] }
            .join(STEP5_GMX_IMAGE2.out.output_traj_path)
    )
    // step7_evaluate_model: Evaluate the model
    STEP7_EVALUATE_MODEL(
        STEP4_TRAIN_MODEL.out.output_model_pth_path
            .join(STEP2_MDFEATURIZER1.out.output_dataset_pt_path)
    )
    // step8_make_ndx1: Train Index NDX file generation
    STEP8_MAKE_NDX1(
        ch_samples.map { meta, files -> [meta, files.str_in] }
            .map { meta, structure -> [meta, structure, []] }
    )
    // step9_make_ndx2: Test Index NDX file generation
    STEP9_MAKE_NDX2(
        ch_samples.map { meta, files -> [meta, files.test_str_in] }
            .map { meta, structure -> [meta, structure, []] }
    )
    // step10_gmx_rmsf1: RMSF calculation Apo Trajectory
    STEP10_GMX_RMSF1(
        ch_samples.map { meta, files -> [meta, files.str_in] }
            .join(ch_samples.map { meta, files -> [meta, files.trj_in] })
            .join(STEP8_MAKE_NDX1.out.output_ndx_path)
    )
    // step11_gmx_rmsf2: RMSF calculation Holo Trajectory
    STEP11_GMX_RMSF2(
        ch_samples.map { meta, files -> [meta, files.test_str_in] }
            .join(ch_samples.map { meta, files -> [meta, files.test_trj_in] })
            .join(STEP9_MAKE_NDX2.out.output_ndx_path)
    )
    // step12_feat2traj: Dataset to Trajectory Conversion
    STEP12_FEAT2TRAJ(
        STEP7_EVALUATE_MODEL.out.output_results_npz_path
            .join(STEP6_MDFEATURIZER2.out.output_stats_pt_path)
            .map { meta, results_npz, stats_pt -> [meta, results_npz, stats_pt, []] }
    )
    // step13_gmx_rmsf3: Original Holo vs Reconstructed Holo Trajectories
    STEP13_GMX_RMSF3(
        STEP12_FEAT2TRAJ.out.output_top_path
            .join(STEP12_FEAT2TRAJ.out.output_traj_path)
            .join(STEP9_MAKE_NDX2.out.output_ndx_path)
    )
    // step14_make_plumed: Extract CV & Generate Plumed File
    STEP14_MAKE_PLUMED(
        STEP4_TRAIN_MODEL.out.output_model_pth_path
            .join(STEP2_MDFEATURIZER1.out.output_stats_pt_path)
            .join(ch_samples.map { meta, files -> [meta, files.str_in] })
            .join(STEP8_MAKE_NDX1.out.output_ndx_path)
    )

    publish:
    results = channel.empty().mix(
        STEP1_GMX_IMAGE1.out.output_traj_path.map { meta, result -> [meta, 'step1_gmx_image1', result] },
        STEP2_MDFEATURIZER1.out.output_dataset_pt_path.mix(STEP2_MDFEATURIZER1.out.output_stats_pt_path).map { meta, result -> [meta, 'step2_mdfeaturizer1', result] },
        STEP3_BUILD_MODEL.out.output_model_pth_path.map { meta, result -> [meta, 'step3_build_model', result] },
        STEP4_TRAIN_MODEL.out.output_model_pth_path.mix(STEP4_TRAIN_MODEL.out.output_metrics_npz_path).map { meta, result -> [meta, 'step4_train_model', result] },
        STEP5_GMX_IMAGE2.out.output_traj_path.map { meta, result -> [meta, 'step5_gmx_image2', result] },
        STEP6_MDFEATURIZER2.out.output_dataset_pt_path.mix(STEP6_MDFEATURIZER2.out.output_stats_pt_path).map { meta, result -> [meta, 'step6_mdfeaturizer2', result] },
        STEP7_EVALUATE_MODEL.out.output_results_npz_path.map { meta, result -> [meta, 'step7_evaluate_model', result] },
        STEP8_MAKE_NDX1.out.output_ndx_path.map { meta, result -> [meta, 'step8_make_ndx1', result] },
        STEP9_MAKE_NDX2.out.output_ndx_path.map { meta, result -> [meta, 'step9_make_ndx2', result] },
        STEP10_GMX_RMSF1.out.output_xvg_path.map { meta, result -> [meta, 'step10_gmx_rmsf1', result] },
        STEP11_GMX_RMSF2.out.output_xvg_path.map { meta, result -> [meta, 'step11_gmx_rmsf2', result] },
        STEP12_FEAT2TRAJ.out.output_traj_path.mix(STEP12_FEAT2TRAJ.out.output_top_path).map { meta, result -> [meta, 'step12_feat2traj', result] },
        STEP13_GMX_RMSF3.out.output_xvg_path.map { meta, result -> [meta, 'step13_gmx_rmsf3', result] },
        STEP14_MAKE_PLUMED.out.output_plumed_dat_path.mix(STEP14_MAKE_PLUMED.out.output_features_dat_path, STEP14_MAKE_PLUMED.out.output_model_ptc_path).map { meta, result -> [meta, 'step14_make_plumed', result] }
    )
}

output {
    // results/<id>/<step>/<id>_<step>_<role>.<ext>
    results {
        path { meta, step, _result -> "${meta.id}/${step}" }
    }
}

// Path of a samplesheet column: absolute, or relative to the samplesheet folder
def samplePath(String value) {
    file(file(params.input).parent.resolve(value).toString(), checkIfExists: true)
}
