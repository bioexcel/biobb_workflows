/*
 * Generated by utils_biobb nextflow_wf_generator.py from the python workflow: do not edit by hand.
 * Protein-ligand Docking tutorials using BioExcel Building Blocks (biobb)
 * Nextflow version of biobb_wf_virtual-screening_fpocket/python/workflow.py, with the BioBB Nextflow modules in modules/.
 * Usage: nextflow run main.nf -profile docker [--input samplesheet.csv]
 */

include { BIOBB_VS_FPOCKET_SELECT as STEP1_FPOCKET_SELECT } from './modules/bioexcel/biobb_vs/fpocket_select'
include { BIOBB_VS_BOX as STEP2_BOX } from './modules/bioexcel/biobb_vs/box'
include { BIOBB_CHEMISTRY_BABEL_CONVERT as STEP3_BABEL_CONVERT_PREP_LIG } from './modules/bioexcel/biobb_chemistry/babel_convert'
include { BIOBB_STRUCTURE_UTILS_STR_CHECK_ADD_HYDROGENS as STEP4_STR_CHECK_ADD_HYDROGENS } from './modules/bioexcel/biobb_structure_utils/str_check_add_hydrogens'
include { BIOBB_VS_AUTODOCK_VINA_RUN as STEP5_AUTODOCK_VINA_RUN } from './modules/bioexcel/biobb_vs/autodock_vina_run'
include { BIOBB_CHEMISTRY_BABEL_CONVERT as STEP6_BABEL_CONVERT_POSE_PDB } from './modules/bioexcel/biobb_chemistry/babel_convert'

params {
    // CSV with an id column and one column per input file: one workflow run per row
    input: String = "${projectDir}/samplesheet.csv"
}

workflow {
    main:
    // One [meta, files] item per samplesheet row: the steps of every row run in parallel
    ch_samples = channel.fromPath(params.input)
        .splitCsv(header: true)
        .map { row -> [[id: row.id], [all_pockets: samplePath(row.all_pockets), ligand: samplePath(row.ligand), protein: samplePath(row.protein)]] }

    // step1_fpocket_select: Extract pocket cavity
    STEP1_FPOCKET_SELECT(ch_samples.map { meta, files -> [meta, files.all_pockets] })
    // step2_box: Generating cavity box
    STEP2_BOX(STEP1_FPOCKET_SELECT.out.output_pocket_pqr)
    // step3_babel_convert_prep_lig: Preparing small molecule (ligand) for docking
    STEP3_BABEL_CONVERT_PREP_LIG(ch_samples.map { meta, files -> [meta, files.ligand] })
    // step4_str_check_add_hydrogens: Preparing target protein for docking
    STEP4_STR_CHECK_ADD_HYDROGENS(ch_samples.map { meta, files -> [meta, files.protein] })
    // step5_autodock_vina_run: Running the docking
    STEP5_AUTODOCK_VINA_RUN(
        STEP3_BABEL_CONVERT_PREP_LIG.out.output_path
            .join(STEP4_STR_CHECK_ADD_HYDROGENS.out.output_structure_path)
            .join(STEP2_BOX.out.output_pdb_path)
    )
    // step6_babel_convert_pose_pdb: Converting ligand pose to PDB format
    STEP6_BABEL_CONVERT_POSE_PDB(STEP5_AUTODOCK_VINA_RUN.out.output_pdbqt_path)

    publish:
    results = channel.empty().mix(
        STEP1_FPOCKET_SELECT.out.output_pocket_pdb.mix(STEP1_FPOCKET_SELECT.out.output_pocket_pqr).map { meta, result -> [meta, 'step1_fpocket_select', result] },
        STEP2_BOX.out.output_pdb_path.map { meta, result -> [meta, 'step2_box', result] },
        STEP3_BABEL_CONVERT_PREP_LIG.out.output_path.map { meta, result -> [meta, 'step3_babel_convert_prep_lig', result] },
        STEP4_STR_CHECK_ADD_HYDROGENS.out.output_structure_path.map { meta, result -> [meta, 'step4_str_check_add_hydrogens', result] },
        STEP5_AUTODOCK_VINA_RUN.out.output_pdbqt_path.mix(STEP5_AUTODOCK_VINA_RUN.out.output_log_path).map { meta, result -> [meta, 'step5_autodock_vina_run', result] },
        STEP6_BABEL_CONVERT_POSE_PDB.out.output_path.map { meta, result -> [meta, 'step6_babel_convert_pose_pdb', result] }
    )
}

output {
    // results/<id>/<step>/<id>_<step>_<role>.<ext>
    results {
        path { meta, step, _result -> "${meta.id}/${step}" }
    }
}

// Path of a samplesheet column: absolute, or relative to the samplesheet folder
def samplePath(String value) {
    file(file(params.input).parent.resolve(value).toString(), checkIfExists: true)
}
