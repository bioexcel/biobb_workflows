/*
 * Generated by utils_biobb nextflow_wf_generator.py from the python workflow: do not edit by hand.
 * Configuration of biobb_wf_virtual-screening_fpocket: biobb properties (ext.properties) and output extensions (ext.outputs) of every step,
 * from python/workflow.yml.
 */

manifest {
    name = 'biobb_wf_virtual-screening_fpocket'
    description = 'Protein-ligand Docking tutorials using BioExcel Building Blocks (biobb)'
    homePage = 'https://github.com/bioexcel/biobb_workflows'
    mainScript = 'main.nf'
    nextflowVersion = '!>=25.10.0'
    license = 'Apache-2.0'
}

outputDir = 'results'
workflow.output.mode = 'copy'

process {
    // Output files named <id>_<step>_<role>.<ext>
    ext.prefix = { "${meta.id}_${task.process.tokenize(':')[-1].toLowerCase()}" }

    withName: 'STEP1_FPOCKET_SELECT' {
        ext.properties = [pocket: 8]
    }

    withName: 'STEP2_BOX' {
        ext.properties = [offset: 12, box_coordinates: true]
    }

    withName: 'STEP3_BABEL_CONVERT_PREP_LIG' {
        ext.properties = [input_format: 'pdb', output_format: 'pdbqt', flex: false, binary_path: 'obabel']
        ext.outputs = [output_path: 'pdbqt']
    }

    withName: 'STEP4_STR_CHECK_ADD_HYDROGENS' {
        ext.properties = [charges: true, mode: 'auto']
        ext.outputs = [output_structure_path: 'pdbqt']
    }

    withName: 'STEP5_AUTODOCK_VINA_RUN' {
        ext.outputs = [output_log_path: 'log']
    }

    withName: 'STEP6_BABEL_CONVERT_POSE_PDB' {
        ext.properties = [input_format: 'pdbqt', output_format: 'pdb', binary_path: 'obabel']
        ext.outputs = [output_path: 'pdb']
    }
}

profiles {
    docker {
        docker.enabled = true
        // Run as the host user, so the results are not owned by root
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    apptainer {
        apptainer.enabled = true
    }
    singularity {
        singularity.enabled = true
    }
    conda {
        conda.enabled = true
        conda.channels = ['conda-forge', 'bioconda']
    }
}
