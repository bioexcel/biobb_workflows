/*
 * Configuration of biobb_wf_haddock: biobb properties (ext.properties) and output extensions (ext.outputs) of every step,
 * from python/workflow.yml.
 */

manifest {
    name = 'biobb_wf_haddock'
    description = 'Protein-protein Docking tutorial using HADDOCK with the BioExcel Building Blocks (biobb)'
    homePage = 'https://github.com/bioexcel/biobb_workflows'
    mainScript = 'main.nf'
    nextflowVersion = '!>=25.10.0'
    license = 'Apache-2.0'
}

outputDir = 'results'
workflow.output.mode = 'copy'

process {
    // Output files named <id>_<step>_<role>.<ext>
    ext.prefix = { "${meta.id}_${task.process.tokenize(':')[-1].toLowerCase()}" }

    // pdb_tools pipelines of workflow.py: properties of every block, last block named after the python step
    withName: 'STEP0_1_PDB_TIDY' {
        ext.properties = [strict: true]
    }

    withName: 'STEP0_2_PDB_SELCHAIN' {
        ext.properties = { [chains: meta.chain] }
    }

    withName: 'STEP0_7_PDB_SELRES' {
        ext.properties = { [selection: "1:${meta.residues}"] }
    }

    withName: 'STEP0_8_PDB_TIDY' {
        ext.prefix = { "${meta.id}_step0_prepare_antibody_reduce_${meta.chain}" }
    }

    withName: 'STEP2_1_PDB_RERES' {
        ext.properties = [number: 1]
    }

    withName: 'STEP2_2_PDB_CHAIN' {
        ext.properties = [chain: 'A']
    }

    withName: 'STEP2_4_PDB_TIDY' {
        ext.properties = [strict: true]
        ext.prefix = { "${meta.id}_step2_prepare_antibody_clean" }
    }

    withName: 'STEP3_1_PDB_TIDY' {
        ext.properties = [strict: true]
    }

    withName: 'STEP3_5_PDB_CHAIN' {
        ext.properties = [chain: 'B']
    }

    withName: 'STEP3_7_PDB_TIDY' {
        ext.properties = [strict: true]
        ext.prefix = { "${meta.id}_step3_prepare_antigen_clean" }
    }

    withName: 'STEP4_1_PDB_SELCHAIN' {
        ext.properties = { [chains: meta.chain] }
    }

    withName: 'STEP4_6_PDB_SELRES' {
        ext.properties = { [selection: "1:${meta.residues}"] }
    }

    withName: 'STEP4_7_PDB_TIDY' {
        ext.prefix = { "${meta.id}_step4_prepare_reference_structure_${meta.chain}" }
    }

    withName: 'STEP6_1_PDB_RERES' {
        ext.properties = [number: 1]
    }

    withName: 'STEP6_2_PDB_CHAIN' {
        ext.properties = [chain: 'A']
    }

    withName: 'STEP6_4_PDB_TIDY' {
        ext.properties = [strict: true]
        ext.prefix = { "${meta.id}_step6_prepare_complex_antibody_clean" }
    }

    withName: 'STEP7_1_PDB_RERES' {
        ext.properties = [number: 1]
    }

    withName: 'STEP7_2_PDB_CHAIN' {
        ext.properties = [chain: 'A']
    }

    withName: 'STEP7_4_PDB_TIDY' {
        ext.properties = [strict: true]
        ext.prefix = { "${meta.id}_step7_prepare_complex_antigen_clean" }
    }

    withName: 'STEP8_2_PDB_TIDY' {
        ext.properties = [strict: true]
        ext.prefix = { "${meta.id}_step8_merge_heavy_light_antigen" }
    }

    // Python logic of workflow.py: zips in the folder of their step
    withName: 'STEP0_ZIP' {
        ext.prefix = { "${meta.id}_step0_prepare_antibody_reduce_HL" }
    }

    withName: 'STEP4_ZIP' {
        ext.prefix = { "${meta.id}_step4_prepare_reference_structure_HL" }
    }

    withName: 'STEP7_ZIP' {
        ext.prefix = { "${meta.id}_step7_prepare_complex_antigen_clean_HL_B" }
    }

    withName: 'STEP9_HADDOCK3_PASSIVE_FROM_ACTIVE' {
        ext.properties = [active_list: '72,73,74,75,81,83,84,89,90,92,94,96,97,98,115,116,117']
    }

    withName: 'STEP10_HADDOCK3_ACTPASS_TO_AMBIG' {
        ext.properties = [segid_one: 'A', segid_two: 'B']
    }

    withName: 'STEP12_TOPOLOGY' {
        ext.outputs = [output_haddock_wf_data: 'directory', mol1_output_top_zip_path: 'zip', mol2_output_top_zip_path: 'zip']
    }

    withName: 'STEP13_RIGID_BODY' {
        ext.properties = [cfg: [sampling: 10, clean: false]]
    }

    withName: 'STEP14_CAPRI_EVAL1' {
        ext.outputs = [output_evaluation_zip_path: 'zip']
    }

    withName: 'STEP15_SELE_TOP' {
        ext.properties = [cfg: [select: 8]]
        ext.outputs = [output_selection_zip_path: 'zip']
    }

    withName: 'STEP16_FLEX_REF' {
        ext.properties = [cfg: [tolerance: 5, clean: false]]
        ext.outputs = [refinement_output_zip_path: 'zip']
    }

    withName: 'STEP17_CAPRI_EVAL2' {
        ext.outputs = [output_evaluation_zip_path: 'zip']
    }

    withName: 'STEP18_EM_REF' {
        ext.properties = [cfg: [tolerance: 5, clean: false]]
        ext.outputs = [refinement_output_zip_path: 'zip']
    }

    withName: 'STEP19_CAPRI_EVAL3' {
        ext.outputs = [output_evaluation_zip_path: 'zip']
    }

    withName: 'STEP20_CLUST_FCC' {
        ext.properties = [cfg: [plot_matrix: true]]
        ext.outputs = [output_cluster_zip_path: 'zip']
    }

    withName: 'STEP21_SELE_TOP_CLUSTS' {
        ext.properties = [cfg: [top_models: 4, clean: false]]
        ext.outputs = [output_selection_zip_path: 'zip']
    }

    withName: 'STEP22_CAPRI_EVAL4' {
        ext.outputs = [output_evaluation_zip_path: 'zip']
    }

    withName: 'STEP23_CONTACT_MAP' {
        ext.outputs = [output_contactmap_zip_path: 'zip']
    }
}

profiles {
    docker {
        docker.enabled = true
        // Run as the host user, so the results are not owned by root
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    apptainer {
        apptainer.enabled = true
    }
    singularity {
        singularity.enabled = true
    }
    conda {
        conda.enabled = true
        conda.channels = ['conda-forge', 'bioconda']
    }
}
