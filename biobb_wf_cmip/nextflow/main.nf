 * CMIP tutorial using BioExcel Building Blocks (biobb)
 * Nextflow version of biobb_wf_cmip/python/workflow.py, with the BioBB Nextflow modules in modules/.
 * Usage: nextflow run main.nf -profile docker [--input samplesheet.csv]
 */

include { BIOBB_CMIP_CMIP_PREPARE_PDB as STEP0_CMIP_PREPARE_PDB } from './modules/bioexcel/biobb_cmip/cmip_prepare_pdb'
include { BIOBB_CMIP_CMIP_TITRATION as STEP1_CMIP_TITRATION } from './modules/bioexcel/biobb_cmip/cmip_titration'
include { BIOBB_STRUCTURE_UTILS_CAT_PDB as STEP2_CAT_PDB } from './modules/bioexcel/biobb_structure_utils/cat_pdb'
include { BIOBB_CMIP_CMIP_RUN as STEP3_CMIP_RUN_POS } from './modules/bioexcel/biobb_cmip/cmip_run'
include { BIOBB_CMIP_CMIP_RUN as STEP4_CMIP_RUN_NEG } from './modules/bioexcel/biobb_cmip/cmip_run'
include { BIOBB_CMIP_CMIP_RUN as STEP5_CMIP_RUN_NEU } from './modules/bioexcel/biobb_cmip/cmip_run'
include { BIOBB_STRUCTURE_UTILS_REMOVE_PDB_WATER as STEP6_REMOVE_PDB_WATER } from './modules/bioexcel/biobb_structure_utils/remove_pdb_water'
include { BIOBB_STRUCTURE_UTILS_EXTRACT_HETEROATOMS as STEP7_EXTRACT_HETEROATOMS } from './modules/bioexcel/biobb_structure_utils/extract_heteroatoms'
include { BIOBB_CHEMISTRY_REDUCE_ADD_HYDROGENS as STEP8_REDUCE_ADD_HYDROGENS } from './modules/bioexcel/biobb_chemistry/reduce_add_hydrogens'
include { BIOBB_CHEMISTRY_ACPYPE_PARAMS_AC as STEP9_ACPYPE_PARAMS_AC } from './modules/bioexcel/biobb_chemistry/acpype_params_ac'
include { BIOBB_AMBER_LEAP_GEN_TOP as STEP10_LEAP_GEN_TOP } from './modules/bioexcel/biobb_amber/leap_gen_top'
include { BIOBB_AMBER_SANDER_MDRUN as STEP11_SANDER_MDRUN } from './modules/bioexcel/biobb_amber/sander_mdrun'
include { BIOBB_AMBER_AMBER_TO_PDB as STEP12_AMBER_TO_PDB } from './modules/bioexcel/biobb_amber/amber_to_pdb'
include { BIOBB_CMIP_CMIP_PREPARE_STRUCTURE as STEP13_CMIP_PREPARE_STRUCTURE } from './modules/bioexcel/biobb_cmip/cmip_prepare_structure'
include { BIOBB_STRUCTURE_UTILS_REMOVE_LIGAND as STEP14_REMOVE_LIGAND } from './modules/bioexcel/biobb_structure_utils/remove_ligand'
include { BIOBB_CMIP_CMIP_IGNORE_RESIDUES as STEP15_CMIP_IGNORE_RESIDUES } from './modules/bioexcel/biobb_cmip/cmip_ignore_residues'
include { BIOBB_CMIP_CMIP_RUN as STEP16_CMIP_RUN_INT_EN } from './modules/bioexcel/biobb_cmip/cmip_run'
include { BIOBB_CMIP_CMIP_PREPARE_STRUCTURE as STEP17_CMIP_PREPARE_STRUCTURE } from './modules/bioexcel/biobb_cmip/cmip_prepare_structure'
include { BIOBB_STRUCTURE_UTILS_EXTRACT_CHAIN as STEP18_EXTRACT_CHAIN_A } from './modules/bioexcel/biobb_structure_utils/extract_chain'
include { BIOBB_STRUCTURE_UTILS_EXTRACT_CHAIN as STEP19_EXTRACT_CHAIN_B } from './modules/bioexcel/biobb_structure_utils/extract_chain'
include { BIOBB_CMIP_CMIP_RUN as STEP20_CMIP_RUN_RBD } from './modules/bioexcel/biobb_cmip/cmip_run'
include { BIOBB_CMIP_CMIP_RUN as STEP21_CMIP_RUN_HACE2 } from './modules/bioexcel/biobb_cmip/cmip_run'
include { BIOBB_CMIP_CMIP_RUN as STEP22_CMIP_RUN_RBD_HACE2 } from './modules/bioexcel/biobb_cmip/cmip_run'
include { BIOBB_CMIP_CMIP_IGNORE_RESIDUES as STEP23_CMIP_IGNORE_RESIDUES_RBD } from './modules/bioexcel/biobb_cmip/cmip_ignore_residues'
include { BIOBB_CMIP_CMIP_RUN as STEP24_CMIP_RUN_PROT_PROT } from './modules/bioexcel/biobb_cmip/cmip_run'
include { BIOBB_CMIP_CMIP_IGNORE_RESIDUES as STEP25_CMIP_IGNORE_RESIDUES_HACE2 } from './modules/bioexcel/biobb_cmip/cmip_ignore_residues'
include { BIOBB_CMIP_CMIP_RUN as STEP26_CMIP_RUN_COMPLEX } from './modules/bioexcel/biobb_cmip/cmip_run'

params {
    // CSV with an id column and one column per input file: one workflow run per row
    input: String = "${projectDir}/samplesheet.csv"
}

workflow {
    main:
    // One [meta, files] item per samplesheet row: the steps of every row run in parallel
    ch_samples = channel.fromPath(params.input)
        .splitCsv(header: true)
        .map { row -> [[id: row.id], [structure: samplePath(row.structure), complex: samplePath(row.complex), rbd_hace2_zn_pdb: samplePath(row.rbd_hace2_zn_pdb), rbd_hace2_zn_top: samplePath(row.rbd_hace2_zn_top)]] }

    // step0_cmip_prepare_pdb: CMIP PDB Preparation
    STEP0_CMIP_PREPARE_PDB(ch_samples.map { meta, files -> [meta, files.structure] })
    // step1_cmip_titration: Computing structural water molecules & ions positions
    STEP1_CMIP_TITRATION(
        STEP0_CMIP_PREPARE_PDB.out.output_cmip_pdb_path
            .map { meta, pdb -> [meta, pdb, [], []] }
    )
    // step2_cat_pdb: Adding structural water molecules & ions
    STEP2_CAT_PDB(
        STEP0_CMIP_PREPARE_PDB.out.output_cmip_pdb_path
            .join(STEP1_CMIP_TITRATION.out.output_pdb_path)
    )
    // step3_cmip_run_pos: Molecular Interaction Potentials (MIPs), Positive MIP
    STEP3_CMIP_RUN_POS(
        STEP0_CMIP_PREPARE_PDB.out.output_cmip_pdb_path
            .map { meta, pdb -> [meta, pdb, [], [], [], [], [], []] }
    )
    // step4_cmip_run_neg: Molecular Interaction Potentials (MIPs), Negative MIP
    STEP4_CMIP_RUN_NEG(
        STEP0_CMIP_PREPARE_PDB.out.output_cmip_pdb_path
            .map { meta, pdb -> [meta, pdb, [], [], [], [], [], []] }
    )
    // step5_cmip_run_neu: Molecular Interaction Potentials (MIPs), Neutral MIP
    STEP5_CMIP_RUN_NEU(
        STEP0_CMIP_PREPARE_PDB.out.output_cmip_pdb_path
            .map { meta, pdb -> [meta, pdb, [], [], [], [], [], []] }
    )
    // step6_remove_pdb_water: Removing Water Molecules
    STEP6_REMOVE_PDB_WATER(ch_samples.map { meta, files -> [meta, files.complex] })
    // step7_extract_heteroatoms: Create ligand system topology, extracting ligand
    STEP7_EXTRACT_HETEROATOMS(STEP6_REMOVE_PDB_WATER.out.output_pdb_path)
    // step8_reduce_add_hydrogens: Create ligand system topology, add hydrogen atoms to the ligand
    STEP8_REDUCE_ADD_HYDROGENS(STEP7_EXTRACT_HETEROATOMS.out.output_heteroatom_path)
    // step9_acpype_params_ac: Create ligand system topology, generation of topologies
    STEP9_ACPYPE_PARAMS_AC(STEP8_REDUCE_ADD_HYDROGENS.out.output_path)
    // step10_leap_gen_top: Generating system topology
    STEP10_LEAP_GEN_TOP(
        STEP6_REMOVE_PDB_WATER.out.output_pdb_path
            .join(STEP9_ACPYPE_PARAMS_AC.out.output_path_lib)
            .join(STEP9_ACPYPE_PARAMS_AC.out.output_path_frcmod)
            .map { meta, pdb, lib, frcmod -> [meta, pdb, lib, frcmod, [], [], []] }
    )
    // step11_sander_mdrun: Minimizing the energy of the system
    STEP11_SANDER_MDRUN(
        STEP10_LEAP_GEN_TOP.out.output_top_path
            .join(STEP10_LEAP_GEN_TOP.out.output_crd_path)
            .map { meta, top, crd -> [meta, top, crd, [], [], []] }
    )
    // step12_amber_to_pdb: Extracting a PDB file from the minimized system
    STEP12_AMBER_TO_PDB(
        STEP10_LEAP_GEN_TOP.out.output_top_path
            .join(STEP11_SANDER_MDRUN.out.output_rst_path)
    )
    // step13_cmip_prepare_structure: CMIP PDB structure Preparation, Protein-Ligand Complex PDB file
    STEP13_CMIP_PREPARE_STRUCTURE(
        STEP12_AMBER_TO_PDB.out.output_pdb_path
            .join(STEP10_LEAP_GEN_TOP.out.output_top_path)
    )
    // step14_remove_ligand: CMIP PDB structure Preparation, Protein isolated PDB file
    STEP14_REMOVE_LIGAND(STEP13_CMIP_PREPARE_STRUCTURE.out.output_cmip_pdb_path)
    // step15_cmip_ignore_residues: CMIP PDB structure Preparation, Protein-Ligand Complex with protein structure in dielectric mode
    STEP15_CMIP_IGNORE_RESIDUES(STEP13_CMIP_PREPARE_STRUCTURE.out.output_cmip_pdb_path)
    // step16_cmip_run_int_en: Computing the Protein-Ligand interaction energies
    STEP16_CMIP_RUN_INT_EN(
        STEP15_CMIP_IGNORE_RESIDUES.out.output_cmip_pdb_path
            .join(STEP14_REMOVE_LIGAND.out.output_structure_path)
            .map { meta, pdb, probe_pdb -> [meta, pdb, probe_pdb, [], [], [], [], []] }
    )
    // step17_cmip_prepare_structure: CMIP PDB Preparation
    STEP17_CMIP_PREPARE_STRUCTURE(
        ch_samples.map { meta, files -> [meta, files.rbd_hace2_zn_pdb] }
            .join(ch_samples.map { meta, files -> [meta, files.rbd_hace2_zn_top] })
    )
    // step18_extract_chain_a: Extracting chains, chain A
    STEP18_EXTRACT_CHAIN_A(STEP17_CMIP_PREPARE_STRUCTURE.out.output_cmip_pdb_path)
    // step19_extract_chain_b: Extracting chains, chain B
    STEP19_EXTRACT_CHAIN_B(STEP17_CMIP_PREPARE_STRUCTURE.out.output_cmip_pdb_path)
    // step20_cmip_run_rbd: CMIP Boxes, box for the RBD
    STEP20_CMIP_RUN_RBD(
        STEP19_EXTRACT_CHAIN_B.out.output_structure_path
            .map { meta, pdb -> [meta, pdb, [], [], [], [], [], []] }
    )
    // step21_cmip_run_hace2: CMIP Boxes, box for the hACE2
    STEP21_CMIP_RUN_HACE2(
        STEP18_EXTRACT_CHAIN_A.out.output_structure_path
            .map { meta, pdb -> [meta, pdb, [], [], [], [], [], []] }
    )
    // step22_cmip_run_rbd_hace2: CMIP Boxes, box for the RBD-hACE2
    STEP22_CMIP_RUN_RBD_HACE2(
        STEP17_CMIP_PREPARE_STRUCTURE.out.output_cmip_pdb_path
            .map { meta, pdb -> [meta, pdb, [], [], [], [], [], []] }
    )
    // step23_cmip_ignore_residues_rbd: RDB Interaction Potential Energies, CMIP PDB structure Preparation
    STEP23_CMIP_IGNORE_RESIDUES_RBD(STEP17_CMIP_PREPARE_STRUCTURE.out.output_cmip_pdb_path)
    // step24_cmip_run_prot_prot: Computing the Protein-Protein interaction energies
    STEP24_CMIP_RUN_PROT_PROT(
        STEP23_CMIP_IGNORE_RESIDUES_RBD.out.output_cmip_pdb_path
            .join(STEP19_EXTRACT_CHAIN_B.out.output_structure_path)
            .join(STEP20_CMIP_RUN_RBD.out.output_json_box_path)
            .join(STEP22_CMIP_RUN_RBD_HACE2.out.output_json_box_path)
            .map { meta, pdb, probe_pdb, json_box, json_external_box -> [meta, pdb, probe_pdb, [], [], [], json_box, json_external_box] }
    )
    // step25_cmip_ignore_residues_hace2: hACE2 Interaction Potential Energies, CMIP PDB structure Preparation
    STEP25_CMIP_IGNORE_RESIDUES_HACE2(STEP17_CMIP_PREPARE_STRUCTURE.out.output_cmip_pdb_path)
    // step26_cmip_run_complex: Computing the complex interaction energies
    STEP26_CMIP_RUN_COMPLEX(
        STEP25_CMIP_IGNORE_RESIDUES_HACE2.out.output_cmip_pdb_path
            .join(STEP18_EXTRACT_CHAIN_A.out.output_structure_path)
            .join(STEP21_CMIP_RUN_HACE2.out.output_json_box_path)
            .join(STEP22_CMIP_RUN_RBD_HACE2.out.output_json_box_path)
            .map { meta, pdb, probe_pdb, json_box, json_external_box -> [meta, pdb, probe_pdb, [], [], [], json_box, json_external_box] }
    )

    publish:
    results = channel.empty().mix(
        STEP0_CMIP_PREPARE_PDB.out.output_cmip_pdb_path.map { meta, result -> [meta, 'step0_cmip_prepare_pdb', result] },
        STEP1_CMIP_TITRATION.out.output_pdb_path.map { meta, result -> [meta, 'step1_cmip_titration', result] },
        STEP2_CAT_PDB.out.output_structure_path.map { meta, result -> [meta, 'step2_cat_pdb', result] },
        STEP3_CMIP_RUN_POS.out.output_cube_path.mix(STEP3_CMIP_RUN_POS.out.output_log_path).map { meta, result -> [meta, 'step3_cmip_run_pos', result] },
        STEP4_CMIP_RUN_NEG.out.output_cube_path.mix(STEP4_CMIP_RUN_NEG.out.output_log_path).map { meta, result -> [meta, 'step4_cmip_run_neg', result] },
        STEP5_CMIP_RUN_NEU.out.output_cube_path.mix(STEP5_CMIP_RUN_NEU.out.output_log_path).map { meta, result -> [meta, 'step5_cmip_run_neu', result] },
        STEP6_REMOVE_PDB_WATER.out.output_pdb_path.map { meta, result -> [meta, 'step6_remove_pdb_water', result] },
        STEP7_EXTRACT_HETEROATOMS.out.output_heteroatom_path.map { meta, result -> [meta, 'step7_extract_heteroatoms', result] },
        STEP8_REDUCE_ADD_HYDROGENS.out.output_path.map { meta, result -> [meta, 'step8_reduce_add_hydrogens', result] },
        STEP9_ACPYPE_PARAMS_AC.out.output_path_frcmod.mix(STEP9_ACPYPE_PARAMS_AC.out.output_path_inpcrd, STEP9_ACPYPE_PARAMS_AC.out.output_path_lib, STEP9_ACPYPE_PARAMS_AC.out.output_path_prmtop).map { meta, result -> [meta, 'step9_acpype_params_ac', result] },
        STEP10_LEAP_GEN_TOP.out.output_pdb_path.mix(STEP10_LEAP_GEN_TOP.out.output_top_path, STEP10_LEAP_GEN_TOP.out.output_crd_path).map { meta, result -> [meta, 'step10_leap_gen_top', result] },
        STEP11_SANDER_MDRUN.out.output_log_path.mix(STEP11_SANDER_MDRUN.out.output_traj_path, STEP11_SANDER_MDRUN.out.output_rst_path).map { meta, result -> [meta, 'step11_sander_mdrun', result] },
        STEP12_AMBER_TO_PDB.out.output_pdb_path.map { meta, result -> [meta, 'step12_amber_to_pdb', result] },
        STEP13_CMIP_PREPARE_STRUCTURE.out.output_cmip_pdb_path.map { meta, result -> [meta, 'step13_cmip_prepare_structure', result] },
        STEP14_REMOVE_LIGAND.out.output_structure_path.map { meta, result -> [meta, 'step14_remove_ligand', result] },
        STEP15_CMIP_IGNORE_RESIDUES.out.output_cmip_pdb_path.map { meta, result -> [meta, 'step15_cmip_ignore_residues', result] },
        STEP16_CMIP_RUN_INT_EN.out.output_byat_path.mix(STEP16_CMIP_RUN_INT_EN.out.output_log_path).map { meta, result -> [meta, 'step16_cmip_run_int_en', result] },
        STEP17_CMIP_PREPARE_STRUCTURE.out.output_cmip_pdb_path.map { meta, result -> [meta, 'step17_cmip_prepare_structure', result] },
        STEP18_EXTRACT_CHAIN_A.out.output_structure_path.map { meta, result -> [meta, 'step18_extract_chain_a', result] },
        STEP19_EXTRACT_CHAIN_B.out.output_structure_path.map { meta, result -> [meta, 'step19_extract_chain_b', result] },
        STEP20_CMIP_RUN_RBD.out.output_log_path.mix(STEP20_CMIP_RUN_RBD.out.output_json_box_path).map { meta, result -> [meta, 'step20_cmip_run_rbd', result] },
        STEP21_CMIP_RUN_HACE2.out.output_log_path.mix(STEP21_CMIP_RUN_HACE2.out.output_json_box_path).map { meta, result -> [meta, 'step21_cmip_run_hace2', result] },
        STEP22_CMIP_RUN_RBD_HACE2.out.output_log_path.mix(STEP22_CMIP_RUN_RBD_HACE2.out.output_json_box_path).map { meta, result -> [meta, 'step22_cmip_run_rbd_hace2', result] },
        STEP23_CMIP_IGNORE_RESIDUES_RBD.out.output_cmip_pdb_path.map { meta, result -> [meta, 'step23_cmip_ignore_residues_rbd', result] },
        STEP24_CMIP_RUN_PROT_PROT.out.output_byat_path.mix(STEP24_CMIP_RUN_PROT_PROT.out.output_log_path, STEP24_CMIP_RUN_PROT_PROT.out.output_json_box_path, STEP24_CMIP_RUN_PROT_PROT.out.output_json_external_box_path).map { meta, result -> [meta, 'step24_cmip_run_prot_prot', result] },
        STEP25_CMIP_IGNORE_RESIDUES_HACE2.out.output_cmip_pdb_path.map { meta, result -> [meta, 'step25_cmip_ignore_residues_hace2', result] },
        STEP26_CMIP_RUN_COMPLEX.out.output_byat_path.mix(STEP26_CMIP_RUN_COMPLEX.out.output_log_path, STEP26_CMIP_RUN_COMPLEX.out.output_json_box_path, STEP26_CMIP_RUN_COMPLEX.out.output_json_external_box_path).map { meta, result -> [meta, 'step26_cmip_run_complex', result] }
    )
}

output {
    // results/<id>/<step>/<id>_<step>_<role>.<ext>
    results {
        path { meta, step, _result -> "${meta.id}/${step}" }
    }
}

// Path of a samplesheet column: absolute, or relative to the samplesheet folder
def samplePath(String value) {
    file(file(params.input).parent.resolve(value).toString(), checkIfExists: true)
}
