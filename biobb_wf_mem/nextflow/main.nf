/*
 * Generated by utils_biobb nextflow_wf_generator.py from the python workflow: do not edit by hand.
 * Protein-Membrane MD analysis tutorial using BioExcel Building Blocks (biobb)
 * Nextflow version of biobb_wf_mem/python/workflow.py, with the BioBB Nextflow modules in modules/.
 * Usage: nextflow run main.nf -profile docker [--input samplesheet.csv]
 */

include { BIOBB_ANALYSIS_GMX_IMAGE as STEP1_GMX_IMAGE1 } from './modules/bioexcel/biobb_analysis/gmx_image'
include { BIOBB_ANALYSIS_GMX_IMAGE as STEP2_GMX_IMAGE2 } from './modules/bioexcel/biobb_analysis/gmx_image'
include { BIOBB_MEM_FATSLIM_MEMBRANES as STEP3_FATSLIM_MEMBRANES } from './modules/bioexcel/biobb_mem/fatslim_membranes'
include { BIOBB_MEM_LPP_ASSIGN_LEAFLETS as STEP4_LPP_ASSIGN_LEAFLETS } from './modules/bioexcel/biobb_mem/lpp_assign_leaflets'
include { BIOBB_MEM_LPP_ZPOSITIONS as STEP5_LPP_ZPOSITIONS1 } from './modules/bioexcel/biobb_mem/lpp_zpositions'
include { BIOBB_MEM_LPP_ZPOSITIONS as STEP6_LPP_ZPOSITIONS2 } from './modules/bioexcel/biobb_mem/lpp_zpositions'
include { BIOBB_MEM_GORDER_AA as STEP7_GORDER_AA } from './modules/bioexcel/biobb_mem/gorder_aa'
include { BIOBB_MEM_FATSLIM_APL as STEP8_FATSLIM_APL } from './modules/bioexcel/biobb_mem/fatslim_apl'
include { BIOBB_MEM_CPPTRAJ_DENSITY as STEP9_CPPTRAJ_DENSITY } from './modules/bioexcel/biobb_mem/cpptraj_density'
include { BIOBB_MEM_MDA_HOLE as STEP10_MDA_HOLE } from './modules/bioexcel/biobb_mem/mda_hole'
include { BIOBB_MEM_LPP_FLIP_FLOP as STEP11_LPP_FLIP_FLOP } from './modules/bioexcel/biobb_mem/lpp_flip_flop'

params {
    // CSV with an id column and one column per input file: one workflow run per row
    input: String = "${projectDir}/samplesheet.csv"
}

workflow {
    main:
    // One [meta, files] item per samplesheet row: the steps of every row run in parallel
    ch_samples = channel.fromPath(params.input)
        .splitCsv(header: true)
        .map { row -> [[id: row.id], [trajectory: samplePath(row.trajectory), structure: samplePath(row.structure), topology: samplePath(row.topology)]] }

    // step1_gmx_image1: Fit the trajectory to the membrane
    STEP1_GMX_IMAGE1(
        ch_samples.map { meta, files -> [meta, files.trajectory] }
            .join(ch_samples.map { meta, files -> [meta, files.structure] })
            .map { meta, traj, top -> [meta, traj, top, []] }
    )
    // step2_gmx_image2: Fit again transxy to the protein
    STEP2_GMX_IMAGE2(
        STEP1_GMX_IMAGE1.out.output_traj_path
            .join(ch_samples.map { meta, files -> [meta, files.structure] })
            .map { meta, traj, top -> [meta, traj, top, []] }
    )
    // step3_fatslim_membranes: Membrane leaflets identification and GROMACS index file generatation
    STEP3_FATSLIM_MEMBRANES(
        ch_samples.map { meta, files -> [meta, files.structure] }
            .join(ch_samples.map { meta, files -> [meta, files.trajectory] })
            .map { meta, top, traj -> [meta, top, traj, []] }
    )
    // step4_lpp_assign_leaflets: Assign leafleats for every frame
    STEP4_LPP_ASSIGN_LEAFLETS(
        ch_samples.map { meta, files -> [meta, files.structure] }
            .join(STEP2_GMX_IMAGE2.out.output_traj_path)
    )
    // step5_lpp_zpositions1: Computing z-positions for the whole membrane
    STEP5_LPP_ZPOSITIONS1(
        ch_samples.map { meta, files -> [meta, files.structure] }
            .join(STEP2_GMX_IMAGE2.out.output_traj_path)
    )
    // step6_lpp_zpositions2: Computing z-positions for the selection around the protein
    STEP6_LPP_ZPOSITIONS2(
        ch_samples.map { meta, files -> [meta, files.structure] }
            .join(STEP2_GMX_IMAGE2.out.output_traj_path)
    )
    // step7_gorder_aa: Calculating deuterium order parameter of acyl tails in a lipid bilayer
    STEP7_GORDER_AA(
        ch_samples.map { meta, files -> [meta, files.topology] }
            .join(ch_samples.map { meta, files -> [meta, files.trajectory] })
    )
    // step8_fatslim_apl: Removing the area corresponding to protein molecules
    STEP8_FATSLIM_APL(
        ch_samples.map { meta, files -> [meta, files.structure] }
            .join(STEP1_GMX_IMAGE1.out.output_traj_path)
            .map { meta, top, traj -> [meta, top, traj, []] }
    )
    // step9_cpptraj_density: Calculating membrane density
    STEP9_CPPTRAJ_DENSITY(
        ch_samples.map { meta, files -> [meta, files.structure] }
            .join(STEP2_GMX_IMAGE2.out.output_traj_path)
    )
    // step10_mda_hole: Identifying channels and analyze dimensions and properties along them
    STEP10_MDA_HOLE(
        ch_samples.map { meta, files -> [meta, files.structure] }
            .join(STEP2_GMX_IMAGE2.out.output_traj_path)
    )
    // step11_lpp_flip_flop: Detecting the flip-flop of molecules in a lipid bilayer
    STEP11_LPP_FLIP_FLOP(
        ch_samples.map { meta, files -> [meta, files.structure] }
            .join(STEP2_GMX_IMAGE2.out.output_traj_path)
            .join(STEP4_LPP_ASSIGN_LEAFLETS.out.output_leaflets_path)
    )

    publish:
    results = channel.empty().mix(
        STEP1_GMX_IMAGE1.out.output_traj_path.map { meta, result -> [meta, 'step1_gmx_image1', result] },
        STEP2_GMX_IMAGE2.out.output_traj_path.map { meta, result -> [meta, 'step2_gmx_image2', result] },
        STEP3_FATSLIM_MEMBRANES.out.output_ndx_path.map { meta, result -> [meta, 'step3_fatslim_membranes', result] },
        STEP4_LPP_ASSIGN_LEAFLETS.out.output_leaflets_path.map { meta, result -> [meta, 'step4_lpp_assign_leaflets', result] },
        STEP5_LPP_ZPOSITIONS1.out.output_positions_path.map { meta, result -> [meta, 'step5_lpp_zpositions1', result] },
        STEP6_LPP_ZPOSITIONS2.out.output_positions_path.map { meta, result -> [meta, 'step6_lpp_zpositions2', result] },
        STEP7_GORDER_AA.out.output_order_path.map { meta, result -> [meta, 'step7_gorder_aa', result] },
        STEP8_FATSLIM_APL.out.output_csv_path.map { meta, result -> [meta, 'step8_fatslim_apl', result] },
        STEP9_CPPTRAJ_DENSITY.out.output_cpptraj_path.map { meta, result -> [meta, 'step9_cpptraj_density', result] },
        STEP10_MDA_HOLE.out.output_hole_path.mix(STEP10_MDA_HOLE.out.output_csv_path).map { meta, result -> [meta, 'step10_mda_hole', result] },
        STEP11_LPP_FLIP_FLOP.out.output_flip_flop_path.map { meta, result -> [meta, 'step11_lpp_flip_flop', result] }
    )
}

output {
    // results/<id>/<step>/<id>_<step>_<role>.<ext>
    results {
        path { meta, step, _result -> "${meta.id}/${step}" }
    }
}

// Path of a samplesheet column: absolute, or relative to the samplesheet folder
def samplePath(String value) {
    file(file(params.input).parent.resolve(value).toString(), checkIfExists: true)
}
