/*
 * Generated by utils_biobb nextflow_wf_generator.py from the python workflow: do not edit by hand.
 * Configuration of biobb_wf_mem: biobb properties (ext.properties) and output extensions (ext.outputs) of every step,
 * from python/workflow.yml.
 */

manifest {
    name = 'biobb_wf_mem'
    description = 'Protein-Membrane MD analysis tutorial using BioExcel Building Blocks (biobb)'
    homePage = 'https://github.com/bioexcel/biobb_workflows'
    mainScript = 'main.nf'
    nextflowVersion = '!>=25.10.0'
    license = 'Apache-2.0'
}

outputDir = 'results'
workflow.output.mode = 'copy'

process {
    // Output files named <id>_<step>_<role>.<ext>
    ext.prefix = { "${meta.id}_${task.process.tokenize(':')[-1].toLowerCase()}" }

    withName: 'STEP1_GMX_IMAGE1' {
        ext.properties = [fit_selection: 'DPPC', output_selection: 'System', center: false, fit: 'rot+trans']
    }

    withName: 'STEP2_GMX_IMAGE2' {
        ext.properties = [fit_selection: 'Backbone', output_selection: 'System', center: false, fit: 'transxy']
    }

    withName: 'STEP3_FATSLIM_MEMBRANES' {
        ext.properties = [selection: '(resname DPPC and element P)', cutoff: 2.2, ignore_no_box: true]
    }

    withName: 'STEP4_LPP_ASSIGN_LEAFLETS' {
        ext.properties = [lipid_sel: '(resname DPPC and element P)', steps: 1]
    }

    withName: 'STEP5_LPP_ZPOSITIONS1' {
        ext.properties = [lipid_sel: '(resname DPPC and element P)', steps: 1, height_sel: '(resname DPPC and element P)', ignore_no_box: true]
    }

    withName: 'STEP6_LPP_ZPOSITIONS2' {
        ext.properties = [lipid_sel: '(resname DPPC and element P)', steps: 1, height_sel: '(resname DPPC and element P) and (cyzone 50 70 -50 protein)', ignore_no_box: true]
    }

    withName: 'STEP7_GORDER_AA' {
        ext.properties = [handle_pbc: false]
        ext.outputs = [output_order_path: 'csv']
    }

    withName: 'STEP8_FATSLIM_APL' {
        ext.properties = [lipid_selection: '(resname DPPC and element P)', protein_selection: 'protein and not element H', ignore_no_box: true]
    }

    withName: 'STEP9_CPPTRAJ_DENSITY' {
        ext.properties = [mask: ':DPP !:DPP :DPP@P8', steps: 1]
    }

    withName: 'STEP10_MDA_HOLE' {
        ext.properties = [select: 'protein', steps: 20, sample: 0.1]
    }

    withName: 'STEP11_LPP_FLIP_FLOP' {
        ext.properties = [lipid_sel: '(resname DPPC and element P)', steps: 1, frame_cutoff: 2]
    }
}

profiles {
    docker {
        docker.enabled = true
        // Run as the host user, so the results are not owned by root
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    apptainer {
        apptainer.enabled = true
    }
    singularity {
        singularity.enabled = true
    }
    conda {
        conda.enabled = true
        conda.channels = ['conda-forge', 'bioconda']
    }
}
