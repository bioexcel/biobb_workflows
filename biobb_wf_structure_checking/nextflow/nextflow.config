/*
 * Generated by utils_biobb nextflow_wf_generator.py from the python workflow: do not edit by hand.
 * Configuration of biobb_wf_structure_checking: biobb properties (ext.properties) and output extensions (ext.outputs) of every step,
 * from python/workflow.yml.
 */

manifest {
    name = 'biobb_wf_structure_checking'
    description = 'Molecular Structure Checking using BioExcel Building Blocks (biobb)'
    homePage = 'https://github.com/bioexcel/biobb_workflows'
    mainScript = 'main.nf'
    nextflowVersion = '!>=25.10.0'
    license = 'Apache-2.0'
}

outputDir = 'results'
workflow.output.mode = 'copy'

process {
    // Output files named <id>_<step>_<role>.<ext>
    ext.prefix = { "${meta.id}_${task.process.tokenize(':')[-1].toLowerCase()}" }

    withName: 'STEP1_EXTRACT_MODEL' {
        ext.properties = [models: [1]]
    }

    withName: 'STEP2_EXTRACT_CHAIN' {
        ext.properties = [chains: ['A']]
    }

    withName: 'STEP3_FIX_ALTLOCS' {
        ext.properties = [altlocs: ['A45:A', 'A67:A', 'A85:A']]
    }

    withName: 'STEP5_REMOVE_MOLECULES_IONS' {
        ext.properties = [molecules: [[name: 'ZN']]]
    }

    withName: 'STEP6_REMOVE_MOLECULES_LIGANDS' {
        ext.properties = [molecules: [[name: 'SO4'], [name: 'AP5']]]
    }

    withName: 'STEP13_LEAP_GEN_TOP' {
        ext.properties = [forcefield: ['protein.ff14SB']]
    }

    withName: 'STEP14_SANDER_MDRUN' {
        ext.properties = [simulation_type: 'minimization', mdin: [ntb: 0, cut: 12, maxcyc: 500, ncyc: 50, ntwx: 50]]
        ext.outputs = [output_traj_path: 'crd']
    }

    withName: 'STEP16_FIX_PDB' {
        ext.properties = [forced_uniprot_references: ['P00568']]
    }
}

profiles {
    docker {
        docker.enabled = true
        // Run as the host user, so the results are not owned by root
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    apptainer {
        apptainer.enabled = true
    }
    singularity {
        singularity.enabled = true
    }
    conda {
        conda.enabled = true
        conda.channels = ['conda-forge', 'bioconda']
    }
}
