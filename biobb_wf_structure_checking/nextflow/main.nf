/*
 * Generated by utils_biobb nextflow_wf_generator.py from the python workflow: do not edit by hand.
 * Molecular Structure Checking using BioExcel Building Blocks (biobb)
 * Nextflow version of biobb_wf_structure_checking/python/workflow.py, with the BioBB Nextflow modules in modules/.
 * Usage: nextflow run main.nf -profile docker [--input samplesheet.csv]
 */

include { BIOBB_STRUCTURE_UTILS_STRUCTURE_CHECK as STEP0_STRUCTURE_CHECK_INIT } from './modules/bioexcel/biobb_structure_utils/structure_check'
include { BIOBB_STRUCTURE_UTILS_EXTRACT_MODEL as STEP1_EXTRACT_MODEL } from './modules/bioexcel/biobb_structure_utils/extract_model'
include { BIOBB_STRUCTURE_UTILS_EXTRACT_CHAIN as STEP2_EXTRACT_CHAIN } from './modules/bioexcel/biobb_structure_utils/extract_chain'
include { BIOBB_MODEL_FIX_ALTLOCS as STEP3_FIX_ALTLOCS } from './modules/bioexcel/biobb_model/fix_altlocs'
include { BIOBB_MODEL_FIX_SSBONDS as STEP4_FIX_SSBONDS } from './modules/bioexcel/biobb_model/fix_ssbonds'
include { BIOBB_STRUCTURE_UTILS_REMOVE_MOLECULES as STEP5_REMOVE_MOLECULES_IONS } from './modules/bioexcel/biobb_structure_utils/remove_molecules'
include { BIOBB_STRUCTURE_UTILS_REMOVE_MOLECULES as STEP6_REMOVE_MOLECULES_LIGANDS } from './modules/bioexcel/biobb_structure_utils/remove_molecules'
include { BIOBB_CHEMISTRY_REDUCE_REMOVE_HYDROGENS as STEP7_REDUCE_REMOVE_HYDROGENS } from './modules/bioexcel/biobb_chemistry/reduce_remove_hydrogens'
include { BIOBB_STRUCTURE_UTILS_REMOVE_PDB_WATER as STEP8_REMOVE_PDB_WATER } from './modules/bioexcel/biobb_structure_utils/remove_pdb_water'
include { BIOBB_MODEL_FIX_AMIDES as STEP9_FIX_AMIDES } from './modules/bioexcel/biobb_model/fix_amides'
include { BIOBB_MODEL_FIX_CHIRALITY as STEP10_FIX_CHIRALITY } from './modules/bioexcel/biobb_model/fix_chirality'
include { BIOBB_MODEL_FIX_SIDE_CHAIN as STEP11_FIX_SIDE_CHAIN } from './modules/bioexcel/biobb_model/fix_side_chain'
include { BIOBB_MODEL_FIX_BACKBONE as STEP12_FIX_BACKBONE } from './modules/bioexcel/biobb_model/fix_backbone'
include { BIOBB_AMBER_LEAP_GEN_TOP as STEP13_LEAP_GEN_TOP } from './modules/bioexcel/biobb_amber/leap_gen_top'
include { BIOBB_AMBER_SANDER_MDRUN as STEP14_SANDER_MDRUN } from './modules/bioexcel/biobb_amber/sander_mdrun'
include { BIOBB_AMBER_AMBER_TO_PDB as STEP15_AMBER_TO_PDB } from './modules/bioexcel/biobb_amber/amber_to_pdb'
include { BIOBB_MODEL_FIX_PDB as STEP16_FIX_PDB } from './modules/bioexcel/biobb_model/fix_pdb'
include { BIOBB_STRUCTURE_UTILS_STRUCTURE_CHECK as STEP17_STRUCTURE_CHECK } from './modules/bioexcel/biobb_structure_utils/structure_check'

params {
    // CSV with an id column and one column per input file: one workflow run per row
    input: String = "${projectDir}/samplesheet.csv"
}

workflow {
    main:
    // One [meta, files] item per samplesheet row: the steps of every row run in parallel
    ch_samples = channel.fromPath(params.input)
        .splitCsv(header: true)
        .map { row -> [[id: row.id], [structure: samplePath(row.structure), sequence: samplePath(row.sequence)]] }

    // step0_structure_check_init: PDB structure checking
    STEP0_STRUCTURE_CHECK_INIT(ch_samples.map { meta, files -> [meta, files.structure] })
    // step1_extract_model: Extract model
    STEP1_EXTRACT_MODEL(ch_samples.map { meta, files -> [meta, files.structure] })
    // step2_extract_chain: Extract chain
    STEP2_EXTRACT_CHAIN(STEP1_EXTRACT_MODEL.out.output_structure_path)
    // step3_fix_altlocs: Alternative Locations
    STEP3_FIX_ALTLOCS(STEP2_EXTRACT_CHAIN.out.output_structure_path)
    // step4_fix_ssbonds: Disulfide Bridges
    STEP4_FIX_SSBONDS(STEP3_FIX_ALTLOCS.out.output_pdb_path)
    // step5_remove_molecules_ions: Metal Ions
    STEP5_REMOVE_MOLECULES_IONS(STEP4_FIX_SSBONDS.out.output_pdb_path)
    // step6_remove_molecules_ligands: Ligands
    STEP6_REMOVE_MOLECULES_LIGANDS(STEP5_REMOVE_MOLECULES_IONS.out.output_molecules_path)
    // step7_reduce_remove_hydrogens: Hydrogen atoms
    STEP7_REDUCE_REMOVE_HYDROGENS(STEP6_REMOVE_MOLECULES_LIGANDS.out.output_molecules_path)
    // step8_remove_pdb_water: Water molecules
    STEP8_REMOVE_PDB_WATER(STEP7_REDUCE_REMOVE_HYDROGENS.out.output_path)
    // step9_fix_amides: Amide groups
    STEP9_FIX_AMIDES(STEP8_REMOVE_PDB_WATER.out.output_pdb_path)
    // step10_fix_chirality: Chirality
    STEP10_FIX_CHIRALITY(STEP9_FIX_AMIDES.out.output_pdb_path)
    // step11_fix_side_chain: Side Chains
    STEP11_FIX_SIDE_CHAIN(STEP10_FIX_CHIRALITY.out.output_pdb_path)
    // step12_fix_backbone: Backbone
    STEP12_FIX_BACKBONE(
        STEP11_FIX_SIDE_CHAIN.out.output_pdb_path
            .join(ch_samples.map { meta, files -> [meta, files.sequence] })
    )
    // step13_leap_gen_top: Atomic Clashes, leap_gen_top
    STEP13_LEAP_GEN_TOP(
        STEP12_FIX_BACKBONE.out.output_pdb_path
            .map { meta, pdb -> [meta, pdb, [], [], [], [], []] }
    )
    // step14_sander_mdrun: Atomic Clashes, sander_mdrun
    STEP14_SANDER_MDRUN(
        STEP13_LEAP_GEN_TOP.out.output_top_path
            .join(STEP13_LEAP_GEN_TOP.out.output_crd_path)
            .map { meta, top, crd -> [meta, top, crd, [], [], []] }
    )
    // step15_amber_to_pdb: Atomic Clashes, amber_to_pdb
    STEP15_AMBER_TO_PDB(
        STEP13_LEAP_GEN_TOP.out.output_top_path
            .join(STEP14_SANDER_MDRUN.out.output_rst_path)
    )
    // step16_fix_pdb: Fix PDB
    STEP16_FIX_PDB(STEP15_AMBER_TO_PDB.out.output_pdb_path)
    // step17_structure_check: Final Check
    STEP17_STRUCTURE_CHECK(STEP16_FIX_PDB.out.output_pdb_path)

    publish:
    results = channel.empty().mix(
        STEP0_STRUCTURE_CHECK_INIT.out.output_summary_path.map { meta, result -> [meta, 'step0_structure_check_init', result] },
        STEP1_EXTRACT_MODEL.out.output_structure_path.map { meta, result -> [meta, 'step1_extract_model', result] },
        STEP2_EXTRACT_CHAIN.out.output_structure_path.map { meta, result -> [meta, 'step2_extract_chain', result] },
        STEP3_FIX_ALTLOCS.out.output_pdb_path.map { meta, result -> [meta, 'step3_fix_altlocs', result] },
        STEP4_FIX_SSBONDS.out.output_pdb_path.map { meta, result -> [meta, 'step4_fix_ssbonds', result] },
        STEP5_REMOVE_MOLECULES_IONS.out.output_molecules_path.map { meta, result -> [meta, 'step5_remove_molecules_ions', result] },
        STEP6_REMOVE_MOLECULES_LIGANDS.out.output_molecules_path.map { meta, result -> [meta, 'step6_remove_molecules_ligands', result] },
        STEP7_REDUCE_REMOVE_HYDROGENS.out.output_path.map { meta, result -> [meta, 'step7_reduce_remove_hydrogens', result] },
        STEP8_REMOVE_PDB_WATER.out.output_pdb_path.map { meta, result -> [meta, 'step8_remove_pdb_water', result] },
        STEP9_FIX_AMIDES.out.output_pdb_path.map { meta, result -> [meta, 'step9_fix_amides', result] },
        STEP10_FIX_CHIRALITY.out.output_pdb_path.map { meta, result -> [meta, 'step10_fix_chirality', result] },
        STEP11_FIX_SIDE_CHAIN.out.output_pdb_path.map { meta, result -> [meta, 'step11_fix_side_chain', result] },
        STEP12_FIX_BACKBONE.out.output_pdb_path.map { meta, result -> [meta, 'step12_fix_backbone', result] },
        STEP13_LEAP_GEN_TOP.out.output_pdb_path.mix(STEP13_LEAP_GEN_TOP.out.output_top_path, STEP13_LEAP_GEN_TOP.out.output_crd_path).map { meta, result -> [meta, 'step13_leap_gen_top', result] },
        STEP14_SANDER_MDRUN.out.output_log_path.mix(STEP14_SANDER_MDRUN.out.output_traj_path, STEP14_SANDER_MDRUN.out.output_rst_path).map { meta, result -> [meta, 'step14_sander_mdrun', result] },
        STEP15_AMBER_TO_PDB.out.output_pdb_path.map { meta, result -> [meta, 'step15_amber_to_pdb', result] },
        STEP16_FIX_PDB.out.output_pdb_path.map { meta, result -> [meta, 'step16_fix_pdb', result] },
        STEP17_STRUCTURE_CHECK.out.output_summary_path.map { meta, result -> [meta, 'step17_structure_check', result] }
    )
}

output {
    // results/<id>/<step>/<id>_<step>_<role>.<ext>
    results {
        path { meta, step, _result -> "${meta.id}/${step}" }
    }
}

// Path of a samplesheet column: absolute, or relative to the samplesheet folder
def samplePath(String value) {
    file(file(params.input).parent.resolve(value).toString(), checkIfExists: true)
}
