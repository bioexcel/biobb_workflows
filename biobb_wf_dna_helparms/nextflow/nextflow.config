/*
 * Configuration of biobb_wf_dna_helparms: biobb properties (ext.properties) and output extensions (ext.outputs) of every step,
 * from python/workflow.yml.
 */

manifest {
    name = 'biobb_wf_dna_helparms'
    description = 'Structural DNA helical parameters from MD trajectory tutorial using BioExcel Building Blocks (biobb)'
    homePage = 'https://github.com/bioexcel/biobb_workflows'
    mainScript = 'main.nf'
    nextflowVersion = '!>=25.10.0'
    license = 'Apache-2.0'
}

outputDir = 'results'
workflow.output.mode = 'copy'

process {
    // Output files named <id>_<step>_<role>.<ext>, with the helical parameter and base pair (step) of the python loops:
    // <id>_<step>[_<helpar>][_<pair>]_<role>.<ext>
    ext.prefix = { ([meta.id, task.process.tokenize(':')[-1].toLowerCase()] + [meta.helpar, meta.pair].findAll { value -> value }).join('_') }

    withName: 'STEP1_BIOBB_CURVES' {
        ext.properties = [s1range: '1:12']
        ext.outputs = [output_zip_path: 'zip']
    }

    withName: 'STEP2_BIOBB_CANAL' {
        ext.properties = [series: true, histo: true]
    }

    // helpar_name: helical parameter of the python loop (meta.helpar)
    withName: 'STEP4_DNA_AVERAGES_BASE_PAIR_STEP|STEP5_DNA_AVERAGES_BASE_PAIR|STEP6_DNA_AVERAGES_AXIS_BASE_PAIRS|STEP7_DNA_AVERAGES_GROOVES' {
        ext.properties = { [helpar_name: meta.helpar, sequence: 'CGCGAATTCGCG'] }
    }

    withName: 'STEP8_PUCKERING|STEP9_CANONICALAG|STEP10_BIPOPULATIONS' {
        ext.properties = [sequence: 'CGCGAATTCGCG']
    }

    // helpar_name: helical parameter of the python loop (meta.helpar)
    withName: 'STEP12_DNA_TIMESERIES_BASE_PAIR_STEP|STEP13_DNA_TIMESERIES_BASE_PAIR|STEP14_DNA_TIMESERIES_AXIS_BASE_PAIRS|STEP15_DNA_TIMESERIES_GROOVES|STEP16_DNA_TIMESERIES_BACKBONE_TORSIONS' {
        ext.properties = { [helpar_name: meta.helpar, sequence: 'CGCGAATTCGCG'] }
    }

    withName: 'STEP19_DNA_BIMODALITY' {
        ext.properties = [max_iter: 500]
    }

    withName: 'STEP20_INTRASEQCORR|STEP21_INTERSEQCORR|STEP24_INTRABPCORR|STEP25_INTERBPCORR' {
        ext.properties = [sequence: 'CGCGAATTCGCG']
    }

    // Python logic of workflow.py: zip of the outputs of every step, in the folder of the step
    withName: 'ZIP_OUTPUTS' {
        ext.prefix = { "${meta.id}_${meta.step}_outputs" }
    }
}

profiles {
    docker {
        docker.enabled = true
        // Run as the host user, so the results are not owned by root
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    apptainer {
        apptainer.enabled = true
    }
    singularity {
        singularity.enabled = true
    }
    conda {
        conda.enabled = true
        conda.channels = ['conda-forge', 'bioconda']
    }
}
