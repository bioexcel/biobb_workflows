/*
 * Configuration of biobb_wf_pmx_tutorial: biobb properties (ext.properties) and output extensions (ext.outputs) of every step,
 * from python/workflow.yml.
 */

manifest {
    name = 'biobb_wf_pmx_tutorial'
    description = 'Mutation Free Energy Calculations using BioExcel Building Blocks (biobb)'
    homePage = 'https://github.com/bioexcel/biobb_workflows'
    mainScript = 'main.nf'
    nextflowVersion = '!>=25.10.0'
    license = 'Apache-2.0'
}

outputDir = 'results'
workflow.output.mode = 'copy'

process {
    // Output files named <id>_<step>_<role>.<ext>, in results/<id>/<state>/<frame>/<step>/ for the steps of the python loops
    ext.prefix = { "${meta.id}_${task.process.tokenize(':')[-1].toLowerCase()}" }

    // Multithreaded blocks (num_threads = cpus): set cpus to the cores of your machine or node
    withLabel: 'process_medium' {
        cpus = 4
    }

    withName: 'STEP0_TRJCONV' {
        ext.properties = [selection: 'System', start: 1, end: 1000, skip: 2, dt: 1, output_name: 'frame', output_type: 'pdb']
    }

    // gmx_lib: the pmx force field folder (MUTFF process of main.nf, meta.gmx_lib), as $CONDA_PREFIX/.../pmx/data/mutff/ in workflow.py.
    // It is not an input of the modules: mounted in the containers of the steps that read it
    withName: 'STEP1_PMX_MUTATE|STEP2_GMX_PDB2GMX|STEP3_PMX_GENTOP|STEP5_GMX_GROMPP|STEP7_GMX_GROMPP|STEP9_GMX_GROMPP' {
        containerOptions = { workflow.containerEngine in ['singularity', 'apptainer'] ? "--bind ${meta.gmx_lib}" : "--volume ${meta.gmx_lib}:${meta.gmx_lib}:ro" }
    }

    // mutation_list: mutation of the state (--stateA_mutation / --stateB_mutation params, meta.mutation)
    withName: 'STEP1_PMX_MUTATE' {
        ext.properties = { [force_field: 'amber99sb-star-ildn-mut', mutation_list: meta.mutation, gmx_lib: meta.gmx_lib] }
    }

    withName: 'STEP2_GMX_PDB2GMX' {
        ext.properties = { [force_field: 'amber99sb-star-ildn-mut', gmx_lib: meta.gmx_lib] }
    }

    withName: 'STEP3_PMX_GENTOP' {
        ext.properties = { [force_field: 'amber99sb-star-ildn-mut', gmx_lib: meta.gmx_lib] }
    }

    withName: 'STEP4_GMX_MAKENDX' {
        ext.properties = [selection: 'a D*\n0 & ! 19\nname 20 FREEZE']
    }

    withName: 'STEP5_GMX_GROMPP' {
        ext.properties = { [simulation_type: 'minimization', mdp: [integrator: 'steep', emtol: 100, dt: 0.001, nsteps: 10000, nstcomm: 1, nstcalcenergy: 1, freezegrps: 'FREEZE', freezedim: 'Y Y Y'], gmx_lib: meta.gmx_lib] }
    }

    withName: 'STEP6_GMX_MDRUN' {
        ext.outputs = [output_trr_path: 'trr']
    }

    withName: 'STEP7_GMX_GROMPP' {
        ext.properties = { [simulation_type: 'free', mdp: [nsteps: 10000, nstcomm: 1, nstcalcenergy: 1, dt: 0.001], gmx_lib: meta.gmx_lib] }
    }

    withName: 'STEP8_GMX_MDRUN' {
        ext.outputs = [output_trr_path: 'trr']
    }

    withName: 'STEP9_GMX_GROMPP' {
        ext.properties = { [simulation_type: 'free', maxwarn: 1, mdp: [nsteps: 5000, free_energy: 'yes', 'init-lambda': 0, 'delta-lambda': '2e-4', 'sc-alpha': 0.3, 'sc-coul': 'yes', 'sc-sigma': 0.25], gmx_lib: meta.gmx_lib] }
    }

    withName: 'STEP10_GMX_MDRUN' {
        ext.outputs = [output_trr_path: 'trr', output_dhdl_path: 'xvg']
    }

    // Python logic of workflow.py: zips of the dhdl files of each state, in the folder of step11
    withName: 'ZIP_DHDL' {
        ext.prefix = { "${meta.id}_step11_pmx_analyse_dhdl_${meta.state}" }
    }

    withName: 'STEP11_PMX_ANALYSE' {
        ext.properties = [reverseB: true]
    }
}

profiles {
    docker {
        docker.enabled = true
        // Run as the host user, so the results are not owned by root
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    apptainer {
        apptainer.enabled = true
    }
    singularity {
        singularity.enabled = true
    }
    conda {
        conda.enabled = true
        conda.channels = ['conda-forge', 'bioconda']
    }
}
